# Machine-local Claude/Codex state
.claude/settings.local.json
.claude/agent-memory-local/
.codex/local/
.env
.env.*
!.env.example

# External repositories are research sources, never commit them
external/repositories/*
!external/repositories/.gitkeep
!external/repositories/README.md

# Environment pack archive (contents are extracted at repo root)
GNOSIS_FABLE5_ENVIRONMENT_V0.3_NICOL.zip

# Unrelated leftover audit data (minecraft-skin repos; not GNOSIS) — kept on
# disk pending operator confirmation, never committed to this repository.
security-audit/

# Lab: candidates/tools are reproducible installs (uv venvs, npm, portable
# downloads); fixture/dataset dirs are rebuildable and contain nested git
# repos (would show up as gitlinks). results/ stays tracked as evidence.
.gnosis/lab/code-intelligence/candidates/
.gnosis/lab/code-intelligence/tools/
.gnosis/lab/code-intelligence/datasets/fixture-repo/
.gnosis/lab/code-intelligence/datasets/fixture-repo-c1/
.gnosis/lab/code-intelligence/datasets/fixture-repo-c1-then-c4/
.gnosis/lab/memory/candidates/
.gnosis/lab/memory/datasets/

