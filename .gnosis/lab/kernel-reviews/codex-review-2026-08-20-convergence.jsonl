\n\r\n    def test_minor_findings_do_not_block_but_survive_as_dissent(self):\r\n        nit = _finding(Severity.MINOR, description=\"naming nit\")\r\n        script = _Script(\r\n            verifications=[_verification(True)],\r\n            reviews=[ReviewReport(verdict=ReviewVerdict.PASS, findings=(nit,))],\r\n            fingerprints=[\"fp1\"],\r\n        )\r\n        result = _run(script)\r\n        self.assertEqual(result.outcome, ConvergenceOutcome.CONVERGED)\r\n        self.assertIn(nit, result.dissent)\r\n        self.assertEqual(len(result.gate_ledger), 1)  # and in the ledger\r\n\r\n    def test_done_claim_without_repo_change_is_downgraded_to_warning(self):\r\n        bad = _finding()\r\n        script = _Script(\r\n            verifications=[_verification(True)] * 3,\r\n            reviews=[ReviewReport(verdict=ReviewVerdict.FAIL, findings=(bad,))] * 3,\r\n            fingerprints=[\"same\"] * 3,\r\n        )\r\n        script.fix_reports = [FixReport(claims_done=True)] * 3\r\n        result = _run(script, ConvergencePolicy(max_rounds=3, max_unchanged_rounds=99))\r\n        self.assertEqual(result.outcome, ConvergenceOutcome.ROUNDS_EXHAUSTED)\r\n        self.assertTrue(any(\"signal without evidence\" in w for w in result.warnings))\r\n\r\n    def test_uncertain_verdict_never_converges_and_stalemates_out(self):\r\n        script = _Script(\r\n            verifications=[_verification(True)] * 10,\r\n            reviews=[ReviewReport(verdict=ReviewVerdict.UNCERTAIN)] * 10,\r\n            fingerprints=[\"same\"] * 10,\r\n        )\r\n        result = _run(script)\r\n        self.assertEqual(result.outcome, ConvergenceOutcome.STALEMATE)\r\n        self.assertEqual(script.fix_requests, [])  # nothing concrete to fix\r\n\r\n    def test_probe_exception_is_a_warning_not_a_crash_or_a_stalemate_count(self):\r\n        bad = _finding()\r\n        boom = RuntimeError(\"probe exploded\")\r\n        script = _Script(\r\n            verifications=[boom, _verification(True)],\r\n            reviews=[ReviewReport(verdict=ReviewVerdict.PASS),\r\n                     ReviewReport(verdict=ReviewVerdict.PASS)],\r\n            fingerprints=[boom, \"fp2\"],\r\n        )\r\n        result = _run(script)\r\n        self.assertEqual(result.outcome, ConvergenceOutcome.CONVERGED)\r\n        self.assertFalse(result.rounds[0].evidence_ok)\r\n        self.assertTrue(any(\"verification collection failed\" in w for w in result.warnings))\r\n        self.assertEqual(result.rounds[1].unchanged_streak, 0)\r\n        del bad\r\n\r\n    def test_fixer_exception_propagates_raw(self):\r\n        bad = _finding()\r\n        script = _Script(\r\n            verifications=[_verification(True)],\r\n            reviews=[ReviewReport(verdict=ReviewVerdict.FAIL, findings=(bad,))],\r\n            fingerprints=[\"fp1\"],\r\n        )\r\n\r\n        def crashing_fix(request: FixRequest) -> FixReport:\r\n            raise RuntimeError(\"fixer crashed\")\r\n\r\n        loop = ConvergenceLoop(\r\n            ConvergencePolicy(max_rounds=3),\r\n            verify_fn=script.verify, review_fn=script.review,\r\n            fix_fn=crashing_fix, fingerprint_fn=script.fingerprint,\r\n        )\r\n        with self.assertRaises(RuntimeError):\r\n            loop.run()\r\n\r\n    def test_policy_validation(self):\r\n        with self.assertRaises(ValueError):\r\n            ConvergencePolicy(max_rounds=0)\r\n        with self.assertRaises(ValueError):\r\n            ConvergencePolicy(max_rounds=1, max_unchanged_rounds=0)\r\n        with self.assertRaises(ValueError):\r\n            ConvergencePolicy(max_rounds=1, min_blocking_confidence=1.5)\r\n\r\n\r\nclass TestGitFingerprint(unittest.TestCase):\r\n    def test_fingerprint_tracks_repo_changes_and_fails_closed(self):\r\n        with tempfile.TemporaryDirectory() as tmp:\r\n            repo = Path(tmp) / \"repo\"\r\n            repo.mkdir()\r\n            self.assertIsNone(git_fingerprint(repo))  # not a repo yet\r\n            subprocess.run([\"git\", \"init\"], cwd=repo, check=True, capture_output=True)\r\n            self.assertIsNone(git_fingerprint(repo))  # repo but no HEAD yet\r\n            subprocess.run([\"git\", \"config\", \"user.email\", \"e@x.com\"], cwd=repo, check=True)\r\n            subprocess.run([\"git\", \"config\", \"user.name\", \"T\"], cwd=repo, check=True)\r\n            (repo / \"a.txt\").write_text(\"one\\n\", encoding=\"utf-8\")\r\n            subprocess.run([\"git\", \"add\", \"-A\"], cwd=repo, check=True, capture_output=True)\r\n            subprocess.run([\"git\", \"commit\", \"-m\", \"init\"], cwd=repo,\r\n                           check=True, capture_output=True)\r\n            first = git_fingerprint(repo)\r\n            self.assertIsNotNone(first)\r\n            self.assertEqual(git_fingerprint(repo), first)  # stable when unchanged\r\n            (repo / \"a.txt\").write_text(\"two\\n\", encoding=\"utf-8\")\r\n            self.assertNotEqual(git_fingerprint(repo), first)  # dirty tree differs\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\n73:### 6. Review convergence: signal ∧ evidence, tri-state rounds, stalemate fingerprints, nothing-lost ledger\n\"\"\"Git evidence capture.\r\n\r\nRead-only: this module never mutates the target repository. It snapshots\r\ngit status, the current HEAD, branch, and a diff stat so a run's effect\r\non the tree is deterministically recorded evidence rather than an LLM's\r\nclaim about what it changed.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport re\r\nimport subprocess\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import UTC, datetime\r\nfrom pathlib import Path\r\nfrom typing import Any\r\n\r\n_SHA_RE = re.compile(r\"[0-9a-f]{40,64}\\Z\")\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass GitEvidence:\r\n    is_repo: bool\r\n    head_sha: str | None\r\n    branch: str | None\r\n    status_porcelain: str\r\n    diff_stat: str\r\n    ts: str = field(default_factory=lambda: datetime.now(UTC).isoformat())\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        return {\r\n            \"is_repo\": self.is_repo, \"head_sha\": self.head_sha, \"branch\": self.branch,\r\n            \"status_porcelain\": self.status_porcelain, \"diff_stat\": self.diff_stat, \"ts\": self.ts,\r\n        }\r\n\r\n\r\ndef _run_git(repo_path: Path, args: list[str]) -> tuple[int, str]:\r\n    try:\r\n        proc = subprocess.run(\r\n            [\"git\", *args], cwd=str(repo_path), capture_output=True, text=True,\r\n            timeout=30, check=False,  # rc is returned and handled by callers\r\n        )\r\n        return proc.returncode, (proc.stdout or proc.stderr).strip()\r\n    except FileNotFoundError:\r\n        return 127, \"git executable not found\"\r\n\r\n\r\ndef capture_git_evidence(repo_path: Path) -> GitEvidence:\r\n    code, _ = _run_git(repo_path, [\"rev-parse\", \"--is-inside-work-tree\"])\r\n    if code != 0:\r\n        return GitEvidence(is_repo=False, head_sha=None, branch=None, status_porcelain=\"\", diff_stat=\"\")\r\n\r\n    _, head_sha = _run_git(repo_path, [\"rev-parse\", \"HEAD\"])\r\n    _, branch = _run_git(repo_path, [\"rev-parse\", \"--abbrev-ref\", \"HEAD\"])\r\n    _, status = _run_git(repo_path, [\"status\", \"--porcelain\"])\r\n    _, diff_stat = _run_git(repo_path, [\"diff\", \"--stat\"])\r\n\r\n    return GitEvidence(\r\n        is_repo=True,\r\n        # `git rev-parse HEAD` on a repo with no commits echoes the literal\r\n        # string \"HEAD\" to stdout (the fatal goes to stderr), so a prefix\r\n        # check alone recorded a bogus head. Only a real sha counts.\r\n        head_sha=head_sha if _SHA_RE.fullmatch(head_sha) else None,\r\n        branch=branch,\r\n        status_porcelain=status,\r\n        diff_stat=diff_stat,\r\n    )\r\n\"\"\"Deterministic verification interface.\r\n\r\nPer the project constitution: no LLM may mark work verified merely by\r\nclaiming it is correct. A Verifier wraps something checkable, a test\r\nsuite, a build, a lint pass, and returns a VerificationResult with a\r\ncomputer-checked pass/fail, never a self-report.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport shlex\r\nimport subprocess\r\nimport time\r\nfrom abc import ABC, abstractmethod\r\nfrom collections.abc import Sequence\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import UTC, datetime\r\nfrom pathlib import Path\r\nfrom typing import Any\r\n\r\nfrom .redaction import redact\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass VerificationResult:\r\n    name: str\r\n    passed: bool\r\n    exit_code: int | None\r\n    duration_s: float\r\n    stdout_excerpt: str\r\n    stderr_excerpt: str\r\n    ts: str = field(default_factory=lambda: datetime.now(UTC).isoformat())\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        return {\r\n            \"name\": self.name, \"passed\": self.passed, \"exit_code\": self.exit_code,\r\n            \"duration_s\": self.duration_s, \"stdout_excerpt\": self.stdout_excerpt,\r\n            \"stderr_excerpt\": self.stderr_excerpt, \"ts\": self.ts,\r\n        }\r\n\r\n\r\nclass Verifier(ABC):\r\n    name: str\r\n\r\n    @abstractmethod\r\n    def run(self, cwd: Path) -> VerificationResult:\r\n        raise NotImplementedError\r\n\r\n\r\nclass CommandVerifier(Verifier):\r\n    \"\"\"Runs a shell command and treats a zero exit code as passing.\"\"\"\r\n\r\n    def __init__(self, name: str, command: Sequence[str] | str, timeout_s: float = 300.0,\r\n                 excerpt_chars: int = 2000):\r\n        self.name = name\r\n        self.command = command\r\n        self.timeout_s = timeout_s\r\n        self.excerpt_chars = excerpt_chars\r\n\r\n    def run(self, cwd: Path) -> VerificationResult:\r\n        argv = shlex.split(self.command) if isinstance(self.command, str) else list(self.command)\r\n        started = time.monotonic()\r\n        try:\r\n            proc = subprocess.run(\r\n                argv, cwd=str(cwd), capture_output=True, text=True, timeout=self.timeout_s,\r\n            )\r\n            duration = time.monotonic() - started\r\n            return VerificationResult(\r\n                name=self.name, passed=proc.returncode == 0, exit_code=proc.returncode,\r\n                duration_s=duration,\r\n                stdout_excerpt=redact(proc.stdout)[-self.excerpt_chars:],\r\n                stderr_excerpt=redact(proc.stderr)[-self.excerpt_chars:],\r\n            )\r\n        except subprocess.TimeoutExpired as exc:\r\n            duration = time.monotonic() - started\r\n            captured = exc.stdout if isinstance(exc.stdout, str) else \"\"\r\n            return VerificationResult(\r\n                name=self.name, passed=False, exit_code=None, duration_s=duration,\r\n                stdout_excerpt=redact(captured)[-self.excerpt_chars:],\r\n                stderr_excerpt=f\"TIMEOUT after {self.timeout_s}s\",\r\n            )\r\n        except FileNotFoundError as exc:\r\n            duration = time.monotonic() - started\r\n            return VerificationResult(\r\n                name=self.name, passed=False, exit_code=None, duration_s=duration,\r\n                stdout_excerpt=\"\", stderr_excerpt=f\"command not found: {exc}\",\r\n            )\r\n\r\n\r\nclass CompositeVerifier(Verifier):\r\n    \"\"\"Runs several verifiers and passes only if all of them pass.\"\"\"\r\n\r\n    def __init__(self, name: str, verifiers: Sequence[Verifier]):\r\n        self.name = name\r\n        self.verifiers = list(verifiers)\r\n\r\n    def run(self, cwd: Path) -> VerificationResult:\r\n        results = [v.run(cwd) for v in self.verifiers]\r\n        all_passed = all(r.passed for r in results)\r\n        return VerificationResult(\r\n            name=self.name,\r\n            passed=all_passed,\r\n            exit_code=0 if all_passed else 1,\r\n            duration_s=sum(r.duration_s for r in results),\r\n            stdout_excerpt=\"\\n\".join(f\"[{r.name}] {r.stdout_excerpt}\" for r in results),\r\n            stderr_excerpt=\"\\n\".join(f\"[{r.name}] {r.stderr_excerpt}\" for r in results if not r.passed),\r\n        )\r\nimport subprocess\r\nimport tempfile\r\nimport unittest\r\nfrom pathlib import Path\r\n\r\nfrom gnosis.kernel.git_evidence import capture_git_evidence\r\n\r\n\r\nclass TestGitEvidence(unittest.TestCase):\r\n    def test_non_repo_directory(self):\r\n        with tempfile.TemporaryDirectory() as tmp:\r\n            evidence = capture_git_evidence(Path(tmp))\r\n            self.assertFalse(evidence.is_repo)\r\n\r\n    def test_real_repo(self):\r\n        with tempfile.TemporaryDirectory() as tmp:\r\n            repo = Path(tmp)\r\n            subprocess.run([\"git\", \"init\"], cwd=repo, check=True, capture_output=True)\r\n            subprocess.run([\"git\", \"config\", \"user.email\", \"test@example.com\"], cwd=repo, check=True)\r\n            subprocess.run([\"git\", \"config\", \"user.name\", \"Test\"], cwd=repo, check=True)\r\n            (repo / \"a.txt\").write_text(\"hello\")\r\n            subprocess.run([\"git\", \"add\", \"a.txt\"], cwd=repo, check=True)\r\n            subprocess.run([\"git\", \"commit\", \"-m\", \"init\"], cwd=repo, check=True, capture_output=True)\r\n\r\n            evidence = capture_git_evidence(repo)\r\n            self.assertTrue(evidence.is_repo)\r\n            self.assertIsNotNone(evidence.head_sha)\r\n            self.assertEqual(evidence.status_porcelain, \"\")\r\n\r\n            (repo / \"a.txt\").write_text(\"changed\")\r\n            dirty = capture_git_evidence(repo)\r\n            self.assertIn(\"a.txt\", dirty.status_porcelain)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"Get-Content docs\\\\research\\\\REFERENCE_REPOSITORY_FINDINGS.md | Select-Object -Skip 65 -First 135; rg -n \\\"isinstance\\\\(.*VerificationResult|VerificationResult\\\\(\\\" tests src\\\\gnosis\\\\kernel | Select-Object -First 180; rg -n \\\"capture_git_evidence\\\\(\\\" tests src\\\\gnosis\\\\kernel\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"Get-Content docs\\\\research\\\\REFERENCE_REPOSITORY_FINDINGS.md | Select-Object -Skip 65 -First 135; rg -n \\\"isinstance\\\\(.*VerificationResult|VerificationResult\\\\(\\\" tests src\\\\gnosis\\\\kernel | Select-Object -First 180; rg -n \\\"capture_git_evidence\\\\(\\\" tests src\\\\gnosis\\\\kernel\"","aggregated_output":"\r\n### 5. Worktree lifecycle with provenance-gated destruction\r\n\r\n**Evidence:** agent-workspace-fabric (per-repo bare mirror + per-workspace worktree, idempotent removal, cleanup that deliberately avoids blanket `reset --hard`), cezar (idempotent worktree creation, never deletes non-empty unregistered dirs, autosave refuses mid-merge/conflict-marker states and tags its reason), orca (`BranchMode.Created` gate â€” only branches orca minted may be auto-deleted; resume header validated as hostile input before any destructive git action), grit (merge under PID-liveness-checked lock, preserves branch+worktree on failure), bernstein (content-addressed snapshots under refs, fork refuses on sha mismatch).\r\n\r\n**Rule:** The kernel mints per-task worktrees/branches and records that provenance at creation time; destruction is gated on \"did the kernel mint this\". Creation is idempotent with reattach paths; non-empty unregistered directories are recoverable work, never deleted. Autosave commits carry a reason tag and refuse conflict-marker states â€” losing a recovery point beats poisoning the branch. Any resume/recovery header is validated as hostile input (ref-shape checks, protected-branch floor, cross-checks) before any destructive operation; invalid state is a hard abort, and corrupt-state is distinguished from absent-state.\r\n\r\n### 6. Review convergence: signal âˆ§ evidence, tri-state rounds, stalemate fingerprints, nothing-lost ledger\r\n\r\n**Evidence:** ralphex (ALL_TASKS_DONE discarded if unchecked boxes remain; DONE means \"zero issues this round\", not \"I finished fixing\"; git HEAD+diff fingerprint stalemate counter), orca (bounded review loop with hard caps, per-severity confidence gates, and a `GateLedger` where every gated-out or declined finding is carried and printed at exit), cezar (review park state the agent cannot bypass; done-signals parsed only from the agent's own turn text), agent-arena (independent generation â†’ evidence checking â†’ blind judging, dissent preserved in the synthesis artifact).\r\n\r\n**Rule:** An agent's DONE claim never closes a Task. The kernel re-checks a durable artifact (plan checkboxes, git HEAD/diff fingerprint) and downgrades signal-without-evidence to continue-with-warning. Rounds are tri-state: clean round â†’ converged; fixed-something â†’ schedule another independent verification round; can't-fix â†’ typed failure. A stalemate counter over repo-state fingerprints (N consecutive unchanged rounds â†’ `STALEMATE`) is a kernel circuit breaker, resets on change, and never counts when evidence collection itself failed. Every finding held back by a gate is carried in a ledger and surfaced at every loop exit â€” the loop cannot silently drop evidence. Dissent from independent reviewers is preserved in the evidence artifact.\r\n\r\n### 7. Strict replay as default; write-ahead intent before side effects\r\n\r\n**Evidence:** bernstein (`DeterministicStore` â€” replay miss aborts, never silently falls through to a live model; per-key FIFO preserves call order and multiplicity; response-determining params folded into the key), reprise (occurrence-aware Nth-identical-request matching from a content-addressed SQLite blob store; strict-mode `ReplayMiss`), smithers (journal row with status `intended` + {sideEffect, idempotent, hasRevert, idempotencyKey} persisted *before* any tool executes; rewind safety becomes a decidable query), dagger (same recipe â†’ same digest â†’ memoized result), catacomb (recorded evidence as regression fixtures).\r\n\r\n**Rule:** Record every LLM/tool call keyed by a content hash of its response-determining parameters (model, provider, temperature, max_tokens, effort). Replay is occurrence-aware and strict: a miss is an abort; live fall-through is an explicit opt-in. Before any side-effecting tool executes, persist an `intended` journal row with side-effect provenance flags, so rewind/fork/compensation safety is answered by querying the journal, never by guessing. Golden runs become regression fixtures.\r\n\r\n### 8. Fail-closed, stateless policy verdicts; honesty about enforcement\r\n\r\n**Evidence:** agent-governance-toolkit (ACS: complete JSON snapshot in â†’ exactly one of allow/deny/warn/escalate/transform out; *every* runtime failure collapses to deny with a reserved `runtime_error:*` reason policies may not emit; unconfigured intervention point denies; undeclared tool denies; approvals bound to the exact action hash), agentjail (verdicts over parsed command intent â€” program/flags/resolved paths â€” with rule_id provenance), nono (kernel-enforced deny-by-default as the floor beneath advisory hooks), orca (enforcement honesty matrix: every backend restriction classified Hard/SandboxApprox/PromptOnly/Ignored, machine-checked in tests), opentraces (single three-way egress predicate; `unknown` is never coerced to safe).\r\n\r\n**Rule:** The kernel's Policy Engine is a pure, stateless function: adapters build a complete snapshot per intervention point; the engine returns exactly one verdict; every internal failure returns deny with a reserved reason namespace, so a deny-by-error is always distinguishable from a policy deny. Missing bindings and undeclared tools fail closed â€” configuration gaps are never consent. NEEDS_HUMAN escalations bind approval to the sha256 action identity of exactly what was evaluated (anti-TOCTOU). Decisions key on structured, parsed intent â€” never string pattern-matching with hardcoded bypass lists. And per adapter, maintain a machine-checked enforcement matrix recording whether each restriction is mechanically enforced, sandbox-approximated, prompt-only, or ignored â€” the kernel's least-privilege decisions consume honest data.\r\n\r\n### 9. Typed failure taxonomy end-to-end; rate limits as park states; recovery as reconcile\r\n\r\n**Evidence:** cezar (evidence-ordered usage-limit parsing that records *which* evidence shape carried each classification and refuses to guess; durable `autoResumeAt`; deadline holds vs in-flight holds keyed by runner:credential; boot re-adoption that revives through the normal queue path or fails loudly), smithers (`waiting-quota` durable park state with `resetAtMs`; startup crash recovery from pre-mutation audit rows), ralphex (three-tier retry/limit/error taxonomy with signal-suppressed retries), agent-workspace-fabric (reason codes flowing exception â†’ log â†’ append-only event â†’ failure taxonomy â†’ scheduler policy, with a generated catalog as the drift gate), symphony (distinct terminal reasons Failed/TimedOut/Stalled/Canceled because \"retry logic and logs differ\"; reconcile-before-dispatch on every poll tick), beads (typed `ClaimConflictError` carrying holder+status).\r\n\r\n**Rule:** Failures are typed at the adapter boundary (structured exit/frame codes first; prose parsing only as a last-resort enricher, with the evidence grade recorded on every classification). Reason codes flow unchanged from exception to append-only event to scheduler policy â€” implementing GNOSIS rules 5â€“7 (`RATE_LIMITED != FAIL_CODE`; `FAIL_INFRA` doesn't penalize the agent). `RATE_LIMITED` is a durable park state carrying a reset timestamp, with account-scoped holds distinguishing \"window known shut â€” block everything on this credential\" from \"one resume is probing â€” block only new work\". Recovery is reconcile, not restore: durable state on the record, volatile timers rebuilt idempotently on every scheduler pump, plus a boot sweep that re-adopts every stranded run through normal paths or fails it loudly â€” never leaving a ghost.\r\n\r\n---\r\n\r\n## Contradictions and open questions\r\n\r\n1. **Fail-open vs fail-closed evidence sealing.** Bernstein's completion evidence gate is deliberately fail-open (\"Evidence sealing must NEVER blockâ€¦ any error is caught and swallowed\") and agent-capsule's adapters are fail-open by design; ACS, opentraces' egress predicate, and GNOSIS Rule 2 demand fail-closed. The tension is availability (don't lose finished work over a sealing bug) vs integrity (no DONE without evidence). GNOSIS's constitution settles the default (fail closed), but the open question is the recovery path: what evidence would settle the cost is a chaos test measuring, under injected sealing failures, the rate of lost-but-recoverable work in a fail-closed design vs the rate of falsely-closed Tasks in a fail-open one.\r\n\r\n2. **Loop exhaustion semantics.** Ralphex soft-continues on max-iterations (\"continuingâ€¦\") and reads unchanged HEAD as convergence even when the reviewer may simply have failed to act; orca hard-caps with a nothing-lost ledger; AWF's PR monitor has *no* iteration/wall-clock terminal gate at all, delegating livelock to human-notification gates (in tension with GNOSIS Rule 8). Evidence to settle: measure, on a replayed corpus of review loops, how often exhaustion-with-flow-through ships unconverged defects vs how often hard-stop + NEEDS_HUMAN merely delays a run that would have converged.\r\n\r\n3. **Advisory vs enforced ownership.** Grit's symbol locks are pure convention (`cmd_done` commits everything touched and never diffs changes against held locks); orca enforces \"fan-out can read, never commit\" at compile time via capability tokens; the deep analyses converge on a kernel merge gate (diff hunks mapped to AST symbols, `FAIL_POLICY` if changed-symbols âŠ„ claimed-symbols) that no surveyed repo actually implements. Evidence to settle: a multi-agent conflict-injection benchmark counting how many unclaimed-symbol mutations reach merge under advisory-only vs gate-enforced ownership, and the gate's false-positive rate on legitimate refactors.\r\n\r\n4. **Where failure classification lives.** Cezar and ralphex classify failures by regex over provider prose at the terminal error; AWF, ACS, and symphony type failures structurally at the boundary. Cezar's evidence-graded prose parsing is the best of its kind, but it is inherently provider-version-fragile. Evidence to settle: a per-backend audit of what fraction of real failure events carry structured codes (exit codes, JSON frames) vs prose-only â€” if structured coverage is high, prose parsing is demoted to enricher; where it is low, cezar's evidence-ordered recognizers are the fallback.\r\n\r\n5. **In-band signals vs kernel-owned state.** Ralphex matches `<<<RALPHEX:...>>>` anywhere in output (a model *quoting* the marker triggers it, defended only by prompt exhortation); cezar narrows to line-anchored markers parsed only from the agent's own turn text, never tool output; cezar's review gate goes further â€” the state is store-owned and no marker can bypass it. Evidence to settle: marker-quoting injection tests against each scheme; the survey already strongly suggests kernel-owned out-of-band state wins, with in-band markers acceptable only as hints that never directly transition state.\r\n\r\n6. **Destructive teardown discipline.** Orca performs `git reset --hard` + gated `clean` in failure teardown (safe only because its recovery header is validated as hostile first); cezar and AWF deliberately refuse blanket resets, preferring autosave commits and idempotent reattach. GNOSIS Rule 27 forbids reset-as-shortcut, but orca shows a disciplined, validated reset can make resume-in-place trivial. Evidence to settle: crash-injection runs comparing recovery-loss incidents (work destroyed by teardown) vs poisoned-workspace incidents (stale state corrupting the resumed run) under each discipline.\r\n\r\n7. **Storage substrate weight vs scale.** Beads (Dolt, 60+ migrations, proxy daemon) and AWF (Postgres + Compose stacks) carry heavy substrates for semantics that cezar, reprise, grit, and smithers deliver on SQLite/plain files; beads' claim scan is also deliberately unbounded over the ready set (acknowledged in claim.go). SQLite-V1 is the GNOSIS ADR baseline. Evidence to settle: a scheduler benchmark at GNOSIS's actual scale envelope (hundreds to low-thousands of Tasks) measuring whether the materialized-`is_blocked` + CAS-claim pattern on SQLite holds up before any heavier substrate is even discussed.\r\n\r\n8. **Rate-limit hold granularity.** Cezar's two-hold account model (deadline holds block everything on a credential; in-flight holds block only new work â€” each kind fixed a real bug in opposite directions) vs smithers' simpler single `waiting-quota` park. Evidence to settle: reproduce resume-stampede and resume-deadlock scenarios with multiple concurrent runs sharing one credential; if both reproduce, the two-hold model is required, not optional.\r\n\r\n---\r\n\r\n## Per-repository findings\r\n\r\n*Deep analyses (10 repositories), followed by group sweeps (3 blocks). Sections are reproduced verbatim from the archaeology agents, evidence labels preserved.*\r\n\r\n### bernstein â€” deterministic multi-CLI-agent orchestrator with hash-chained journals, signed lineage, and hermetic replay; the strongest kernel-authority reference found for GNOSIS\r\n\r\n- **Identity:** https://github.com/sipyourdrink-ltd/bernstein @ 7dce402 (2026-08-18) | Apache-2.0, standard text, no riders (verbatim tail: \"Copyright 2026 Alex Chernysh\"; separate NOTICE + TRADEMARKS.md) | Python >=3.12 (dev-pinned 3.14), ~1,879 .py files / ~721k LOC in src, repo 114 MB | hatchling + uv (uv.lock; no custom hatch build hooks â€” VERIFIED via pyproject grep) | runtime: Click CLI, FastAPI task server, Textual TUI, MCP server, spawns 40+ external coding-agent CLIs\r\n- **Risk:** MEDIUM â€” code is defensively written and local-first (servers default-bind 127.0.0.1 and refuse non-loopback without a token, `mcp/remote_transport.py:309` VERIFIED; telemetry default-off with DO_NOT_TRACK precedence, SELF-REPORTED docstring invariants; docker.sock mount commented out VERIFIED), but it is a ~720k-LOC system that spawns agent subprocesses by design, has 3 `pickle.loads` sites on local files (`cli/commands/cache_cmd.py:331`, `persistence/fingerprint.py:286`, `planning/duration_predictor.py:285` VERIFIED), and `benchmark/programbench.py:453-463` `exec()`s candidate code in-process (VERIFIED). Fine as READ-ONLY reference; unacceptable as a runtime dependency surface.\r\n- **Decision:** REIMPLEMENT_PATTERN â€” Bernstein independently converged on GNOSIS's exact constitution (kernel owns state/gates, agents propose, evidence before consensus) and implements the deepest journal/gate/replay machinery I have seen, with genuine Windows lanes (msvcrt lock paths, `newline=\"\"` byte-exact appends, PowerShell rmtree fallback, windows CI + `.github/windows-lane-baseline.json`). But adopting it as a dependency would import a monolith that violates GNOSIS Rule 30 (simplicity is a security property); the load-bearing mechanisms are each a few hundred lines of stdlib-only Python and their contracts are documented well enough to re-derive by hand. Reimplement the chain/replay/gate contracts natively in the GNOSIS kernel; keep bernstein as the audit oracle for design decisions.\r\n- **Signature mechanisms:**\r\n  - Hash-chained step journal with fail-closed recovery (`src/bernstein/core/persistence/journal.py:Journal`, `_validate_chain_for_recovery`): each step hashed as SHA256(canonical compact sorted-keys JSON of {prev_hash, input_hash, model, prompt, tool_call, tool_result, effort?}); on open the tip is recovered by **recomputing every hash from genesis, never trusting the tail**; a torn final line degrades gracefully but any interior corruption / seq gap / prev_hash break raises `JournalError` so a tampered chain cannot be extended from a poisoned anchor. Schema evolution by omission: `effort=None` keys byte-identically to legacy rows, so old chains re-verify unchanged. [VERIFIED â€” read full file]\r\n  - Hermetic deterministic replay (`src/bernstein/core/orchestration/deterministic.py:DeterministicStore`, `ReplayMissError`, `ReplayRecordingMissingError`; plus `replay/journal.py:EventJournal`): every LLM call recorded keyed by SHA256(model\\0prompt\\0provider\\0temperature\\0max_tokens); replay keeps a **per-key FIFO preserving call order and multiplicity**; a miss (including over-consumption) **aborts by default** instead of silently falling through to a live model, and whole-run replay refuses up front when no recording exists; live fall-through is an explicit env opt-in. `EventJournal` Merkle-chains all run events with **wall-clock excluded from the payload hash**, so byte-identical executions yield identical chains and divergence surfaces at a precise step index. [VERIFIED â€” read both files]\r\n  - Portable work ledger anchored in git refs (`src/bernstein/core/persistence/work_ledger.py`, `ledger_git.py`): the task graph and every transition form a hash chain (same canonical-JSON contract as the journal); **redaction runs before hashing** so the portable chain verifies anywhere without carrying cleartext; anchored under `refs/bernstein/work-ledger/<run-id>` as a **timestamp-free deterministic tree** (two operators anchoring the same chain get byte-identical trees); resume appends a nonce-bearing `run.resumed` entry so double-resume becomes structurally divergent and is caught at the next anchor, never silently merged. [VERIFIED â€” read module docstrings + hashing contract; internals NOT TESTED]\r\n  - Signed lineage transparency log + read-only CI gate (`src/bernstein/core/lineage/gate.py:check`): per-entry Ed25519 detached JWS verified against agent cards keyed by **(agent_id, kid)** (kid-substitution and key-rotation safe), optional operator HMAC, steward allowlist for merge entries, dangling-parent and unresolved-fork detection; verification binds to **exact on-disk bytes** (`canonicalise(entry) == raw_line`, strict `b\"\\n\"` splitting) to defeat re-canonicalisation and newline-reframing attacks. The gate is a pure function over a frozen log + cards dir â€” the reviewer never mutates what it judges. [VERIFIED â€” read full file]\r\n  - Decision WAL + gates projected from one state machine (`src/bernstein/core/persistence/wal.py:WALEntry` fsync-per-entry hash-chained decisions with `committed` flag and a rebuildable uncommitted-index cache; `src/bernstein/core/orchestration/phase_gates.py` deterministic stdlib rule runner R001â€“R005 with exactly-one bounded auto-repair re-fire; `src/bernstein/mcp/approval_gate.py` derives approvable/completable status sets **from `tasks/lifecycle.py` constants so no transport can obtain a weaker rule**). [VERIFIED â€” read wal.py head, phase_gates.py head, approval_gate.py head]\r\n  - Fork-from-step on git snapshots (`src/bernstein/core/replay/fork.py`): each step's snapshot is a content-addressed git commit under `refs/bernstein/snapshots/<run_id>/<N>`; forking cross-verifies the journal-recorded sha against the ref and **refuses on mismatch**, and the child run's first journal event parent-links the fork point, turning the run chain into a verifiable tree. [VERIFIED â€” read module docstring/flow; execution NOT TESTED]\r\n- **What GNOSIS should steal:** (1) The single canonical-bytes contract â€” one `canonical_json = dumps(sort_keys=True, separators=(\",\",\":\")).encode(\"utf-8\")` primitive shared by journal, WAL, work ledger and lineage, documented so a third party can re-derive any hash by hand; make it the GNOSIS Kernel's one chain primitive. (2) Fail-closed tail recovery semantics: recompute the whole chain on open, distinguish \"torn final line = legitimate crash, keep prefix\" from \"interior corruption = refuse and name the line\". (3) Strict-replay-as-default: a replay miss is an abort (`ReplayMissError`), never a silent live call, with response-determining params (model/provider/temperature/max_tokens/effort) folded into the replay key so parameter drift can't masquerade as a hit. (4) Gate authority projected from the state machine: allowed transitions live once in the task-lifecycle module and every surface (CLI/MCP/HTTP) imports them, so no entry point gets weaker rules; plus git-ref anchoring of the ledger with timestamp-free trees for portable, deterministic resume.\r\n- **What to avoid:** (1) The completion evidence gate is deliberately **fail-open** (`evidence/completion_gate.py`: \"Evidence sealing must NEVER blockâ€¦ any error is caught and swallowed\") â€” that directly contradicts GNOSIS Rule 2 (no DONE without evidence); GNOSIS's completion gate must fail closed. (2) Chain proliferation and monolith accretion: five historical event systems later needing a \"unifying projection\" (`events/feed.py` admits this), a 6,785-line orchestrator.py, and parallel hash-chain implementations (journal, WAL, EventJournal, work ledger, lineage, audit chain) that only partially share one contract â€” plus `pickle` for local caches where JSON would do.\r\n- **Scores:** determinism 9, durability 9, security 8, recovery 9, auditability 10, modularity 6, testability 9 (Hypothesis stateful WAL-recovery machine, lineage tamper-detection integration tests, mutation testing wired for lineage â€” VERIFIED test tree), windows 8, op-simplicity 3, unique-value 9, evidence-quality 9, gnosis-fit 9 (as pattern source; ~2 as dependency)\r\n\r\n### orca â€” Workflow-as-code agent orchestration: typed, resumable Scala flows where deterministic structure (stages+git) owns nondeterministic agent operations\r\n\r\n- **Identity:** https://github.com/VirtusLab/orca @ 9da3d07 (2026-08-09) | Apache-2.0, standard text, no riders (VERIFIED â€” read head+tail of LICENSE) | Scala 3.8.4 (~75k LOC, 449 files) + POSIX sh | sbt (multi-module: tools/flow/runner/shell + 5 backend drivers); flows are `scala-cli` `.sc` scripts, JVM 21 | ~1.4 MiB pack\r\n- **Risk:** MEDIUM â€” no telemetry found, MCP/HTTP listeners are loopback-only (`McpHost.scala`: Netty on `127.0.0.1`, ephemeral port, VERIFIED); but by design it runs repo-committed lint/format commands via `bash -c` (`Lint.scala:33`, settings from `.orca/settings.properties`), performs `git reset --hard` + `git clean -fdq` in failure teardown (`GitTool.scala:646-655`), spawns vendor agent CLIs as subprocesses, and `install.sh` is curl|bash that bootstraps scala-cli remotely and ships a shim resolving unpinned `latest.release` at every launch (all VERIFIED). Fine as read-only source; unaudited execution not advised.\r\n- **Decision:** REIMPLEMENT_PATTERN â€” orca is the strongest workflow-as-code specimen in the registry for GNOSIS's exact thesis: a deterministic host program (typed stages, git commits, bounded loops) owns state and gates while LLM agents only propose within them. But it is Scala/JVM with an explicit \"Windows beyond the bash -c contract is a non-goal\" (`docs/research/shell/06-wizard-settings.md`, VERIFIED), and its capability enforcement leans on Scala 3 capture checking â€” untransplantable as a dependency. Reimplement its stage/progress-log/recovery patterns in the GNOSIS Python kernel.\r\n- **Signature mechanisms:**\r\n  - Resumable checkpointed stages (`flow/src/main/scala/orca/Flow.scala:stage`, `StageFrames.scala`): `stage(name){body}` gets a hierarchical id `parent/name#occurrence` from a frame stack of per-parent occurrence counters; a fresh run serializes the body's typed result JSON into the progress log and makes ONE git commit covering code+log; on re-run, a log entry that decodes to `T` replays the result and skips the body (decode failure = fail-safe re-run). Invariants: exactly-once occurrence bump per attempt (stable ids across resumes); skipped parents structurally can't desync nested counters; owner-thread assert rejects `stage()` from forks. Failure mode: outer stage re-running over a nested stage's committed partial work requires idempotent bodies (documented verbatim in scaladoc). [VERIFIED]\r\n  - Durable progress log + untrusted-on-load validation (`flow/.../progress/ProgressStore.scala`, `RecoveryCheck.scala`): prompt-hash-keyed JSON file written via temp-file + atomic rename (torn-write proof), tri-state load (`Absent`/`Corrupt`/`Loaded`) so corruptâ‰ absent gets a loud warning; on resume the header is treated as hostile input â€” branch-ref shape checks blocking CLI-flag injection/path traversal (`isSafeReusedRef`), protected-branch floor (`main`/`master` + detected default), promptHash recompute, and a current-branch cross-check â€” all before any destructive git action; invalid = hard abort, never silent fresh start. [VERIFIED]\r\n  - Lifecycle recovery with disjoint teardowns (`runner/.../FlowLifecycle.scala`): setup refuses to start a fresh run on a branch another run's log already claims (`abortIfBranchBusy`); failure teardown `reset --hard` (+ gated clean) back to the last stage commit so re-run resumes in place; success teardown removes the log in a final commit and auto-deletes only branches orca itself minted (`BranchMode.Created` gate defeats tampered-header-driven deletion); deterministic `flow-<hash>` fallback branch names so unattended runs never flip on naming collisions. Plus dual locks (`FlowLock.scala`): process AtomicBoolean + PID lockfile with CREATE_NEW-only atomicity, stale-lock steal by delete+re-race, bounded at 4 attempts. [VERIFIED]\r\n  - Capability-token effect discipline (`flow/.../FlowControl.scala`, `InStage`/`WorkspaceWrite` tokens, `Session.scala:OutsideStage`): who may start stages (`FlowControl`), mutate the workspace (`WorkspaceWrite`), or mint durable sessions (compile-time proof of being *outside* a stage via `NotGiven[InStage]`) is encoded in types; forks receive only the narrow read+emit `FlowContext`, enforced by Scala capture/separation checking in `ReviewLoop.scala` plus a runtime owner-thread assert as backstop â€” \"LLM fan-out can read, never commit\" is a compile error, not a convention. [VERIFIED]\r\n  - Bounded review-and-fix loop with a nothing-is-lost ledger (`flow/.../review/ReviewLoop.scala`, `ConfidenceGate.scala`, `GateLedger.scala`): parallel reviewers with durable per-reviewer sessions re-reviewing only the delta since `lastSent`; per-severity confidence bars (tentative Critical admitted at 0.5, uncertain Info gated at 0.8); hard caps (3 fix attempts) and a halt when the fixer reports zero fixes; every finding gated out, declined, or unaccounted-for is returned in `IgnoredIssues` with the last-known reason and printed at exit â€” the loop cannot silently drop evidence. Fixer's declines (not its \"fixed\" claims) are fed to next-round reviewers, so reviewers re-derive fixes independently. [VERIFIED]\r\n  - Enforcement honesty matrix (`tools/.../agents/Enforcement.scala` + `EnforcementTableTest`): every backend's actual enforcement of a tool restriction is classified `Hard`/`SandboxApprox`/`PromptOnly`/`Ignored` with per-cell rationale, machine-checked in tests â€” the framework refuses to pretend a prompt-level \"read-only\" is a sandbox. [VERIFIED]\r\n- **What GNOSIS should steal:**\r\n  - **Stage = typed checkpoint = one git commit.** Persist each stage's typed result JSON in a run-scoped progress log, commit code+log atomically, and resume by replaying decoded results with decode-failureâ†’re-run as the fail-safe; use hierarchical `name#occurrence` ids minted by a frame stack so same-named and nested stages stay stable across resumes.\r\n  - **Treat your own recovery state as hostile input.** Validate resume headers (ref-shape/injection checks, protected-branch floor, prompt-hash, current-branch cross-check) before any destructive operation; make invalid state a hard abort, distinguish corrupt-log from absent-log, and gate branch deletion on \"did I mint this branch\" recorded at creation time.\r\n  - **Nothing-lost gate ledger for review loops.** Every finding a gate holds back or a fixer declines is carried, deduped by title with the freshest reason, and returned+printed at every loop exit â€” maps directly onto GNOSIS's EVIDENCE BEFORE CONSENSUS and incidentâ†’test rules.\r\n  - **Enforcement matrix as first-class policy metadata.** For each adapter (Claude/Codex), record whether a permission restriction is mechanically enforced, sandbox-approximated, prompt-only, or ignored â€” and machine-check the table in tests, feeding the Kernel's least-privilege decisions with honest data.\r\n- **What to avoid:** (1) `bash -c` execution of commands read from a repo-committed settings file that an agent itself auto-discovers and writes â€” a prompt-injected agent can plant a shell command a later run executes; GNOSIS's Policy Engine must admission-check any repo-sourced command. (2) The unpinned `latest.release` launcher shim (every launch resolves the newest published artifact) â€” violates GNOSIS reproducibility; pin versions in provenance. Also note the documented resume hazard: outer-stage bodies must be idempotent over their own committed leftovers â€” design stages so edits never straddle a nested stage.\r\n- **Scores:** determinism 8, durability 8, security 7, recovery 9, auditability 8, modularity 8, testability 9, windows 3, op-simplicity 5, unique-value 9, evidence-quality 9, gnosis-fit 8\r\n\r\n### agent-workspace-fabric â€” control plane that runs AI coding agents through isolated worktreeâ†’validateâ†’PRâ†’monitorâ†’merge lifecycles\r\n\r\n- **Identity:** https://github.com/dimileeh/agent-workspace-fabric @ 45693fe | Apache-2.0, no riders (standard text verbatim, appendix unfilled) [VERIFIED] | Python 3.12 (FastAPI, SQLAlchemy 2 async, Pydantic v2, Alembic, Docker SDK) + TypeScript (Next.js console in `apps/console`) | uv/pyproject + npm | ~41 MB w/o `.git`, 484 src py files, 1030 test files, coverage gate `fail_under = 99` in pyproject [VERIFIED]\r\n- **Risk:** MEDIUM â€” no telemetry, no eval/exec, only SafeLoader-subclass YAML, secrets redaction + egress audit modules present [VERIFIED]; but the control-plane containers run as root with CAP_SYS_ADMIN for overlayfs auth mounts (`docker/compose/local-service.yml:198`, `src/awf/node/auth_mounts_caps.py`), opt-in `privileged: true` DinD sidecar (`node/compose_manager.py:1131`), and it shells out to agent CLIs and git/docker pervasively (by design). `git push --force-with-lease` appears only in rebase recovery on AWF's own feature branch (`executor/git_methods.py:989`); worktree cleanup deliberately avoids blanket `reset --hard` (`executor/git_ops.py:337`) [VERIFIED]. Nothing runs at import/install time; pre-commit hooks are local lint/type checks [VERIFIED].\r\n- **Decision:** REIMPLEMENT_PATTERN â€” this is the closest existing system to GNOSIS's taskâ†’worktreeâ†’isolated-runâ†’validateâ†’PRâ†’integrate loop, and its three or four core patterns (immutable transition allow-list, pure no-I/O decision core, DB leases with fencing epochs, reason-codes flowing end-to-end into an append-only event log) map directly onto \"kernel owns state/gates, agents propose, evidence before consensus\". As a dependency it is rejected: Postgres + per-workspace Compose stacks + root/CAP_SYS_ADMIN worker + GitHub-as-source-of-truth is far too heavy and Linux-container-bound for a Windows-native SQLite-first kernel. Re-implement the mechanisms; benchmark GNOSIS's lifecycle vocabulary against its state diagram.\r\n- **Signature mechanisms:**\r\n  - Workspace state machine (`src/awf/control/state_machine.py:WorkspaceStateMachine`): a module-level `MappingProxyType` of `frozenset` allowed transitions (`requestedâ†’provisioningâ†’readyâ†’runningâ†’validatingâ†’pushingâ†’monitoring_prâ†’completed`, plus non-terminal `blocked`/`recovering` pause states and `destroyingâ†’destroyed`); every status mutation must call `assert_transition(src, dst)` which raises a typed error carrying both endpoints for structured 409s. Invariant: no illegal transition can be silently written; terminal/callback-terminal sets gate cleanup and stale async callbacks. Failure mode: the guard is a convention (explicit call, not enforced by type system) â€” a forgotten call bypasses it. [VERIFIED]\r\n  - Pure PR-monitor decision core (`src/awf/runtime/pr_monitor.py:decide`): zero-I/O function `(PRStatus, MonitorState, MonitorConfig) â†’ exactly one MonitorAction` over an explicitly ordered 10-gate table (merged/closed short-circuit â†’ base-retarget drift â†’ SyncBase-before-comments â†’ operator hint â†’ unresolved comments â†’ blocking reviews â†’ CI fail â†’ CI pending â†’ conflict â†’ absent-required-checks grace â†’ blocked/hooks â†’ Merge-or-NotifyHuman when `auto_merge=False`); the runner (`runtime/pr_monitor_runner/runner.py`) does all I/O and persists `MonitorState`. Invariant: one action per call, gate order documented with the production incidents that forced it; no iteration/wall-clock terminal gate â€” exit only via Merge/ShortCircuit/Abort. Failure mode: livelock is possible by design and delegated to human notification gates. [VERIFIED]\r\n  - DB-backed claims with fencing epochs (`src/awf/control/worker/manager.py:ControlWorker`, `worker/claims.py:_apply_execution_claim`): worker polls Postgres with `SELECT FOR UPDATE SKIP LOCKED`, claims rows via conditional status CAS, stamps `execution_claimed_by` + expiry + `execution_claim_epoch = epoch + 1` as a SQL expression so a later claimant always lands a strictly higher epoch and a stale worker's heartbeat/release CAS is fenced. Invariant: at most one live driver per workspace across concurrent workers/restarts. Failure mode: epoch fencing covers only the provisioning path (executor path documented as epoch-unguarded). [VERIFIED]\r\n  - Mirror + worktree provisioner (`src/awf/node/git_manager.py:GitManager`): per-repo bare mirror (`clone --mirror`, then strips `remote.origin.mirror` so worktrees can push), per-workspace `git worktree add -b <branch> <tracking_ref>`; all mirror-registry mutations serialized by per-mirror asyncio locks keyed by event loop (worktree registry is a shared file that corrupts under concurrent add/prune â€” observed in their CI); removal is idempotent + `worktree prune`, and `_reclaim_stale_worktree` raises a reason-coded error on OSError rather than silently leaking disk. Invariant: base lookups go through remote-tracking refs so prune never touches AWF-created branches. [VERIFIED]\r\n  - Stale-execution recovery & GC (`src/awf/control/worker/recovery_stale.py`, `src/awf/service/gc*.py` â€” 15 modules): periodic scans classify runtime snapshots of stranded active workspaces and choose salvage (preserved-active resume, hosted PR re-adoption, remonitor of an open PR with a running stack) before failing; state machine carries dedicated salvage edges (e.g. `provisioningâ†’monitoring_pr`, `validatingâ†’running` rewind). Invariant: cleanup is honest (failures recorded as events, never swallowed); orphan dirs reconciled against DB. [VERIFIED at structure level; individual salvage paths NOT TESTED]\r\n  - Reason codes + append-only evidence (`src/awf/db/models.py:WorkspaceEvent`, `common/reason_codes`-generated `docs/REASON_CATALOG.md` ~936 lines): exception `reason_code` â†’ structured log â†’ append-only `WorkspaceEvent` (per-workspace `event_sequence` counter, \"no UPDATE/DELETE ever\") â†’ `FailureReason` â†’ policy; `idempotency_key` unique constraints on workspaces/tasks/operations/callbacks; bounded validate/fix loop with explicit pass budgets (`executor/execution_validation.py: max_validation_attempts = max_fix_passes + conformance_budget + 1`) and flaky/setup retry budgets in `runtime/validation_runner.py`. [VERIFIED]\r\n- **What GNOSIS should steal:**\r\n  - The state machine as an importable, frozen allow-list module with `assert_transition` raising a typed error carrying `(from, to, allowed_next)` â€” plus documented salvage edges for restart recovery â€” as the Kernel's single status authority.\r\n  - The pure-`decide()` pattern for any monitor/review loop: snapshot + persisted state in, exactly one action out, all I/O in a thin runner â€” this makes GNOSIS gate policy unit-testable and replayable with hand-rolled snapshots.\r\n  - Claim leases with monotonic fencing epochs bumped as a DB expression (`epoch = epoch + 1` in the claim txn), so a superseded agent/worker is fenced on its next CAS â€” directly portable to SQLite.\r\n  - Reason-code plumbing end-to-end (exception â†’ log field â†’ append-only event â†’ failure taxonomy â†’ scheduler policy, e.g. `RETRY_BONUS_INFRASTRUCTURE_FAILURE` in `service/scheduler.py`) with a generated catalog doc as the drift gate â€” matches GNOSIS rules 5â€“7 exactly.\r\n- **What to avoid:** the `*DelegatesMixin` file-explosion style (~45 executor modules of free functions taking `self: Any`) trades away static typing and makes control flow archaeology hard; and the guard-by-convention state machine (nothing structurally prevents `workspace.status = ...` â€” GNOSIS should make the kernel the only writer of status, not a convention). Also avoid the root+CAP_SYS_ADMIN control-plane posture; keep GNOSIS least-privilege.\r\n- **Scores:** determinism 8, durability 9, security 6, recovery 9, auditability 9, modularity 7, testability 9, windows 3, op-simplicity 3, unique-value 9, evidence-quality 9, gnosis-fit 8\r\n\r\n### cezar â€” local multi-runner (Claude/Codex/OpenCode/pi) coding-agent orchestrator with per-task worktrees, crash re-adoption and usage-limit auto-resume\r\n\r\n- **Identity:** https://github.com/open-mercato/cezar @ 9a8b24d (shallow clone, depth 1; HEAD 2026-08-19) | MIT, standard 21-line text, no riders (VERIFIED) | TypeScript on Node >= 20, npm workspaces, plain `tsc` build, Hono HTTP server; deps: hono, zod, ws, yaml, smol-toml, @clack/prompts | ~110k LoC TS across 4 packages, 17 MiB pack, 249 test files vs 256 source files\r\n- **Risk:** LOW (as read-only pattern source) â€” no install hooks (root and package `package.json` have no pre/postinstall; prebuild/postbuild are local build scripts) [VERIFIED]; server binds 127.0.0.1 by default with an anchored host-guard against DNS rebinding (`server/server.ts:~1224-1260`) [VERIFIED]; secret redaction before persisting transcripts (`core/secret-redaction.ts`, value+pattern, shared regex with child-env stripping) [VERIFIED]; destructive git ops scoped to `.ai/cezar/worktrees/<runId>` [VERIFIED]. Caveats if ever *run*: the zero-config tool default grants unrestricted `Bash` in cwd (self-documented as #430 in `agent-runner.ts`) and autosaves commit with `--no-verify`; `server-install` ships VPS/ngrok exposure scripts (opt-in, not audited in depth) [VERIFIED/NOT TESTED].\r\n- **Decision:** REIMPLEMENT_PATTERN â€” This is the closest production-grade match yet to GNOSIS's priority problem (one seam over Claude Code and Codex CLIs with resume, worktrees, and gates), but it is a Node/TS application with a 3.6k-line manager class, not a library GNOSIS (Python/SQLite kernel) can depend on. Its mechanisms map one-to-one onto GNOSIS rules â€” `RATE_LIMITED != FAIL_CODE` is literally implemented as evidence-ordered usage-limit parsing with durable resume deadlines, and the review park is a kernel-owned gate the agent cannot bypass. Reimplement the seam, the classification, and the recovery sweep in the GNOSIS kernel; benchmark nothing, depend on nothing.\r\n- **Signature mechanisms:**\r\n  - Runner abstraction (`packages/cezar/src/core/agent-runner.ts:AgentRunner/AgentSession/RUNNER_IDS`): one normalized `AgentEvent` stream + a persistent-process session (sendMessage/end/interrupt/result) implemented by 4 backends â€” claude = stream-json over stdin, codex = `codex app-server` JSON-RPC/JSONL (`thread/start`, `thread/resume`, `turn/steer`, `turn/interrupt`), opencode = HTTP+SSE, pi = JSONL RPC. `RUNNER_IDS` tuple is the single source of truth all schemas derive from; per-backend system-prompt mapping is explicit (claude `--append-system-prompt`, others prepend to first user message). Invariant: an exit cezar caused is never an agent failure â€” `isSignalTerminationExit(130/137/143)` paired with a \"we sent the signal\" flag, and `trackChildExit` deliberately avoids the `ChildProcess.killed` trap (#844). [VERIFIED]\r\n  - Failure classification + auto-resume (`core/usage-limit.ts:parseUsageLimit`, `workflows/run.ts:scheduleAutoResumeIfLimited/fireAutoResume/reconcileAutoResumes`): terminal error strings are classified in strict evidence order â€” Claude's machine marker `usage limit reached|<epoch>`, ISO timestamp in prose, wall-clock+timezone, relative delay â€” and each hit records which shape carried it (`evidence` field, quoted in the transcript). No reset instant â‡’ `null`, deliberately refusing to guess. Resume deadline is durable on the record (`autoResumeAt`); timers are process-local and rebuilt by a reconcile sweep on every pump, bounded by `MAX_AUTO_RESUMES=12`, a 24 h missed-deadline expiry, and a 30 s grace past the provider's reset. Account-scoped holds (`runner:profile` key) distinguish deadline holds (block everything â€” prevents resume stampede) from in-flight holds (block only new work â€” prevents resume deadlock). [VERIFIED]\r\n  - Crash recovery (`workflows/run.ts:recover()/reviveQueuedRun`, `handoff.ts`): on boot, `queued` runs are re-queued from the persisted `workflowDef` (or failed loudly â€” \"a run neither running nor failed is the worst failure this engine has\"); `waiting` runs settle like a closed session; `running` runs are marked `failed: interrupted` then immediately resumed via the last persisted `sessionId` with a prompt pointing the agent at its per-run handoff file. The engine itself heartbeats that handoff journal, so resume context exists even when the agent never wrote. A 60 s queue watchdog re-adopts records the live process lost. [VERIFIED]\r\n  - Worktree lifecycle (`git-worktree.ts:createWorktree/autosaveCommit/resolveBaseRef`; `workflows/run.ts:acquireRepoRoot`): per-run branch `cez/<id8>` under `.ai/cezar/worktrees/<runId>`; creation is idempotent with reattach paths and never deletes non-empty unregistered dirs (recoverable work). Autosave commits carry a reason tag (`periodic|turn end|run finalize|pre-PR`) and *refuse* to commit mid-merge or conflict-marker states (ordered `<<<<<<</=======/>>>>>>>` triple scan) â€” losing a recovery point beats poisoning the branch. Stale-base resolution prefers `origin/<base>` when local is behind, killing phantom inflated diffs. Runs in the repo root are serialized by a promise-chain lease held for the run's whole lifetime, whose waiters park and return their concurrency slot. [VERIFIED]\r\n  - Review gate (`runs/review-gate.ts:reviewGateEnabled` + `run.ts:settleSuccess`): a successful run parks at status `review` (blocking retention/cleanup) only when `worktreeHasDiff && gateEnabled && !autonomous` â€” a state the store owns, not a prompt convention; done-signals from agents are line-anchored in-band markers (`CEZ:DONE`, `CEZ:PR=`) parsed from the agent's own turn text only, never from tool output, so reading the contract cannot poison the record (`runs/task-markers.ts`). [VERIFIED]\r\n  - Durable store (`runs/store.ts`): `runs.json` index written atomic tmp+rename, per-run NDJSON event log via append; `reconcileLoadedRun` demotes impossible statuses at load time (a `running` record loaded without `keepLive` becomes `failed`). Plain files, no DB. [VERIFIED]\r\n- **What GNOSIS should steal:**\r\n  1. The two-hold account model for rate limits: a *deadline* hold (window known shut â€” blocks all work on that `runner:account` key, including other resumes) vs an *in-flight* hold (one resume is probing â€” blocks new work only). Each hold kind fixed a real bug in opposite directions; GNOSIS's Kernel should key limits by backend+credential, exactly this way.\r\n  2. Evidence-graded limit parsing that refuses to guess: ordered recognizers (machine marker > timestamp > clock > delay), a recorded `evidence` tag on every classification, `null` when no reset instant â€” surfaced honestly instead of retry-looping. Slots directly under GNOSIS's `RATE_LIMITED` taxonomy entry.\r\n  3. Recovery as reconcile, not restore: durable deadline/state on the record, volatile timers rebuilt idempotently on every scheduler pump plus a wedge watchdog, and boot re-adoption that either revives a run through the normal queue path or fails it loudly â€” never leaves a ghost.\r\n  4. Engine-side handoff journal per task (seeded idempotently, heartbeated by the kernel, injected via env var into every resume prompt) â€” resume context that survives the agent, the process, and the provider window.\r\n  5. Autosave that refuses conflict states and tags its reason â€” provenance-grade recovery commits without poisoning the branch.\r\n- **What to avoid:** (1) `RunManager` is a 3,645-line class owning queue, leases, resume, review, retention and prompt composition â€” GNOSIS must keep these as separate kernel modules with typed interfaces. (2) Failure classification exists *only* as regex over provider prose at the terminal error; GNOSIS should type failures at the adapter boundary (structured exit/frame codes first) and use prose parsing solely as a last-resort enricher â€” and never copy the default-unrestricted-Bash tool allowlist.\r\n- **Scores:** determinism 6, durability 8, security 6, recovery 9, auditability 8, modularity 7, testability 9, windows 7, op-simplicity 8, unique-value 8, evidence-quality 9, gnosis-fit 8\r\n\r\n### ralphex â€” autonomous plan-execution loop (task â†’ multi-agent review â†’ external adversarial review â†’ finalize) driving Claude/Codex CLIs\r\ntests\\test_convergence.py:22:    return VerificationResult(\r\ntests\\test_engine.py:192:        return VerificationResult(\r\nsrc\\gnosis\\kernel\\verification.py:67:            return VerificationResult(\