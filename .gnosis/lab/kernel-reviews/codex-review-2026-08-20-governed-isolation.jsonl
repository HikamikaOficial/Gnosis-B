| None,\r\n278:        verifier: Verifier | None,\r\n279:        timeout_s: float,\r\n280:        cancellation_token: CancellationToken | None,\r\n281:        mcp: McpRunnerConfig | None,\r\n282:        code_intelligence: CodeIntelligenceProvider | None,\r\n283:        focus_symbols: Sequence[str] | None,\r\n284:        max_context_chars: int,\r\n285:        authority: WorkAuthority | None,\r\n286:        grant: WorkGrant | None,\r\n287:        guard: Callable[[], None],\r\n288:    ) -> TaskExecutionOutcome:\r\n289:        task_sm = TaskStateMachine(TaskState.CREATED)\r\n290:        task_sm.transition(TaskState.PLANNED)\r\n291:        task_sm.transition(TaskState.IN_PROGRESS)\r\n292:\r\n293:        # Every durable run-store write below re-proves ownership at the\r\n294:        # store boundary — a forgotten guard() call cannot stale-write.\r\n295:        store = _GuardedRunStore(self.run_store, guard)\r\n296:\r\n297:        pre_git = capture_git_evidence(exec_root)\r\n298:        run_ids: list[str] = []\r\n299:        last_result: ExecutionResult | None = None\r\n300:\r\n301:        ci_evidence: dict[str, Any] | None = None\r\n302:        effective_prompt = prompt\r\n303:        if code_intelligence is not None and focus_symbols:\r\n304:            context_block, ci_evidence = _gather_code_intelligence_context(\r\n305:                code_intelligence, exec_root, focus_symbols, max_context_chars,\r\n306:            )\r\n307:            if context_block:\r\n308:                effective_prompt = f\"{context_block}\\n\\n---\\n\\n{prompt}\"\r\n309:\r\n310:        def on_heartbeat(run_id: str) -> None:\r\n311:            try:\r\n312:                store.heartbeat(run_id)\r\n313:            except (StaleClaimError, StaleLeaseError):\r\n314:                # A deposed worker must not keep writing liveness. Raising\r\n315:                # here would escape the runner's polling loop and leak the\r\n316:                # child; cancel it cooperatively instead (the guards then\r\n317:                # surface the deposition).\r\n318:                if cancellation_token is not None:\r\n319:                    cancellation_token.cancel()\r\n320:\r\n321:        def attempt(attempt_number: int) -> ExecutionResult:\r\n322:            nonlocal last_result\r\n323:            guard()\r\n324:            run_id = new_run_id()\r\n325:            run_ids.append(run_id)\r\n326:            paths = store.create_run(run_id, task_id)\r\n327:            ledger = store.ledger_for(run_id)\r\n328:            if attempt_number == 1 and ci_evidence is not None:\r\n329:                ledger.append(run_id, \"code_intelligence.context_gathered\", ci_evidence)\r\n330:                (paths.root / \"code_intelligence.json\").write_text(\r\n331:                    json.dumps(ci_evidence, indent=2, sort_keys=True), encoding=\"utf-8\",\r\n332:                )\r\n333:            ledger.append(run_id, \"run.attempt_started\", {\r\n334:                \"attempt\": attempt_number, \"objective\": objective,\r\n335:                \"mcp\": mcp.to_dict() if mcp is not None else None,\r\n336:                \"code_intelligence_used\": ci_evidence is not None,\r\n337:                \"worktree\": worktree.to_dict() if worktree is not None else None,\r\n338:            })\r\n339:            store.update_state(run_id, RunState.RUNNING)\r\n340:            store.heartbeat(run_id)\r\n341:\r\n342:            # Last re-proof before the repository-writing child launches\r\n343:            # (Codex review): shrinks the pre-launch stale window from\r\n344:            # \"attempt entry -> launch\" to milliseconds. The in-flight\r\n345:            # child window that remains is handled cooperatively by the\r\n346:            # pump; its structural closure (worktree isolation + token\r\n347:            # enforcement inside RunStore) is tracked in NEXT_ACTIONS.\r\n348:            guard()\r\n349:            result = self.cli_runner.run(\r\n350:                prompt=effective_prompt, cwd=exec_root, stdout_path=paths.stdout, stderr_path=paths.stderr,\r\n351:                timeout_s=timeout_s, cancellation_token=cancellation_token, mcp=mcp,\r\n352:                heartbeat_fn=lambda pid: on_heartbeat(run_id),\r\n353:            )\r\n354:\r\n355:            # The CLI run is a long window in which a deposition can happen\r\n356:            # (the pump detects it and cancels the child); re-prove\r\n357:            # ownership before recording the outcome.\r\n358:            guard()\r\n359:\r\n360:            if result.succeeded:\r\n361:                final_state = RunState.SUCCEEDED\r\n362:            elif result.timed_out:\r\n363:                final_state = RunState.TIMED_OUT\r\n364:            elif result.cancelled:\r\n365:                final_state = RunState.CANCELLED\r\n366:            else:\r\n367:                final_state = RunState.FAILED\r\n368:\r\n369:            store.update_state(run_id, final_state)\r\n370:            ledger.append(run_id, \"run.attempt_finished\", {\r\n371:                \"attempt\": attempt_number, \"exit_code\": result.exit_code,\r\n372:                \"timed_out\": result.timed_out, \"cancelled\": result.cancelled,\r\n373:                \"duration_s\": result.duration_s,\r\n374:            })\r\n375:            paths.result.write_text(json.dumps(result.to_dict(), indent=2, sort_keys=True), encoding=\"utf-8\")\r\n376:            last_result = result\r\n377:            return result\r\n378:\r\n379:        def should_retry(result: ExecutionResult) -> bool:\r\n380:            return (not result.cancelled) and (not result.succeeded)\r\n381:\r\n382:        execute_with_retry(attempt, should_retry, self.retry_policy)\r\n383:\r\n384:        guard()\r\n385:        post_git = capture_git_evidence(exec_root)\r\n386:        latest_run_id = run_ids[-1] if run_ids else None\r\n387:        if latest_run_id:\r\n388:            git_dir = store.paths_for(latest_run_id).git_dir\r\n389:            (git_dir / \"pre.json\").write_text(json.dumps(pre_git.to_dict(), indent=2), encoding=\"utf-8\")\r\n390:            (git_dir / \"post.json\").write_text(json.dumps(post_git.to_dict(), indent=2), encoding=\"utf-8\")\r\n391:\r\n392:        cli_succeeded = bool(last_result and last_result.succeeded)\r\n393:        verification_result: VerificationResult | None = None\r\n394:\r\n395:        if cli_succeeded:\r\n396:            task_sm.transition(TaskState.VERIFYING)\r\n397:            if verifier is not None:\r\n398:                verification_result = verifier.run(exec_root)\r\n399:                if latest_run_id:\r\n400:                    store.ledger_for(latest_run_id).append(\r\n401:                        latest_run_id, \"task.verification_result\", verification_result.to_dict(),\r\n402:                    )\r\n403:            verification_passed = verification_result.passed if verification_result else True\r\n404:            task_sm.transition(TaskState.COMPLETED if verification_passed else TaskState.FAILED)\r\n405:        else:\r\n406:            task_sm.transition(TaskState.FAILED)\r\n407:\r\n408:        # Verified success resolves the claim and releases the lease in the\r\n409:        # same authority call. On failure/cancellation the claim deliberately\r\n410:        # stays ACTIVE, bound to the unresolved work (grit's merge-failure\r\n411:        # lesson); the lease is left to expire so the TTL sweep reclaims it\r\n412:        # as an audited RECLAIMED transition instead of a silent release.\r\n413:        if authority is not None and grant is not None and task_sm.state == TaskState.COMPLETED:\r\n414:            authority.resolve(grant, outcome=\"COMPLETED\")\r\n415:\r\n416:        problems: tuple[str, ...] = ()\r\n417:        if not cli_succeeded and latest_run_id:\r\n418:            stderr_path = store.paths_for(latest_run_id).stderr\r\n419:            if stderr_path.exists():\r\n420:                tail = stderr_path.read_text(encoding=\"utf-8\", errors=\"replace\")[-2000:]\r\n421:                problems = (redact(tail),) if tail.strip() else ()\r\n422:        elif verification_result is not None and not verification_result.passed:\r\n423:            problems = (redact(verification_result.stderr_excerpt),)\r\n424:\r\n425:        report = EngineerReport(\r\n426:            task_id=task_id,\r\n427:            run_id=latest_run_id or \"NONE\",\r\n428:            status=ReportStatus.COMPLETED if task_sm.state == TaskState.COMPLETED else ReportStatus.PARTIAL,\r\n429:            objective=objective,\r\n430:            work_completed=(f\"Executed {len(run_ids)} run attempt(s) via the Claude Code CLI runner.\",),\r\n431:            verification=(\r\n432:                (f\"{verification_result.name}: \" + (\"PASSED\" if verification_result.passed else \"FAILED\"),)\r\n433:                if verification_result else (\"No verifier supplied.\",)\r\n434:            ),\r\n435:            problems_encountered=problems,\r\n436:            recommended_next_step=(\r\n437:                \"None, task completed and verified.\" if task_sm.state == TaskState.COMPLETED\r\n438:                else \"Investigate the run/verification failure captured in this run's evidence before retrying.\"\r\n439:            ),\r\n440:        )\r\n441:\r\n442:        return TaskExecutionOutcome(\r\n443:            task_id=task_id, run_ids=run_ids, final_task_state=task_sm.state,\r\n444:            verification=verification_result, execution_result=last_result, report=report,\r\n445:        )\r\n1:\"\"\"Wires the Director inbox/outbox convention to the M0 TaskEngine.\n2:\n3:run_pending() is the whole ingest -> execute -> report loop:\n4:  1. list_pending() inbox files\n5:  2. claim() each (validate, dedup, atomically move to processed/)\n6:  3. create a BriefRecord (ASSIGNED), execute via TaskEngine (IN_PROGRESS),\n7:     persist the outcome (COMPLETED/FAILED), write the EngineerReport to\n8:     outbox/ (+ escalations/ if the report demands escalation)\n9:\n10:resume_interrupted() is the recovery half: it runs RecoveryManager first\n11:(reclassifying any run left RUNNING by a crashed process as CRASHED), then\n12:finds BriefRecords stuck in ASSIGNED/IN_PROGRESS whose run(s) are no\n13:longer live and marks them FAILED with an explanation. No silent limbo,\n14:and no automatic re-execution: a human/Director decides whether to\n15:resubmit as a new brief.\n16:\"\"\"\n17:from __future__ import annotations\n18:\n19:import json\n20:from collections.abc import Callable\n21:from dataclasses import dataclass\n22:from pathlib import Path\n23:from typing import cast\n24:\n25:from ..contracts.director_brief import DirectorBrief\n26:from ..contracts.engineer_report import EngineerReport, ReportStatus\n27:from ..kernel.claims import WorkAuthority\n28:from ..kernel.engine import TaskEngine, TaskExecutionOutcome\n29:from ..kernel.ids import new_task_id\n30:from ..kernel.run_store import RunStore\n31:from ..kernel.state_machine import RunState\n32:from ..kernel.verification import Verifier\n33:from ..kernel.worktree import WorktreeManager\n34:from ..runner.recovery import RecoveryManager\n35:from .brief_record import BriefRecord, BriefRecordState, BriefRecordStore\n36:from .inbox import DirectorInbox\n37:\n38:\n39:@dataclass(frozen=True)\n40:class IngestOutcome:\n41:    brief_id: str | None\n42:    task_id: str | None\n43:    accepted: bool\n44:    reason: str\n45:    execution: TaskExecutionOutcome | None = None\n46:\n47:\n48:class DirectorOrchestrator:\n49:    def __init__(\n50:        self,\n51:        director_root: Path,\n52:        run_store: RunStore,\n53:        repo_path: Path,\n54:        task_engine: TaskEngine | None = None,\n55:        prompt_builder: Callable[[DirectorBrief], str] | None = None,\n56:        authority: WorkAuthority | None = None,\n57:        worker_id: str | None = None,\n58:        worktrees: WorktreeManager | None = None,\n59:        lease_ttl_s: float | None = None,\n60:    ) -> None:\n61:        self.inbox = DirectorInbox(director_root)\n62:        self.records = BriefRecordStore(director_root / \"state\" / \"briefs\")\n63:        self.run_store = run_store\n64:        self.repo_path = repo_path\n65:        self.task_engine = task_engine or TaskEngine(run_store=run_store)\n66:        # How a DirectorBrief becomes a CLI prompt string is a policy\n67:        # decision left to the caller; default is a simple, literal\n68:        # rendering good enough for M1 plumbing tests.\n69:        self.prompt_builder = prompt_builder or _default_prompt_builder\n70:        # Governed mode (ADR-0006..0008 follow-up): when a WorkAuthority is\n71:        # configured, every brief execution runs under a fenced grant (the\n72:        # engine enforces the verifier-required evidence gate) and, when a\n73:        # WorktreeManager is configured, inside the task's own worktree.\n74:        # The inbox's best-effort brief claim remains as brief-level dedup;\n75:        # task ownership authority is the claims/lease plane.\n76:        if authority is not None and not worker_id:\n77:            raise ValueError(\"worker_id is required when the orchestrator is given a WorkAuthority\")\n78:        self.authority = authority\n79:        self.worker_id = worker_id\n80:        self.worktrees = worktrees\n81:        self.lease_ttl_s = lease_ttl_s\n82:\n83:    def run_pending(self, verifier: Verifier | None = None) -> list[IngestOutcome]:\n84:        outcomes: list[IngestOutcome] = []\n85:        for path in self.inbox.list_pending():\n86:            claim = self.inbox.claim(path)\n87:            if not claim.accepted:\n88:                outcomes.append(IngestOutcome(brief_id=None, task_id=None, accepted=False, reason=claim.reason))\n89:                continue\n90:            # An accepted claim always carries a brief; cast is a typing-only\n91:            # no-op that tells mypy what ClaimResult.accepted guarantees.\n92:            outcomes.append(self._execute_brief(cast(DirectorBrief, claim.brief), verifier=verifier))\n93:        return outcomes\n94:\n95:    def _execute_brief(self, brief: DirectorBrief, verifier: Verifier | None) -> IngestOutcome:\n96:        task_id = new_task_id()\n97:        self.records.create(brief.brief_id, task_id, BriefRecordState.ASSIGNED)\n98:        self.records.update(brief.brief_id, state=BriefRecordState.IN_PROGRESS)\n99:\n100:        outcome = self.task_engine.execute_task(\n101:            task_id=task_id,\n102:            objective=brief.title,\n103:            prompt=self.prompt_builder(brief),\n104:            repo_path=self.repo_path,\n105:            verifier=verifier,\n106:            authority=self.authority,\n107:            worker_id=self.worker_id,\n108:            lease_ttl_s=self.lease_ttl_s,\n109:            worktrees=self.worktrees,\n110:        )\n111:\n112:        report_path = self._write_report(outcome.report)\n113:        final_state = (\n114:            BriefRecordState.COMPLETED if outcome.report.status == ReportStatus.COMPLETED\n115:            else BriefRecordState.ESCALATED if outcome.report.status == ReportStatus.ESCALATION_REQUIRED\n116:            else BriefRecordState.FAILED\n117:        )\n118:        self.records.update(\n119:            brief.brief_id, state=final_state, run_ids=list(outcome.run_ids), report_path=str(report_path),\n120:        )\n121:\n122:        return IngestOutcome(brief_id=brief.brief_id, task_id=task_id, accepted=True, reason=\"ok\", execution=outcome)\n123:\n124:    def _write_report(self, report: EngineerReport) -> Path:\n125:        layout = self.inbox.layout\n126:        json_path = layout.outbox / f\"{report.task_id}.json\"\n127:        md_path = layout.outbox / f\"{report.task_id}.md\"\n128:        json_path.write_text(json.dumps(report.to_dict(), indent=2, sort_keys=True), encoding=\"utf-8\")\n129:        md_path.write_text(report.to_markdown(), encoding=\"utf-8\")\n130:\n131:        if report.status == ReportStatus.ESCALATION_REQUIRED:\n132:            esc_json = layout.escalations / f\"{report.task_id}.json\"\n133:            esc_md = layout.escalations / f\"{report.task_id}.md\"\n134:            esc_json.write_text(json.dumps(report.to_dict(), indent=2, sort_keys=True), encoding=\"utf-8\")\n135:            esc_md.write_text(report.to_markdown(), encoding=\"utf-8\")\n136:\n137:        return json_path\n138:\n139:    def resume_interrupted(self, stale_after_s: float = 120.0) -> list[BriefRecord]:\n140:        RecoveryManager(self.run_store, stale_after_s=stale_after_s).scan()\n141:\n142:        recovered: list[BriefRecord] = []\n143:        stuck = self.records.list_in_states({BriefRecordState.ASSIGNED, BriefRecordState.IN_PROGRESS})\n144:        for record in stuck:\n145:            if self._has_live_or_recoverable_run(record):\n146:                continue\n147:            updated = self.records.update(\n148:                record.brief_id,\n149:                state=BriefRecordState.FAILED,\n150:                error=\"Interrupted: no successful run found after recovery scan; resubmit as a new brief if needed.\",\n151:            )\n152:            recovered.append(updated)\n153:        return recovered\n154:\n155:    def _has_live_or_recoverable_run(self, record: BriefRecord) -> bool:\n156:        for run_id in record.run_ids:\n157:            try:\n158:                meta = self.run_store.read_meta(run_id)\n159:            except FileNotFoundError:\n160:                continue\n161:            if meta.state in (RunState.PENDING.value, RunState.RUNNING.value, RunState.SUCCEEDED.value):\n162:                return True\n163:        return False\n164:\n165:\n166:def _default_prompt_builder(brief: DirectorBrief) -> str:\n167:    parts = [brief.mission]\n168:    if brief.constraints:\n169:        parts.append(\"Constraints: \" + \"; \".join(brief.constraints))\n170:    if brief.acceptance_criteria:\n171:        parts.append(\"Acceptance criteria: \" + \"; \".join(brief.acceptance_criteria))\n172:    return \"\\n\\n\".join(parts)\n1:\"\"\"Isolated Git worktree primitives with provenance-gated destruction.\n2:\n3:Gives a task/run its own checked-out working directory, on its own\n4:branch, without touching the source repo's own working tree. This is the\n5:*primitive* only, no parallel scheduling is wired on top of it.\n6:\n7:Directive 5 (docs/research/REFERENCE_REPOSITORY_FINDINGS.md §5) rules\n8:implemented here:\n9:\n10:- The kernel mints per-task worktrees/branches (`gnosis/<task_id>`) and\n11:  records that provenance in a handle marker at creation time.\n12:  **Destruction is gated on that provenance**: remove() refuses any\n13:  handle whose marker is absent or disagrees with the handle — \"did the\n14:  kernel mint this\" is checked, not assumed.\n15:- **Creation is idempotent with reattach paths**: re-creating an intact\n16:  worktree returns its existing handle; a marker whose directory is gone\n17:  is reattached (on the surviving branch when one exists, so committed\n18:  work is never lost); an existing branch without a marker is adopted,\n19:  not deleted.\n20:- **Non-empty unregistered directories are recoverable work, never\n21:  deleted**: both create() and remove() hard-abort when a directory\n22:  exists that git does not register as a worktree.\n23:- **Autosave commits carry a reason tag and refuse conflict states**:\n24:  autosave() tags `gnosis-autosave(<task_id>): <reason>` and refuses\n25:  mid-merge/mid-rebase, unmerged paths, and leftover conflict markers —\n26:  losing a recovery point beats poisoning the branch.\n27:- **Resume state is hostile input**: task ids are shape-checked before\n28:  any path/ref is built from them (no traversal, no ref injection);\n29:  handle markers are cross-checked (branch = minted namespace, path\n30:  under the manager's root, source repo match) before any destructive\n31:  git action; corrupt state (present but wrong) raises a different error\n32:  than absent state, and both are hard aborts.\n33:\n34:`source_repo` must be a repository Gnosis owns/operates on. Never point a\n35:WorktreeManager at a read-only reference corpus: `create()`/`remove()`\n36:both run `git` commands against `source_repo`, which is exactly the kind\n37:of mutation a reference corpus must never receive.\n38:\"\"\"\n39:from __future__ import annotations\n40:\n41:import json\n42:import re\n43:import subprocess\n44:from dataclasses import dataclass\n45:from datetime import UTC, datetime\n46:from pathlib import Path\n47:from typing import Any\n48:\n49:from .git_evidence import GitEvidence, capture_git_evidence\n50:\n51:BRANCH_PREFIX = \"gnosis/\"\n52:\n53:# Task ids become path components and ref components; anything outside\n54:# this shape is hostile input, rejected before any path or git ref is\n55:# built from it.\n56:_TASK_ID_RE = re.compile(r\"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\Z\")\n57:\n58:# Conflict-marker shapes `git diff --check` reports; also used to scan\n59:# untracked files (which no `git diff` variant inspects).\n60:_CONFLICT_MARKER_RE = re.compile(r\"^(?:<{7}|={7}|>{7})(?: |$)\", re.MULTILINE)\n61:\n62:# Destruction floor: branches the kernel will never auto-delete even if\n63:# every other check were somehow passed.\n64:_PROTECTED_BRANCHES = frozenset({\"main\", \"master\", \"develop\", \"trunk\"})\n65:\n66:\n67:class WorktreeError(RuntimeError):\n68:    pass\n69:\n70:\n71:class WorktreeAbsentError(WorktreeError):\n72:    \"\"\"Expected state (marker/worktree) does not exist at all.\"\"\"\n73:\n74:\n75:class WorktreeCorruptStateError(WorktreeError):\n76:    \"\"\"State exists but is unparseable or fails cross-checks. Distinct\n77:    from absence on purpose: absent state may be created fresh, corrupt\n78:    state is a hard abort demanding a human/recovery decision.\"\"\"\n79:\n80:\n81:class WorktreeProvenanceError(WorktreeError):\n82:    \"\"\"Destruction refused: the kernel cannot prove it minted this.\"\"\"\n83:\n84:\n85:class WorktreeAutosaveRefusedError(WorktreeError):\n86:    \"\"\"Autosave refused to avoid poisoning the branch. Carries a machine-\n87:    readable reason tag alongside the human message.\"\"\"\n88:\n89:    def __init__(self, reason_tag: str, detail: str):\n90:        super().__init__(f\"autosave refused [{reason_tag}]: {detail}\")\n91:        self.reason_tag = reason_tag\n92:\n93:\n94:@dataclass(frozen=True)\n95:class WorktreeHandle:\n96:    task_id: str\n97:    run_id: str | None\n98:    source_repo: str\n99:    path: str\n100:    branch: str\n101:    created_at: str\n102:\n103:    def to_dict(self) -> dict[str, Any]:\n104:        return {\n105:            \"task_id\": self.task_id, \"run_id\": self.run_id, \"source_repo\": self.source_repo,\n106:            \"path\": self.path, \"branch\": self.branch, \"created_at\": self.created_at,\n107:        }\n108:\n109:    @classmethod\n110:    def from_dict(cls, data: dict[str, Any]) -> WorktreeHandle:\n111:        return cls(**data)\n112:\n113:\n114:def _run_git(cwd: Path, args: list[str], timeout_s: float = 60.0) -> subprocess.CompletedProcess[str]:\n115:    return subprocess.run([\"git\", *args], cwd=str(cwd), capture_output=True, text=True, timeout=timeout_s)\n116:\n117:\n118:def _validate_task_id(task_id: str) -> None:\n119:    if not _TASK_ID_RE.match(task_id):\n120:        raise WorktreeError(\n121:            f\"Invalid task id {task_id!r}: must match {_TASK_ID_RE.pattern} \"\n122:            \"(task ids become path and ref components; anything else is \"\n123:            \"treated as hostile input)\"\n124:        )\n125:\n126:\n127:class WorktreeManager:\n128:    \"\"\"Creates/tracks/cleans up isolated worktrees under `worktrees_root`,\n129:    each checked out from `source_repo` on its own `gnosis/<task_id>`\n130:    branch.\"\"\"\n131:\n132:    def __init__(self, source_repo: Path, worktrees_root: Path):\n133:        self.source_repo = Path(source_repo)\n134:        self.worktrees_root = Path(worktrees_root)\n135:        self.worktrees_root.mkdir(parents=True, exist_ok=True)\n136:\n137:    # -- creation (idempotent, with reattach paths) --------------------------\n138:\n139:    def create(self, task_id: str, run_id: str | None = None, base_ref: str = \"HEAD\") -> WorktreeHandle:\n140:        _validate_task_id(task_id)\n141:        evidence = capture_git_evidence(self.source_repo)\n142:        if not evidence.is_repo:\n143:            raise WorktreeError(f\"{self.source_repo} is not a git repository\")\n144:\n145:        branch = BRANCH_PREFIX + task_id\n146:        target = self.worktrees_root / task_id\n147:        marker = self._handle_marker(task_id)\n148:\n149:        if marker.exists():\n150:            handle = self.load_handle(task_id)  # validates as hostile input\n151:            if target.exists():\n152:                if self._is_registered_worktree(target):\n153:                    return handle  # intact: idempotent no-op\n154:                raise WorktreeCorruptStateError(\n155:                    f\"{target} exists but git does not register it as a worktree; \"\n156:                    \"it may hold recoverable work and is never deleted \"\n157:                    \"automatically — inspect or move it manually\"\n158:                )\n159:            # Marker survives, directory is gone: reattach. Prune the stale\n160:            # registration first, then re-add on the surviving branch (so\n161:            # committed work is preserved) or freshly if the branch is gone.\n162:            _run_git(self.source_repo, [\"worktree\", \"prune\"])\n163:            self._worktree_add(target, branch, base_ref)\n164:            return handle\n165:\n166:        if target.exists():\n167:            raise WorktreeCorruptStateError(\n168:                f\"{target} exists without a kernel handle marker (unregistered \"\n169:                \"directory). It may hold recoverable work and is never deleted \"\n170:                \"automatically — inspect or move it manually\"\n171:            )\n172:\n173:        self._worktree_add(target, branch, base_ref)\n174:        handle = WorktreeHandle(\n175:            task_id=task_id, run_id=run_id, source_repo=str(self.source_repo),\n176:            path=str(target), branch=branch,\n177:            created_at=datetime.now(UTC).isoformat(),\n178:        )\n179:        # The handle marker lives *outside* the checked-out tree\n180:        # (worktrees_root/.<task_id>.worktree.json), not inside it, so\n181:        # writing it never makes git consider a fresh worktree \"dirty\".\n182:        # It is the creation-time provenance record destruction is gated on.\n183:        marker.write_text(\n184:            json.dumps(handle.to_dict(), indent=2, sort_keys=True), encoding=\"utf-8\",\n185:        )\n186:        return handle\n187:\n188:    def _worktree_add(self, target: Path, branch: str, base_ref: str) -> None:\n189:        if self._branch_exists(branch):\n190:            # Adopt the surviving kernel-minted branch rather than deleting\n191:            # or shadowing it: its commits are recoverable work.\n192:            proc = _run_git(self.source_repo, [\"worktree\", \"add\", str(target), branch])\n193:        else:\n194:            proc = _run_git(self.source_repo, [\"worktree\", \"add\", \"-b\", branch, str(target), base_ref])\n195:        if proc.returncode != 0:\n196:            raise WorktreeError(f\"git worktree add failed: {proc.stderr.strip()}\")\n197:\n198:    # -- resume-state loading (hostile input) ---------------------------------\n199:\n200:    def load_handle(self, task_id: str) -> WorktreeHandle:\n201:        _validate_task_id(task_id)\n202:        marker = self._handle_marker(task_id)\n203:        if not marker.exists():\n204:            raise WorktreeAbsentError(f\"No worktree handle found for task {task_id}\")\n205:        try:\n206:            handle = WorktreeHandle.from_dict(json.loads(marker.read_text(encoding=\"utf-8\")))\n207:        except (json.JSONDecodeError, KeyError, TypeError) as exc:\n208:            raise WorktreeCorruptStateError(\n209:                f\"Handle marker for task {task_id} is unreadable: {exc}\"\n210:            ) from exc\n211:        # Wrong-TYPED fields (task_id: 123, path: null) parse fine but must\n212:        # classify as corrupt state, not leak as bare TypeErrors downstream.\n213:        for field_name in (\"task_id\", \"source_repo\", \"path\", \"branch\", \"created_at\"):\n214:            if not isinstance(getattr(handle, field_name), str):\n215:                raise WorktreeCorruptStateError(\n216:                    f\"Handle marker for task {task_id}: field {field_name!r} \"\n217:                    \"is not a string\"\n218:                )\n219:        if handle.run_id is not None and not isinstance(handle.run_id, str):\n220:            raise WorktreeCorruptStateError(\n221:                f\"Handle marker for task {task_id}: field 'run_id' is neither \"\n222:                \"null nor a string\"\n223:            )\n224:        self._validate_handle(handle, expected_task_id=task_id)\n225:        return handle\n226:\n227:    def _validate_handle(self, handle: WorktreeHandle, expected_task_id: str | None = None) -> None:\n228:        \"\"\"A handle is a resume/recovery header: validate it as hostile\n229:        input before it is allowed anywhere near a destructive operation.\"\"\"\n230:        _validate_task_id(handle.task_id)\n231:        if expected_task_id is not None and handle.task_id != expected_task_id:\n232:            raise WorktreeCorruptStateError(\n233:                f\"Handle task_id {handle.task_id!r} does not match expected \"\n234:                f\"{expected_task_id!r}\"\n235:            )\n236:        expected_branch = BRANCH_PREFIX + handle.task_id\n237:        if handle.branch != expected_branch:\n238:            raise WorktreeCorruptStateError(\n239:                f\"Handle branch {handle.branch!r} is not the kernel-minted \"\n240:                f\"{expected_branch!r}\"\n241:            )\n242:        expected_path = (self.worktrees_root / handle.task_id).resolve()\n243:        if Path(handle.path).resolve() != expected_path:\n244:            raise WorktreeCorruptStateError(\n245:                f\"Handle path {handle.path!r} is not this manager's \"\n246:                f\"{expected_path}\"\n247:            )\n248:        if Path(handle.source_repo).resolve() != self.source_repo.resolve():\n249:            raise WorktreeCorruptStateError(\n250:                f\"Handle source repo {handle.source_repo!r} is not this \"\n251:                f\"manager's {self.source_repo}\"\n252:            )\n253:\n254:    # -- destruction (provenance-gated) ---------------------------------------\n255:\n256:    def remove(self, handle: WorktreeHandle, force: bool = False,\n257:               delete_branch: bool = False, force_delete_branch: bool = False) -> None:\n258:        \"\"\"Cleans up a worktree the kernel can prove it minted.\n259:\n260:        Two independent destruction decisions carry two independent flags\n261:        (adversarial-review finding: one flag conflated them): ``force``\n262:        only overrides the dirty-tree refusal (uncommitted files are\n263:        discarded); ``force_delete_branch`` only escalates branch deletion\n264:        to ``-D`` for unmerged history. Refuses entirely — regardless of\n265:        either flag — when provenance cannot be proven: no marker\n266:        (WorktreeProvenanceError), marker/handle mismatch\n267:        (WorktreeCorruptStateError), or a directory git does not register\n268:        as a worktree (recoverable work, never deleted).\n269:\n270:        Destruction order is worktree → branch → marker, so the provenance\n271:        record is the LAST thing destroyed: if branch deletion refuses,\n272:        the marker survives and both a retry and create()'s reattach path\n273:        keep working (adversarial-review finding: the old order orphaned\n274:        the branch and dead-ended the retry).\"\"\"\n275:        self._validate_handle(handle)\n276:        marker = self._handle_marker(handle.task_id)\n277:        if not marker.exists():\n278:            raise WorktreeProvenanceError(\n279:                f\"Refusing to remove {handle.path}: no kernel handle marker — \"\n280:                \"cannot prove the kernel minted this worktree\"\n281:            )\n282:        recorded = self.load_handle(handle.task_id)\n283:        if recorded != handle:\n284:            raise WorktreeCorruptStateError(\n285:                f\"Refusing to remove {handle.path}: presented handle disagrees \"\n286:                \"with the creation-time provenance record\"\n287:            )\n288:\n289:        target = Path(handle.path)\n290:        if target.exists():\n291:            if not self._is_registered_worktree(target):\n292:                raise WorktreeCorruptStateError(\n293:                    f\"Refusing to remove {target}: git does not register it as \"\n294:                    \"a worktree; it may hold recoverable work\"\n295:                )\n296:            args = [\"worktree\", \"remove\", str(target)]\n297:            if force:\n298:                args.append(\"--force\")\n299:            proc = _run_git(self.source_repo, args)\n300:            if proc.returncode != 0:\n301:                raise WorktreeError(f\"git worktree remove failed: {proc.stderr.strip()}\")\n302:        else:\n303:            # Directory already gone: idempotent removal — drop the stale\n304:            # registration, then fall through to branch/marker cleanup.\n305:            self._unregister_missing(target)\n306:\n307:        if delete_branch:\n308:            # May raise (unmerged without force_delete_branch, protected\n309:            # floor...): the marker below is then deliberately left intact.\n310:            self._delete_minted_branch(handle.branch, force=force_delete_branch)\n311:\n312:        marker.unlink(missing_ok=True)\n313:\n314:    def _unregister_missing(self, target: Path) -> None:\n315:        \"\"\"Drop the stale registration of a worktree whose directory is\n316:        gone. Tries the targeted removal first; only falls back to the\n317:        repo-global `git worktree prune` (which also sweeps OTHER missing\n318:        worktrees — an accepted V1 collateral on this single-root\n319:        workstation) when git refuses the targeted form.\"\"\"\n320:        proc = _run_git(self.source_repo, [\"worktree\", \"remove\", \"--force\", str(target)])\n321:        if proc.returncode != 0 and self._is_registered_worktree(target):\n322:            _run_git(self.source_repo, [\"worktree\", \"prune\"])\n323:\n324:    def _delete_minted_branch(self, branch: str, force: bool) -> None:\n325:        \"\"\"Only branches the kernel minted may be auto-deleted, and never\n326:        the protected floor or the source repo's current branch.\"\"\"\n327:        if not branch.startswith(BRANCH_PREFIX):\n328:            raise WorktreeProvenanceError(\n329:                f\"Refusing to delete branch {branch!r}: outside the kernel's \"\n330:                f\"{BRANCH_PREFIX!r} namespace\"\n331:            )\n332:        if branch in _PROTECTED_BRANCHES:\n333:            raise WorktreeProvenanceError(f\"Refusing to delete protected branch {branch!r}\")\n334:        head = _run_git(self.source_repo, [\"rev-parse\", \"--abbrev-ref\", \"HEAD\"])\n335:        if head.returncode == 0 and head.stdout.strip() == branch:\n336:            raise WorktreeProvenanceError(\n337:                f\"Refusing to delete branch {branch!r}: it is the source \"\n338:                \"repo's current branch\"\n339:            )\n340:        proc = _run_git(self.source_repo, [\"branch\", \"-d\", branch])\n341:        if proc.returncode != 0:\n342:            if not force:\n343:                raise WorktreeError(\n344:                    f\"git branch -d refused (unmerged work?): {proc.stderr.strip()} — \"\n345:                    \"pass force_delete_branch=True only after deciding the \"\n346:                    \"branch history is disposable\"\n347:                )\n348:            proc = _run_git(self.source_repo, [\"branch\", \"-D\", branch])\n349:            if proc.returncode != 0:\n350:                raise WorktreeError(f\"git branch -D failed: {proc.stderr.strip()}\")\n351:\n352:    # -- autosave (reason-tagged recovery points) ------------------------------\n353:\n354:    def autosave(self, handle: WorktreeHandle, reason: str) -> str | None:\n355:        \"\"\"Commit all uncommitted work in the worktree as a recovery point,\n356:        tagged `gnosis-autosave(<task_id>): <reason>`. Returns the commit\n357:        sha, or None when there is nothing to commit.\n358:\n359:        Refuses (WorktreeAutosaveRefusedError) mid-merge/mid-rebase states,\n360:        unmerged paths, and leftover conflict markers: losing a recovery\n361:        point beats poisoning the branch with a half-resolved state.\"\"\"\n362:        self._validate_handle(handle)\n363:        target = Path(handle.path)\n364:        if not target.exists():\n365:            raise WorktreeAbsentError(f\"Worktree directory {target} does not exist\")\n366:        if not self._is_registered_worktree(target):\n367:            raise WorktreeCorruptStateError(\n368:                f\"{target} is not a git-registered worktree\"\n369:            )\n370:\n371:        git_dir_proc = _run_git(target, [\"rev-parse\", \"--git-dir\"])\n372:        if git_dir_proc.returncode != 0:\n373:            raise WorktreeCorruptStateError(\n374:                f\"Cannot resolve git dir for {target}: {git_dir_proc.stderr.strip()}\"\n375:            )\n376:        git_dir = Path(git_dir_proc.stdout.strip())\n377:        if not git_dir.is_absolute():\n378:            git_dir = (target / git_dir).resolve()\n379:        for marker_name, tag in ((\"MERGE_HEAD\", \"mid-merge\"),\n380:                                 (\"rebase-merge\", \"mid-rebase\"),\n381:                                 (\"rebase-apply\", \"mid-rebase\"),\n382:                                 (\"CHERRY_PICK_HEAD\", \"mid-cherry-pick\"),\n383:                                 (\"REVERT_HEAD\", \"mid-revert\"),\n384:                                 (\"BISECT_LOG\", \"mid-bisect\")):\n385:            if (git_dir / marker_name).exists():\n386:                raise WorktreeAutosaveRefusedError(tag, f\"{git_dir / marker_name} present\")\n387:\n388:        # A recovery point must land on the minted branch: a commit made on\n389:        # a detached HEAD lands on no ref and becomes unreachable the\n390:        # moment the worktree is removed (adversarial-review finding).\n391:        head = _run_git(target, [\"rev-parse\", \"--abbrev-ref\", \"HEAD\"])\n392:        if head.returncode != 0 or head.stdout.strip() != handle.branch:\n393:            raise WorktreeAutosaveRefusedError(\n394:                \"off-branch\",\n395:                f\"HEAD is {head.stdout.strip() or 'unresolvable'!r}, \"\n396:                f\"not the minted {handle.branch!r}\",\n397:            )\n398:\n399:        status = _run_git(target, [\"status\", \"--porcelain\"])\n400:        if status.returncode != 0:\n401:            raise WorktreeError(f\"git status failed: {status.stderr.strip()}\")\n402:        lines = [line for line in status.stdout.splitlines() if line.strip()]\n403:        if not lines:\n404:            return None\n405:        unmerged = [line for line in lines\n406:                    if line[:2] in {\"DD\", \"AU\", \"UD\", \"UA\", \"DU\", \"AA\", \"UU\"}]\n407:        if unmerged:\n408:            raise WorktreeAutosaveRefusedError(\n409:                \"unmerged-paths\", f\"{len(unmerged)} unmerged path(s): {unmerged[:3]}\"\n410:            )\n411:        # Conflict markers hide in three places `git add -A` would commit:\n412:        # unstaged tracked changes (diff --check), STAGED tracked changes\n413:        # (diff --cached --check — bare diff --check misses them once the\n414:        # caller ran `git add`, the classic escape after `merge --quit`),\n415:        # and untracked files, which no diff variant inspects at all\n416:        # (adversarial-review finding, reproduced with committed markers).\n417:        for args in ([\"diff\", \"--check\"], [\"diff\", \"--cached\", \"--check\"]):\n418:            check = _run_git(target, args)\n419:            if \"conflict marker\" in check.stdout.lower():\n420:                raise WorktreeAutosaveRefusedError(\n421:                    \"conflict-markers\", check.stdout.strip()[:500]\n422:                )\n423:        for line in lines:\n424:            if not line.startswith(\"??\"):\n425:                continue\n426:            untracked = target / line[3:].strip().strip('\"')\n427:            if not untracked.is_file() or untracked.stat().st_size > 1_000_000:\n428:                continue\n429:            content = untracked.read_text(encoding=\"utf-8\", errors=\"ignore\")\n430:            if _CONFLICT_MARKER_RE.search(content):\n431:                raise WorktreeAutosaveRefusedError(\n432:                    \"conflict-markers\",\n433:                    f\"untracked file {untracked.name} contains conflict markers\",\n434:                )\n435:\n436:        clean_reason = \" \".join(reason.split())[:200] or \"unspecified\"\n437:        add = _run_git(target, [\"add\", \"-A\"])\n438:        if add.returncode != 0:\n439:            raise WorktreeError(f\"git add failed: {add.stderr.strip()}\")\n440:        commit = _run_git(\n441:            target, [\"commit\", \"-m\", f\"gnosis-autosave({handle.task_id}): {clean_reason}\"],\n442:        )\n443:        if commit.returncode != 0:\n444:            raise WorktreeError(f\"git commit failed: {commit.stderr.strip()}\")\n445:        sha = _run_git(target, [\"rev-parse\", \"HEAD\"])\n446:        if sha.returncode != 0:\n447:            raise WorktreeError(f\"git rev-parse failed after autosave: {sha.stderr.strip()}\")\n448:        return sha.stdout.strip()\n449:\n450:    # -- shared helpers --------------------------------------------------------\n451:\n452:    def _handle_marker(self, task_id: str) -> Path:\n453:        return self.worktrees_root / f\".{task_id}.worktree.json\"\n454:\n455:    def _branch_exists(self, branch: str) -> bool:\n456:        proc = _run_git(self.source_repo, [\"rev-parse\", \"--verify\", \"--quiet\",\n457:                                           f\"refs/heads/{branch}\"])\n458:        return proc.returncode == 0\n459:\n460:    def _is_registered_worktree(self, target: Path) -> bool:\n461:        proc = _run_git(self.source_repo, [\"worktree\", \"list\", \"--porcelain\"])\n462:        if proc.returncode != 0:\n463:            return False\n464:        registered = {\n465:            Path(line[len(\"worktree \"):]).resolve()\n466:            for line in proc.stdout.splitlines()\n467:            if line.startswith(\"worktree \")\n468:        }\n469:        return target.resolve() in registered\n470:\n471:    def evidence_for(self, handle: WorktreeHandle) -> GitEvidence:\n472:        return capture_git_evidence(Path(handle.path))\n473:\n474:    def prune(self) -> None:\n475:        _run_git(self.source_repo, [\"worktree\", \"prune\"])\n476:\n477:    def list_worktree_paths(self) -> list[Path]:\n478:        if not self.worktrees_root.exists():\n479:            return []\n480:        return sorted(p for p in self.worktrees_root.iterdir() if p.is_dir())\n1:\"\"\"Durable, filesystem-backed run directories.\n2:\n3:Layout per run:\n4:  runs/<run_id>/\n5:    meta.json          RunMeta snapshot (state, task_id, timestamps)\n6:    heartbeat.json      liveness signal: ts + a ProcessFingerprint\n7:    ledger.jsonl         append-only RunLedger\n8:    raw/stdout.log         immutable raw stdout capture\n9:    raw/stderr.log         immutable raw stderr capture\n10:    result.json             structured ExecutionResult, once finished\n11:    git/                      captured git evidence snapshots (pre/post)\n12:\n13:This directory *is* the durable state, no external database. Restarting\n14:the kernel process is safe: everything needed to audit or reason about a\n15:run is on disk. meta.json/heartbeat.json are written via atomic_write_text\n16:(write-tmp + os.replace) so a reader never observes a torn write; the\n17:meta.json read-modify-write cycle (update_state) is additionally guarded\n18:by a FileLock so two concurrent updaters cannot silently drop one\n19:another's transition, single-writer-per-run is enforced structurally, not\n20:by convention.\n21:\"\"\"\n22:from __future__ import annotations\n23:\n24:import json\n25:from dataclasses import asdict, dataclass\n26:from datetime import UTC, datetime\n27:from pathlib import Path\n28:from typing import Any\n29:\n30:from .atomic_io import atomic_write_text\n31:from .file_lock import FileLock, lock_path_for\n32:from .ledger import RunLedger\n33:from .state_machine import RunState\n34:\n35:\n36:@dataclass\n37:class RunMeta:\n38:    run_id: str\n39:    task_id: str\n40:    state: str\n41:    created_at: str\n42:    updated_at: str\n43:    attempt: int = 1\n44:    extra: dict[str, Any] | None = None\n45:\n46:    def to_dict(self) -> dict[str, Any]:\n47:        d = asdict(self)\n48:        d[\"extra\"] = self.extra or {}\n49:        return d\n50:\n51:    @classmethod\n52:    def from_dict(cls, data: dict[str, Any]) -> RunMeta:\n53:        return cls(**data)\n54:\n55:\n56:class RunPaths:\n57:    def __init__(self, root: Path):\n58:        self.root = root\n59:        self.meta = root / \"meta.json\"\n60:        self.heartbeat = root / \"heartbeat.json\"\n61:        self.ledger = root / \"ledger.jsonl\"\n62:        self.raw_dir = root / \"raw\"\n63:        self.stdout = self.raw_dir / \"stdout.log\"\n64:        self.stderr = self.raw_dir / \"stderr.log\"\n65:        self.result = root / \"result.json\"\n66:        self.git_dir = root / \"git\"\n67:\n68:\n69:class RunStore:\n70:    def __init__(self, root: Path):\n71:        self.root = root\n72:        self.root.mkdir(parents=True, exist_ok=True)\n73:\n74:    def paths_for(self, run_id: str) -> RunPaths:\n75:        return RunPaths(self.root / run_id)\n76:\n77:    def create_run(self, run_id: str, task_id: str) -> RunPaths:\n78:        paths = self.paths_for(run_id)\n79:        paths.root.mkdir(parents=True, exist_ok=False)\n80:        paths.raw_dir.mkdir(parents=True, exist_ok=True)\n81:        paths.git_dir.mkdir(parents=True, exist_ok=True)\n82:        now = datetime.now(UTC).isoformat()\n83:        meta = RunMeta(\n84:            run_id=run_id, task_id=task_id, state=RunState.PENDING.value,\n85:            created_at=now, updated_at=now,\n86:        )\n87:        self._write_meta_locked(paths, meta)\n88:        RunLedger(paths.ledger)\n89:        return paths\n90:\n91:    def write_meta(self, run_id: str, meta: RunMeta) -> None:\n92:        paths = self.paths_for(run_id)\n93:        self._write_meta_locked(paths, meta)\n94:\n95:    def _write_meta_locked(self, paths: RunPaths, meta: RunMeta) -> None:\n96:        meta.updated_at = datetime.now(UTC).isoformat()\n97:        with FileLock(lock_path_for(paths.meta)):\n98:            atomic_write_text(paths.meta, json.dumps(meta.to_dict(), indent=2, sort_keys=True))\n99:\n100:    def read_meta(self, run_id: str) -> RunMeta:\n101:        paths = self.paths_for(run_id)\n102:        return RunMeta.from_dict(json.loads(paths.meta.read_text(encoding=\"utf-8\")))\n103:\n104:    def update_state(self, run_id: str, state: RunState) -> RunMeta:\n105:        \"\"\"Atomic read-modify-write of a run's state, guarded by the same\n106:        lock write_meta uses, so two concurrent callers cannot race and\n107:        silently overwrite each other's transition.\"\"\"\n108:        paths = self.paths_for(run_id)\n109:        with FileLock(lock_path_for(paths.meta)):\n110:            meta = RunMeta.from_dict(json.loads(paths.meta.read_text(encoding=\"utf-8\")))\n111:            meta.state = state.value\n112:            meta.updated_at = datetime.now(UTC).isoformat()\n113:            atomic_write_text(paths.meta, json.dumps(meta.to_dict(), indent=2, sort_keys=True))\n114:            return meta\n115:\n116:    def heartbeat(self, run_id: str, fingerprint: Any | None = None) -> None:\n117:        from ..runner.liveness import ProcessFingerprint, current_fingerprint\n118:\n119:        paths = self.paths_for(run_id)\n120:        fp: ProcessFingerprint = fingerprint or current_fingerprint()\n121:        payload = {\"ts\": datetime.now(UTC).isoformat(), **fp.to_dict()}\n122:        atomic_write_text(paths.heartbeat, json.dumps(payload))\n123:\n124:    def read_heartbeat(self, run_id: str) -> dict[str, Any] | None:\n125:        paths = self.paths_for(run_id)\n126:        if not paths.heartbeat.exists():\n127:            return None\n128:        # json.loads returns Any; annotate a local so strict mypy sees the\n129:        # declared payload shape instead of returning Any.\n130:        payload: dict[str, Any] = json.loads(paths.heartbeat.read_text(encoding=\"utf-8\"))\n131:        return payload\n132:\n133:    def list_run_ids(self) -> list[str]:\n134:        if not self.root.exists():\n135:            return []\n136:        return sorted(p.name for p in self.root.iterdir() if p.is_dir())\n137:\n138:    def ledger_for(self, run_id: str) -> RunLedger:\n139:        return RunLedger(self.paths_for(run_id).ledger)\n","exit_code":0,"status":"completed"}}
