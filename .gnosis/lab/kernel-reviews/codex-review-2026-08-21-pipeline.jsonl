{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'rg -n \"''^\" src/gnosis/director/pipeline.py -A 0 -B 0; rg -n \"''^\" src/gnosis/runner/gated_runner.py -A 0 -B 0; rg -n \"''^\" src/gnosis/kernel/convergence.py -A 0 -B 0; rg -n \"''^\" src/gnosis/adapters/cli_review.py -A 0 -B 0; rg -n \"''^\" src/gnosis/kernel/scheduler.py -A 0 -B 0'","aggregated_output":"1:\"\"\"One brief, one governed and recorded run, one convergent result.\r\n2:\r\n3:The integration milestone. Every piece it uses already existed and was\r\n4:tested alone; nothing composed them, which is the shape Directive 9\r\n5:named one level up — four real mechanisms and no path that runs a real\r\n6:request through all of them.\r\n7:\r\n8:    brief\r\n9:      -> TaskScheduler        (is the credential's window open?)\r\n10:      -> TaskEngine           (policy gate, worktree isolation, retries,\r\n11:                               typed classification, durable evidence)\r\n12:      -> ConvergenceLoop      (verify -> independent review -> fix, bounded)\r\n13:           with CliReviewer / CliFixer behind a GatedAgentRunner\r\n14:      -> EngineerReport       (one status covering BOTH halves)\r\n15:\r\n16:Three decisions carry the weight:\r\n17:\r\n18:**Convergence launches agents too, so convergence is gated.** The\r\n19:reviewer and the fixer run once per round — usually more agents than the\r\n20:implementation itself. Running them through `GatedAgentRunner` means the\r\n21:policy gate and the rate-limit hold cover every launch a brief causes,\r\n22:not just the first. A gate with partial coverage is worse than an absent\r\n23:one, because it reads as governed.\r\n24:\r\n25:**The report cannot say COMPLETED unless convergence converged.** The\r\n26:implementation half can succeed while the review half finds blocking\r\n27:defects; that is the normal case and the entire reason the loop exists.\r\n28:Reporting the implementation's own opinion would be the agent's DONE\r\n29:claim closing a task, which is the first thing ADR-0008 forbids.\r\n30:\r\n31:**A park is not a failure anywhere along the path.** A held credential\r\n32:before the implementation, or during a fix round, parks the brief with\r\n33:its work intact (rules 6 and 7). `BriefRecordState.PARKED` exists so\r\n34:that state is expressible; writing it as FAILED would both lose the\r\n35:resumability and charge a provider's window to the agent.\r\n36:\"\"\"\r\n37:from __future__ import annotations\r\n38:\r\n39:import json\r\n40:from collections.abc import Callable, Sequence\r\n41:from dataclasses import dataclass\r\n42:from pathlib import Path\r\n43:from typing import Any\r\n44:\r\n45:from ..adapters.cli_review import CliFixer, CliReviewer\r\n46:from ..contracts.director_brief import DirectorBrief\r\n47:from ..contracts.engineer_report import EngineerReport, ReportStatus\r\n48:from ..kernel.convergence import (\r\n49:    ConvergenceLoop,\r\n50:    ConvergenceOutcome,\r\n51:    ConvergencePolicy,\r\n52:    ConvergenceResult,\r\n53:    EvidenceFailure,\r\n54:    git_fingerprint,\r\n55:)\r\n56:from ..kernel.engine import TaskExecutionOutcome\r\n57:from ..kernel.ids import new_task_id\r\n58:from ..kernel.policy import ApprovalStore, PolicyEngine\r\n59:from ..kernel.scheduler import ScheduleOutcome, TaskScheduler\r\n60:from ..kernel.verification import VerificationResult, Verifier\r\n61:from ..kernel.worktree import WorktreeError, WorktreeManager\r\n62:from ..runner.gated_runner import CredentialHeld, GatedAgentRunner, LaunchRefused\r\n63:from .brief_record import BriefRecordState, BriefRecordStore\r\n64:from .inbox import DirectorInbox\r\n65:\r\n66:REVIEW_STAGE = \"convergence_review\"\r\n67:FIX_STAGE = \"convergence_fix\"\r\n68:\r\n69:\r\n70:@dataclass(frozen=True)\r\n71:class PipelineOutcome:\r\n72:    \"\"\"What happened to one brief, end to end.\"\"\"\r\n73:\r\n74:    brief_id: str\r\n75:    task_id: str\r\n76:    status: ReportStatus\r\n77:    reason_code: str\r\n78:    report: EngineerReport\r\n79:    schedule: ScheduleOutcome | None = None\r\n80:    convergence: ConvergenceResult | None = None\r\n81:\r\n82:    @property\r\n83:    def implementation(self) -> TaskExecutionOutcome | None:\r\n84:        return self.schedule.execution if self.schedule else None\r\n85:\r\n86:    @property\r\n87:    def parked(self) -> bool:\r\n88:        return bool(self.schedule and self.schedule.parked)\r\n89:\r\n90:    def to_dict(self) -> dict[str, Any]:\r\n91:        return {\r\n92:            \"brief_id\": self.brief_id, \"task_id\": self.task_id,\r\n93:            \"status\": self.status.value, \"reason_code\": self.reason_code,\r\n94:            \"parked\": self.parked,\r\n95:            \"convergence\": self.convergence.to_dict() if self.convergence else None,\r\n96:        }\r\n97:\r\n98:\r\n99:class GovernedPipeline:\r\n100:    \"\"\"Runs a brief through the whole kernel, once.\"\"\"\r\n101:\r\n102:    def __init__(\r\n103:        self,\r\n104:        director_root: Path,\r\n105:        scheduler: TaskScheduler,\r\n106:        repo_path: Path,\r\n107:        verifier: Verifier,\r\n108:        policy: PolicyEngine,\r\n109:        review_runner: Any,\r\n110:        convergence_policy: ConvergencePolicy | None = None,\r\n111:        approvals: ApprovalStore | None = None,\r\n112:        policy_actor: str = \"agent://unattributed\",\r\n113:        worktrees: WorktreeManager | None = None,\r\n114:        prompt_builder: Callable[[DirectorBrief], str] | None = None,\r\n115:        reviewer_id: str = \"claude-cli\",\r\n116:        focus: Sequence[str] | None = None,\r\n117:    ) -> None:\r\n118:        self.inbox = DirectorInbox(director_root)\r\n119:        self.records = BriefRecordStore(director_root / \"state\" / \"briefs\")\r\n120:        self.scheduler = scheduler\r\n121:        self.repo_path = repo_path\r\n122:        # A verifier is REQUIRED, not optional. Convergence is defined as\r\n123:        # \"deterministic verification passed AND an independent review\r\n124:        # passed\"; without the first half the loop would converge on an\r\n125:        # agent's opinion alone, which is the failure ADR-0008 exists to\r\n126:        # prevent. The engine already refuses a governed task with no\r\n127:        # verifier; this refuses it one level up, at construction, where\r\n128:        # the mistake is visible.\r\n129:        self.verifier = verifier\r\n130:        self.policy = policy\r\n131:        self.review_runner = review_runner\r\n132:        self.convergence_policy = convergence_policy or ConvergencePolicy(max_rounds=3)\r\n133:        self.approvals = approvals\r\n134:        self.policy_actor = policy_actor\r\n135:        self.worktrees = worktrees\r\n136:        self.prompt_builder = prompt_builder or _default_prompt_builder\r\n137:        self.reviewer_id = reviewer_id\r\n138:        self.focus = tuple(focus or ())\r\n139:\r\n140:    # -- the whole path ---------------------------------------------------\r\n141:\r\n142:    def run_pending(self) -> list[PipelineOutcome]:\r\n143:        outcomes: list[PipelineOutcome] = []\r\n144:        for path in self.inbox.list_pending():\r\n145:            claim = self.inbox.claim(path)\r\n146:            if not claim.accepted or claim.brief is None:\r\n147:                continue\r\n148:            outcomes.append(self.run_brief(claim.brief))\r\n149:        return outcomes\r\n150:\r\n151:    def run_brief(self, brief: DirectorBrief) -> PipelineOutcome:\r\n152:        task_id = new_task_id()\r\n153:        self.records.create(brief.brief_id, task_id, BriefRecordState.ASSIGNED)\r\n154:        self.records.update(brief.brief_id, state=BriefRecordState.IN_PROGRESS)\r\n155:\r\n156:        try:\r\n157:            schedule = self._implement(brief, task_id)\r\n158:        except Exception as exc:  # noqa: BLE001 - a consumed brief must never strand\r\n159:            return self._finish(brief, task_id, ReportStatus.BLOCKED,\r\n160:                                f\"pipeline_error:{type(exc).__name__}\",\r\n161:                                problems=(f\"{type(exc).__name__}: {exc}\",))\r\n162:\r\n163:        if schedule.parked:\r\n164:            # Untouched and resumable. Not a failure, not an escalation.\r\n165:            return self._finish(\r\n166:                brief, task_id, ReportStatus.PARTIAL, schedule.reason_code,\r\n167:                schedule=schedule, brief_state=BriefRecordState.PARKED,\r\n168:                problems=((\"The credential's rate-limit window is shut; \"\r\n169:                           \"this brief was not started.\"),),\r\n170:                next_step=\"Resubmit when the hold expires, or probe it.\",\r\n171:            )\r\n172:\r\n173:        implementation = schedule.execution\r\n174:        if implementation is None or implementation.execution_result is None:\r\n175:            # No child ever ran (refused, crashed, or exhausted before\r\n176:            # launching). Converging on nothing would be theatre.\r\n177:            return self._finish(\r\n178:                brief, task_id,\r\n179:                implementation.report.status if implementation else ReportStatus.BLOCKED,\r\n180:                schedule.reason_code, schedule=schedule,\r\n181:                problems=(\"The implementation never produced a run to review.\",),\r\n182:            )\r\n183:\r\n184:        exec_root = self._exec_root(task_id)\r\n185:        try:\r\n186:            convergence = self._converge(brief, task_id, exec_root)\r\n187:        except CredentialHeld as held:\r\n188:            return self._finish(\r\n189:                brief, task_id, ReportStatus.PARTIAL, \"rate_limited:convergence\",\r\n190:                schedule=schedule, brief_state=BriefRecordState.PARKED,\r\n191:                problems=(str(held),),\r\n192:                next_step=\"The implementation stands; resume review when the window reopens.\",\r\n193:            )\r\n194:        except LaunchRefused as refused:\r\n195:            return self._finish(\r\n196:                brief, task_id, ReportStatus.ESCALATION_REQUIRED,\r\n197:                refused.decision.reason, schedule=schedule,\r\n198:                problems=(f\"Policy refused a convergence launch: {refused.decision.reason}\",),\r\n199:                next_step=\"Approve the exact action id, or change it, then resubmit.\",\r\n200:            )\r\n201:\r\n202:        # A refusal inside the review half never reaches the `except`\r\n203:        # above: `ConvergenceLoop` catches everything `review_fn` raises\r\n204:        # and files it as evidence collection failing — correctly, since\r\n205:        # no verdict was collected. But \"the policy said no\" and \"the\r\n206:        # reviewer crashed\" demand different answers, and reporting a\r\n207:        # governance refusal as an ordinary exhausted loop would hide it.\r\n208:        # This is what the typed `evidence_failures` are for.\r\n209:        refusal = _first_failure_of(convergence, \"LaunchRefused\")\r\n210:        if refusal is not None:\r\n211:            return self._finish(\r\n212:                brief, task_id, ReportStatus.ESCALATION_REQUIRED,\r\n213:                _reason_from(refusal.message), schedule=schedule,\r\n214:                convergence=convergence,\r\n215:                next_step=\"Approve the exact action id, or change it, then resubmit.\",\r\n216:            )\r\n217:        # Not named `held`: that name is bound by the `except CredentialHeld\r\n218:        # as held` above, and Python deletes it when the block exits.\r\n219:        hold_failure = _first_failure_of(convergence, \"CredentialHeld\")\r\n220:        if hold_failure is not None:\r\n221:            return self._finish(\r\n222:                brief, task_id, ReportStatus.PARTIAL, \"rate_limited:convergence\",\r\n223:                schedule=schedule, convergence=convergence,\r\n224:                brief_state=BriefRecordState.PARKED,\r\n225:                next_step=\"The implementation stands; resume review when the window reopens.\",\r\n226:            )\r\n227:\r\n228:        return self._finish(\r\n229:            brief, task_id, _status_for(convergence), convergence.outcome.value,\r\n230:            schedule=schedule, convergence=convergence,\r\n231:        )\r\n232:\r\n233:    # -- halves -----------------------------------------------------------\r\n234:\r\n235:    def _implement(self, brief: DirectorBrief, task_id: str) -> ScheduleOutcome:\r\n236:        return self.scheduler.submit(\r\n237:            task_id=task_id,\r\n238:            objective=brief.title,\r\n239:            prompt=self.prompt_builder(brief),\r\n240:            repo_path=self.repo_path,\r\n241:            verifier=self.verifier,\r\n242:            worktrees=self.worktrees,\r\n243:            policy=self.policy,\r\n244:            approvals=self.approvals,\r\n245:            policy_actor=self.policy_actor,\r\n246:        )\r\n247:\r\n248:    def _exec_root(self, task_id: str) -> Path:\r\n249:        \"\"\"Where the work actually landed.\r\n250:\r\n251:        Convergence must review the WORKTREE, not the source repo: the\r\n252:        implementation's changes are not in the source tree, so reviewing\r\n253:        it would judge code nobody wrote and report a clean bill for work\r\n254:        that never happened.\r\n255:        \"\"\"\r\n256:        if self.worktrees is None:\r\n257:            return self.repo_path\r\n258:        try:\r\n259:            return Path(self.worktrees.load_handle(task_id).path)\r\n260:        except (WorktreeError, FileNotFoundError, OSError):\r\n261:            return self.repo_path\r\n262:\r\n263:    def _converge(self, brief: DirectorBrief, task_id: str,\r\n264:                  exec_root: Path) -> ConvergenceResult:\r\n265:        evidence_dir = self.inbox.layout.outbox / f\"{task_id}-convergence\"\r\n266:        objective = brief.title\r\n267:\r\n268:        def gated(stage: str) -> GatedAgentRunner:\r\n269:            return GatedAgentRunner(\r\n270:                inner=self.review_runner, policy=self.policy, exec_root=exec_root,\r\n271:                stage=stage, task_id=task_id, approvals=self.approvals,\r\n272:                policy_actor=self.policy_actor, holds=self.scheduler,\r\n273:                worktree_branch=(\r\n274:                    self.worktrees.planned_branch(task_id) if self.worktrees else None\r\n275:                ),\r\n276:            )\r\n277:\r\n278:        result = ConvergenceLoop(\r\n279:            policy=self.convergence_policy,\r\n280:            verify_fn=lambda: self.verifier.run(exec_root),\r\n281:            review_fn=CliReviewer(\r\n282:                gated(REVIEW_STAGE), exec_root, evidence_dir, objective,\r\n283:                reviewer_id=self.reviewer_id, focus=self.focus,\r\n284:            ),\r\n285:            fix_fn=CliFixer(\r\n286:                gated(FIX_STAGE), exec_root, evidence_dir, objective,\r\n287:                fixer_id=self.reviewer_id,\r\n288:            ),\r\n289:            fingerprint_fn=lambda: git_fingerprint(exec_root),\r\n290:        ).run()\r\n291:\r\n292:        evidence_dir.mkdir(parents=True, exist_ok=True)\r\n293:        (evidence_dir / \"convergence.json\").write_text(\r\n294:            json.dumps(result.to_dict(), indent=2, sort_keys=True), encoding=\"utf-8\")\r\n295:        return result\r\n296:\r\n297:    # -- reporting --------------------------------------------------------\r\n298:\r\n299:    def _finish(\r\n300:        self,\r\n301:        brief: DirectorBrief,\r\n302:        task_id: str,\r\n303:        status: ReportStatus,\r\n304:        reason_code: str,\r\n305:        schedule: ScheduleOutcome | None = None,\r\n306:        convergence: ConvergenceResult | None = None,\r\n307:        brief_state: BriefRecordState | None = None,\r\n308:        problems: tuple[str, ...] = (),\r\n309:        next_step: str = \"\",\r\n310:    ) -> PipelineOutcome:\r\n311:        implementation = schedule.execution if schedule else None\r\n312:        run_ids = list(implementation.run_ids) if implementation else []\r\n313:        report = EngineerReport(\r\n314:            task_id=task_id,\r\n315:            # A report needs a run id; a brief refused before any run has\r\n316:            # none, and inventing one would put a reference in the record\r\n317:            # that resolves to nothing.\r\n318:            run_id=run_ids[-1] if run_ids else f\"{task_id}-no-run\",\r\n319:            status=status,\r\n320:            objective=brief.title,\r\n321:            verification=_verification_lines(implementation, convergence),\r\n322:            problems_encountered=problems or _problem_lines(convergence),\r\n323:            remaining_risks=_dissent_lines(convergence),\r\n324:            recommended_next_step=next_step or _next_step_for(status, convergence),\r\n325:        )\r\n326:        self._write_report(report)\r\n327:        self.records.update(\r\n328:            brief.brief_id,\r\n329:            state=brief_state or _brief_state_for(status),\r\n330:            run_ids=run_ids,\r\n331:            report_path=str(self.inbox.layout.outbox / f\"{task_id}.json\"),\r\n332:        )\r\n333:        return PipelineOutcome(\r\n334:            brief_id=brief.brief_id, task_id=task_id, status=status,\r\n335:            reason_code=reason_code, report=report, schedule=schedule,\r\n336:            convergence=convergence,\r\n337:        )\r\n338:\r\n339:    def _write_report(self, report: EngineerReport) -> None:\r\n340:        layout = self.inbox.layout\r\n341:        payload = json.dumps(report.to_dict(), indent=2, sort_keys=True)\r\n342:        _atomic_write(layout.outbox / f\"{report.task_id}.json\", payload)\r\n343:        _atomic_write(layout.outbox / f\"{report.task_id}.md\", report.to_markdown())\r\n344:        if report.status == ReportStatus.ESCALATION_REQUIRED:\r\n345:            _atomic_write(layout.escalations / f\"{report.task_id}.json\", payload)\r\n346:            _atomic_write(layout.escalations / f\"{report.task_id}.md\", report.to_markdown())\r\n347:\r\n348:\r\n349:def _first_failure_of(convergence: ConvergenceResult, error_type: str) -> EvidenceFailure | None:\r\n350:    return next((f for f in convergence.evidence_failures\r\n351:                 if f.error_type == error_type), None)\r\n352:\r\n353:\r\n354:def _reason_from(message: str) -> str:\r\n355:    \"\"\"The policy's OWN reason code, not a paraphrase of it.\r\n356:\r\n357:    `LaunchRefused` formats as \"policy refused this launch: <reason>\";\r\n358:    the reason is what an operator searches the ledger for.\"\"\"\r\n359:    marker = \"policy refused this launch: \"\r\n360:    return message.split(marker, 1)[1].strip() if marker in message else message\r\n361:\r\n362:\r\n363:def _status_for(convergence: ConvergenceResult) -> ReportStatus:\r\n364:    \"\"\"Only a converged loop is COMPLETED.\r\n365:\r\n366:    The implementation's own verdict does not appear here on purpose. A\r\n367:    task closes on evidence — deterministic verification AND an\r\n368:    independent review — never on the claim of the agent that did the\r\n369:    work.\"\"\"\r\n370:    if convergence.outcome is ConvergenceOutcome.CONVERGED:\r\n371:        return ReportStatus.COMPLETED\r\n372:    if convergence.outcome is ConvergenceOutcome.CANNOT_FIX:\r\n373:        return ReportStatus.ESCALATION_REQUIRED\r\n374:    # STALEMATE and ROUNDS_EXHAUSTED: work happened, it did not finish.\r\n375:    return ReportStatus.PARTIAL\r\n376:\r\n377:\r\n378:def _brief_state_for(status: ReportStatus) -> BriefRecordState:\r\n379:    if status is ReportStatus.COMPLETED:\r\n380:        return BriefRecordState.COMPLETED\r\n381:    if status is ReportStatus.ESCALATION_REQUIRED:\r\n382:        return BriefRecordState.ESCALATED\r\n383:    if status is ReportStatus.PARTIAL:\r\n384:        return BriefRecordState.IN_PROGRESS\r\n385:    return BriefRecordState.FAILED\r\n386:\r\n387:\r\n388:def _verification_lines(implementation: TaskExecutionOutcome | None,\r\n389:                        convergence: ConvergenceResult | None) -> tuple[str, ...]:\r\n390:    lines: list[str] = []\r\n391:    if implementation is not None and implementation.verification is not None:\r\n392:        lines.append(_verification_line(\"implementation\", implementation.verification))\r\n393:    if convergence is not None:\r\n394:        lines.append(f\"convergence: {convergence.outcome.value} \"\r\n395:                     f\"over {len(convergence.rounds)} round(s)\")\r\n396:        for record in convergence.rounds:\r\n397:            if record.verification is not None:\r\n398:                lines.append(_verification_line(f\"round {record.index}\", record.verification))\r\n399:            if record.review is not None:\r\n400:                lines.append(\r\n401:                    f\"round {record.index} review [{record.review.reviewer}]: \"\r\n402:                    f\"{record.review.verdict.value}\"\r\n403:                )\r\n404:    return tuple(lines)\r\n405:\r\n406:\r\n407:def _verification_line(label: str, result: VerificationResult) -> str:\r\n408:    return f\"{label} verification [{result.name}]: {'PASS' if result.passed else 'FAIL'}\"\r\n409:\r\n410:\r\n411:def _problem_lines(convergence: ConvergenceResult | None) -> tuple[str, ...]:\r\n412:    if convergence is None:\r\n413:        return ()\r\n414:    problems = [\r\n415:        f\"round {record.index}: {finding.severity.value} {finding.category} — \"\r\n416:        f\"{finding.description}\"\r\n417:        for record in convergence.rounds for finding in record.blocking\r\n418:    ]\r\n419:    # Typed evidence failures are reported as themselves: \"review\r\n420:    # collection failed\" reads the same whether an agent produced\r\n421:    # unreadable output or edited the code it was judging.\r\n422:    problems.extend(\r\n423:        f\"{failure.stage} evidence failed [{failure.error_type}]: {failure.message}\"\r\n424:        for failure in convergence.evidence_failures\r\n425:    )\r\n426:    return tuple(problems)\r\n427:\r\n428:\r\n429:def _dissent_lines(convergence: ConvergenceResult | None) -> tuple[str, ...]:\r\n430:    \"\"\"Nothing-lost rule: gated and non-blocking findings still surface.\"\"\"\r\n431:    if convergence is None:\r\n432:        return ()\r\n433:    risks = [f\"dissent: {f.severity.value} {f.category} — {f.description}\"\r\n434:             for f in convergence.dissent]\r\n435:    risks.extend(\r\n436:        f\"gated ({g.gate_reason}): {g.finding.severity.value} {g.finding.category} — \"\r\n437:        f\"{g.finding.description}\"\r\n438:        for g in convergence.gate_ledger\r\n439:    )\r\n440:    return tuple(risks)\r\n441:\r\n442:\r\n443:def _next_step_for(status: ReportStatus, convergence: ConvergenceResult | None) -> str:\r\n444:    if status is ReportStatus.COMPLETED:\r\n445:        return \"Integrate the worktree.\"\r\n446:    if convergence is None:\r\n447:        return \"Inspect the run evidence before resubmitting.\"\r\n448:    if convergence.outcome is ConvergenceOutcome.CANNOT_FIX:\r\n449:        return \"A fixer reported it cannot address a blocking finding; a human decides.\"\r\n450:    if convergence.outcome is ConvergenceOutcome.STALEMATE:\r\n451:        return \"The tree stopped changing while findings stand; change strategy.\"\r\n452:    return \"Rounds were exhausted with findings outstanding; resubmit or raise max_rounds.\"\r\n453:\r\n454:\r\n455:def _atomic_write(path: Path, text: str) -> None:\r\n456:    path.parent.mkdir(parents=True, exist_ok=True)\r\n457:    tmp = path.with_name(f\"{path.name}.tmp\")\r\n458:    tmp.write_text(text, encoding=\"utf-8\")\r\n459:    tmp.replace(path)\r\n460:\r\n461:\r\n462:def _default_prompt_builder(brief: DirectorBrief) -> str:\r\n463:    parts = [brief.mission]\r\n464:    if brief.constraints:\r\n465:        parts.append(\"Constraints: \" + \"; \".join(brief.constraints))\r\n466:    if brief.acceptance_criteria:\r\n467:        parts.append(\"Acceptance criteria: \" + \"; \".join(brief.acceptance_criteria))\r\n468:    return \"\\n\\n\".join(parts)\r\n1:\"\"\"Every agent launch passes the gate, not just the first one.\n2:\n3:ADR-0013 wired the policy gate into `TaskEngine.execute_task`, which\n4:covers the launch that implements a task. A convergence loop then\n5:launches a reviewer and a fixer once per round — potentially many more\n6:agents than the task itself — and none of those went past a gate or a\n7:rate-limit hold. The gate was real and its coverage was partial, which\n8:is a worse position than it sounds: it reads as governed.\n9:\n10:`GatedAgentRunner` duck-types a CLI runner and consults, before each\n11:launch:\n12:\n13:1. the **hold plane**, so a shut credential parks the round instead of\n14:   burning it (rule 6), and\n15:2. the **policy engine**, at the same `before_agent_run` intervention\n16:   point and with the same snapshot shape the engine uses — so an\n17:   operator approving an action approves one identity, not two.\n18:\n19:A refusal raises. It does not return a fake result, because the caller's\n20:contract is \"here is what the agent said\" and inventing that is the one\n21:thing the whole review apparatus exists to prevent.\n22:\"\"\"\n23:from __future__ import annotations\n24:\n25:from collections.abc import Callable, Sequence\n26:from pathlib import Path\n27:from typing import Any, Protocol\n28:\n29:from ..kernel.engine import DEFAULT_PERMISSION_MODE, agent_launch_snapshot\n30:from ..kernel.policy import (\n31:    ApprovalStore,\n32:    PolicyDecision,\n33:    PolicyEngine,\n34:    Verdict,\n35:    resolve_escalation,\n36:)\n37:from .capture import ExecutionResult\n38:from .claude_cli_runner import DEFAULT_TIMEOUT_S, McpRunnerConfig\n39:\n40:\n41:class LaunchRefused(RuntimeError):\n42:    \"\"\"Policy refused this agent launch.\n43:\n44:    Carries the decision so the caller records the policy's own reason\n45:    code rather than paraphrasing it.\"\"\"\n46:\n47:    def __init__(self, decision: PolicyDecision) -> None:\n48:        super().__init__(f\"policy refused this launch: {decision.reason}\")\n49:        self.decision = decision\n50:\n51:\n52:class CredentialHeld(RuntimeError):\n53:    \"\"\"The credential is rate-limit held, so no launch may happen.\n54:\n55:    A park, not a failure: rule 6 says a shut window is not the agent\n56:    misbehaving and rule 7 forbids charging it to agent quality.\"\"\"\n57:\n58:\n59:class HoldGate(Protocol):\n60:    \"\"\"The slice of the scheduler this needs: may work start right now?\"\"\"\n61:\n62:    def admits(self, *, is_resume: bool = ..., probe_run_id: str | None = ...) -> bool: ...\n63:\n64:\n65:class GatedAgentRunner:\n66:    \"\"\"Wraps a runner so every launch is gated and recorded.\n67:\n68:    Composable with `ReplayingCLIRunner` in either order; putting the\n69:    cassette *inside* is the useful arrangement, since a replayed launch\n70:    is still a launch an operator may want to have authorised.\n71:    \"\"\"\n72:\n73:    def __init__(\n74:        self,\n75:        inner: Any,\n76:        policy: PolicyEngine,\n77:        exec_root: Path,\n78:        stage: str,\n79:        task_id: str,\n80:        approvals: ApprovalStore | None = None,\n81:        policy_actor: str = \"agent://unattributed\",\n82:        holds: HoldGate | None = None,\n83:        worktree_branch: str | None = None,\n84:        on_decision: Callable[[str, PolicyDecision], None] | None = None,\n85:    ) -> None:\n86:        self.inner = inner\n87:        self.policy = policy\n88:        self.exec_root = exec_root\n89:        self.stage = stage\n90:        self.task_id = task_id\n91:        self.approvals = approvals\n92:        self.policy_actor = policy_actor\n93:        self.holds = holds\n94:        self.worktree_branch = worktree_branch\n95:        # Every verdict is handed to the caller to record. An allowed\n96:        # launch is evidence too, not just a refused one.\n97:        self.on_decision = on_decision\n98:        self.decisions: list[tuple[str, PolicyDecision]] = []\n99:\n100:    @property\n101:    def binary(self) -> str:\n102:        \"\"\"Pass through, so the gate sees the program that really runs.\n103:\n104:        ADR-0014 learned this the hard way: a wrapper without `.binary`\n105:        reported `<unknown-runner>`, silently changing the action identity\n106:        an approval is bound to.\"\"\"\n107:        inner_binary = getattr(self.inner, \"binary\", None)\n108:        return inner_binary if isinstance(inner_binary, str) and inner_binary else \"<unknown-runner>\"\n109:\n110:    def run(\n111:        self,\n112:        prompt: str,\n113:        cwd: Path,\n114:        stdout_path: Path,\n115:        stderr_path: Path,\n116:        timeout_s: float = DEFAULT_TIMEOUT_S,\n117:        permission_mode: str = DEFAULT_PERMISSION_MODE,\n118:        mcp: McpRunnerConfig | None = None,\n119:        model: str | None = None,\n120:        extra_args: Sequence[str] | None = None,\n121:        **kwargs: Any,\n122:    ) -> ExecutionResult:\n123:        if self.holds is not None and not self.holds.admits():\n124:            # Checked BEFORE the policy question: spending a verdict on an\n125:            # action that cannot run anyway is noise in the audit trail,\n126:            # and a park is not a policy event.\n127:            raise CredentialHeld(\n128:                f\"credential is held; {self.stage} for task {self.task_id} is parked\"\n129:            )\n130:\n131:        snapshot = agent_launch_snapshot(\n132:            stage=self.stage, task_id=self.task_id, prompt=prompt,\n133:            binary=self.binary, exec_root=cwd, planned_root=cwd, mcp=mcp,\n134:            worktree_branch=self.worktree_branch, policy_actor=self.policy_actor,\n135:            permission_mode=permission_mode, model=model,\n136:        )\n137:        decision = self.policy.decide(snapshot)\n138:        if self.approvals is not None:\n139:            decision = resolve_escalation(decision, snapshot, self.approvals)\n140:        self.decisions.append((self.stage, decision))\n141:        if self.on_decision is not None:\n142:            self.on_decision(self.stage, decision)\n143:        if decision.verdict not in (Verdict.ALLOW, Verdict.WARN):\n144:            # No child is launched. TRANSFORM is refused here for the same\n145:            # reason ADR-0013 refuses it in the engine: this point cannot\n146:            # rewrite an agent invocation, and silently dropping a\n147:            # mitigation it cannot apply is worse than stopping.\n148:            raise LaunchRefused(decision)\n149:\n150:        result: ExecutionResult = self.inner.run(\n151:            prompt=prompt, cwd=cwd, stdout_path=stdout_path,\n152:            stderr_path=stderr_path, timeout_s=timeout_s,\n153:            permission_mode=permission_mode, mcp=mcp, model=model,\n154:            extra_args=extra_args, **kwargs,\n155:        )\n156:        return result\n1:\"\"\"Review-convergence loop (Directive 6): signal ∧ evidence, tri-state\r\n2:rounds, stalemate fingerprints, nothing-lost gate ledger.\r\n3:\r\n4:The kernel owns the loop; reviewers and fixers are injected callables\r\n5:(later: Claude/Codex adapters; in tests: deterministic fakes). Rules,\r\n6:from docs/research/REFERENCE_REPOSITORY_FINDINGS.md §6:\r\n7:\r\n8:- **An agent's DONE claim never closes a Task.** Convergence requires\r\n9:  computer-checked evidence: the deterministic verification passed AND\r\n10:  the independent review verdict is PASS AND no blocking finding stands.\r\n11:  A fixer's ``claims_done`` with an unchanged repo fingerprint is\r\n12:  downgraded to continue-with-warning (ralphex: DONE means \"zero issues\r\n13:  this round\", not \"I finished fixing\").\r\n14:- **Rounds are tri-state**: clean round → CONVERGED; fixed-something →\r\n15:  another independent verification round; can't-fix → typed CANNOT_FIX.\r\n16:- **Stalemate is a kernel circuit breaker** over repo-state fingerprints\r\n17:  (git HEAD + status + diff, hashed with kernel.canonical): N\r\n18:  consecutive unchanged fingerprints → STALEMATE. The counter resets on\r\n19:  change and NEVER counts a round whose evidence collection failed\r\n20:  (fingerprint unavailable) — a broken probe must not masquerade as a\r\n21:  stuck repo.\r\n22:- **Nothing is lost.** Every finding held back by a gate (severity below\r\n23:  the blocking set, confidence below the floor) is carried in the\r\n24:  GateLedger and surfaced in the result at every loop exit; non-blocking\r\n25:  findings present at convergence are preserved as dissent (orca's\r\n26:  GateLedger, agent-arena's dissent preservation).\r\n27:- **Every loop is bounded** (constitution rule 8): ``max_rounds`` is\r\n28:  required and finite; exhaustion is its own typed outcome.\r\n29:\r\n30:Exceptions from ``fix_fn`` propagate raw: a crashing fixer is an agent\r\n31:failure for the caller's taxonomy to classify, never something this loop\r\n32:absorbs into a fake verdict. ``verify_fn``/``review_fn``/``fingerprint_fn``\r\n33:failures are treated as evidence-collection failures: the round cannot\r\n34:converge, cannot count toward stalemate, and is recorded with a warning.\r\n35:\"\"\"\r\n36:from __future__ import annotations\r\n37:\r\n38:from collections.abc import Callable\r\n39:from dataclasses import dataclass\r\n40:from enum import Enum\r\n41:from functools import partial\r\n42:from pathlib import Path\r\n43:from typing import Any\r\n44:\r\n45:from .canonical import hash_canonical\r\n46:from .git_evidence import capture_git_evidence\r\n47:from .verification import VerificationResult\r\n48:\r\n49:\r\n50:class ReviewVerdict(str, Enum):\r\n51:    PASS = \"PASS\"\r\n52:    FAIL = \"FAIL\"\r\n53:    UNCERTAIN = \"UNCERTAIN\"\r\n54:\r\n55:\r\n56:class Severity(str, Enum):\r\n57:    CRITICAL = \"CRITICAL\"\r\n58:    MAJOR = \"MAJOR\"\r\n59:    MINOR = \"MINOR\"\r\n60:    INFO = \"INFO\"\r\n61:\r\n62:\r\n63:@dataclass(frozen=True)\r\n64:class Finding:\r\n65:    severity: Severity\r\n66:    category: str\r\n67:    description: str\r\n68:    reviewer: str\r\n69:    evidence: str = \"\"\r\n70:    file: str | None = None\r\n71:    symbol: str | None = None\r\n72:    confidence: float = 1.0\r\n73:\r\n74:    def to_dict(self) -> dict[str, Any]:\r\n75:        return {\r\n76:            \"severity\": self.severity.value, \"category\": self.category,\r\n77:            \"description\": self.description, \"reviewer\": self.reviewer,\r\n78:            \"evidence\": self.evidence, \"file\": self.file, \"symbol\": self.symbol,\r\n79:            \"confidence\": self.confidence,\r\n80:        }\r\n81:\r\n82:\r\n83:@dataclass(frozen=True)\r\n84:class ReviewReport:\r\n85:    \"\"\"One independent reviewer's structured verdict for one round.\"\"\"\r\n86:\r\n87:    verdict: ReviewVerdict\r\n88:    findings: tuple[Finding, ...] = ()\r\n89:    reviewer: str = \"unknown\"\r\n90:    notes: str = \"\"\r\n91:\r\n92:\r\n93:@dataclass(frozen=True)\r\n94:class FixRequest:\r\n95:    round_index: int\r\n96:    blocking_findings: tuple[Finding, ...]\r\n97:    verification: VerificationResult | None\r\n98:\r\n99:\r\n100:@dataclass(frozen=True)\r\n101:class FixReport:\r\n102:    \"\"\"The fixer's own account of its round. ``claims_done`` is a SIGNAL,\r\n103:    never evidence — the next round's verification/review decide.\"\"\"\r\n104:\r\n105:    claims_done: bool = False\r\n106:    cannot_fix: bool = False\r\n107:    notes: str = \"\"\r\n108:\r\n109:\r\n110:@dataclass(frozen=True)\r\n111:class GatedFinding:\r\n112:    finding: Finding\r\n113:    gate_reason: str\r\n114:    round_index: int\r\n115:\r\n116:    def to_dict(self) -> dict[str, Any]:\r\n117:        return {\r\n118:            \"finding\": self.finding.to_dict(),\r\n119:            \"gate_reason\": self.gate_reason,\r\n120:            \"round_index\": self.round_index,\r\n121:        }\r\n122:\r\n123:\r\n124:class ConvergenceOutcome(str, Enum):\r\n125:    CONVERGED = \"CONVERGED\"\r\n126:    STALEMATE = \"STALEMATE\"\r\n127:    CANNOT_FIX = \"CANNOT_FIX\"\r\n128:    ROUNDS_EXHAUSTED = \"ROUNDS_EXHAUSTED\"\r\n129:\r\n130:\r\n131:@dataclass(frozen=True)\r\n132:class RoundRecord:\r\n133:    index: int\r\n134:    fingerprint: str | None\r\n135:    evidence_ok: bool\r\n136:    verification: VerificationResult | None\r\n137:    review: ReviewReport | None\r\n138:    blocking: tuple[Finding, ...]\r\n139:    gated: tuple[GatedFinding, ...]\r\n140:    fix: FixReport | None\r\n141:    warnings: tuple[str, ...]\r\n142:    unchanged_streak: int\r\n143:\r\n144:\r\n145:@dataclass(frozen=True)\r\n146:class EvidenceFailure:\r\n147:    \"\"\"A probe that raised, kept with its TYPE rather than only its text.\r\n148:\r\n149:    \"review collection failed: ...\" reads the same whether the agent\r\n150:    produced unreadable output, edited the code it was judging, or\r\n151:    crashed — and those demand very different responses. The loop's\r\n152:    handling is identical (no evidence was collected), but the record is\r\n153:    not (Codex review).\"\"\"\r\n154:\r\n155:    stage: str          # fingerprint | verification | review\r\n156:    error_type: str     # the exception class name, e.g. InvalidReviewOutput\r\n157:    message: str\r\n158:\r\n159:    def to_dict(self) -> dict[str, Any]:\r\n160:        return {\"stage\": self.stage, \"error_type\": self.error_type,\r\n161:                \"message\": self.message}\r\n162:\r\n163:\r\n164:@dataclass(frozen=True)\r\n165:class ConvergenceResult:\r\n166:    outcome: ConvergenceOutcome\r\n167:    rounds: tuple[RoundRecord, ...]\r\n168:    gate_ledger: tuple[GatedFinding, ...]\r\n169:    dissent: tuple[Finding, ...]\r\n170:    warnings: tuple[str, ...]\r\n171:    evidence_failures: tuple[EvidenceFailure, ...] = ()\r\n172:\r\n173:    def to_dict(self) -> dict[str, Any]:\r\n174:        return {\r\n175:            \"outcome\": self.outcome.value,\r\n176:            \"round_count\": len(self.rounds),\r\n177:            \"gate_ledger\": [g.to_dict() for g in self.gate_ledger],\r\n178:            \"dissent\": [f.to_dict() for f in self.dissent],\r\n179:            \"warnings\": list(self.warnings),\r\n180:            \"evidence_failures\": [f.to_dict() for f in self.evidence_failures],\r\n181:        }\r\n182:\r\n183:\r\n184:@dataclass(frozen=True)\r\n185:class ConvergencePolicy:\r\n186:    max_rounds: int\r\n187:    max_unchanged_rounds: int = 3\r\n188:    blocking_severities: frozenset[Severity] = frozenset({Severity.CRITICAL, Severity.MAJOR})\r\n189:    min_blocking_confidence: float = 0.5\r\n190:\r\n191:    def __post_init__(self) -> None:\r\n192:        if self.max_rounds < 1:\r\n193:            raise ValueError(\"ConvergencePolicy.max_rounds must be >= 1\")\r\n194:        if self.max_unchanged_rounds < 1:\r\n195:            raise ValueError(\"ConvergencePolicy.max_unchanged_rounds must be >= 1\")\r\n196:        if not 0.0 <= self.min_blocking_confidence <= 1.0:\r\n197:            raise ValueError(\"min_blocking_confidence must be within [0, 1]\")\r\n198:\r\n199:\r\n200:def git_fingerprint(repo_path: Path) -> str | None:\r\n201:    \"\"\"Repo-state fingerprint for stalemate detection: HEAD + working-tree\r\n202:    status + diff stat, hashed with the kernel's canonical contract.\r\n203:    Returns None when evidence collection fails (not a repo, no HEAD), so\r\n204:    the caller knows not to count the round.\"\"\"\r\n205:    evidence = capture_git_evidence(repo_path)\r\n206:    if not evidence.is_repo or evidence.head_sha is None:\r\n207:        return None\r\n208:    return hash_canonical({\r\n209:        \"head\": evidence.head_sha,\r\n210:        \"status\": evidence.status_porcelain,\r\n211:        \"diff\": evidence.diff_stat,\r\n212:    })\r\n213:\r\n214:\r\n215:class ConvergenceLoop:\r\n216:    \"\"\"Bounded implement→verify→review→fix convergence engine.\"\"\"\r\n217:\r\n218:    def __init__(\r\n219:        self,\r\n220:        policy: ConvergencePolicy,\r\n221:        verify_fn: Callable[[], VerificationResult],\r\n222:        review_fn: Callable[[int], ReviewReport],\r\n223:        fix_fn: Callable[[FixRequest], FixReport],\r\n224:        fingerprint_fn: Callable[[], str | None],\r\n225:    ):\r\n226:        self.policy = policy\r\n227:        self.verify_fn = verify_fn\r\n228:        self.review_fn = review_fn\r\n229:        self.fix_fn = fix_fn\r\n230:        self.fingerprint_fn = fingerprint_fn\r\n231:\r\n232:    def run(self) -> ConvergenceResult:\r\n233:        rounds: list[RoundRecord] = []\r\n234:        ledger: list[GatedFinding] = []\r\n235:        loop_warnings: list[str] = []\r\n236:        evidence_failures: list[EvidenceFailure] = []\r\n237:        prev_fingerprint: str | None = None\r\n238:        have_prev = False\r\n239:        unchanged = 0\r\n240:        last_fix: FixReport | None = None\r\n241:        # Last verification outcome observed per fingerprint, for the\r\n242:        # flip-detection guard below (Codex review finding 3).\r\n243:        verified_by_fp: dict[str, bool] = {}\r\n244:\r\n245:        for index in range(1, self.policy.max_rounds + 1):\r\n246:            warnings: list[str] = []\r\n247:\r\n248:            fingerprint = self._collect(\r\n249:                self.fingerprint_fn, \"fingerprint\", warnings, evidence_failures)\r\n250:            verification = self._collect(\r\n251:                self.verify_fn, \"verification\", warnings, evidence_failures)\r\n252:            review = self._collect(\r\n253:                partial(self.review_fn, index), \"review\", warnings, evidence_failures)\r\n254:            if fingerprint is None and not any(\"fingerprint\" in w for w in warnings):\r\n255:                # The probe's documented soft-failure mode is returning\r\n256:                # None (git_fingerprint); record it, same as a raise.\r\n257:                warnings.append(\r\n258:                    \"fingerprint unavailable: round cannot converge or \"\r\n259:                    \"count toward stalemate\"\r\n260:                )\r\n261:            evidence_ok = (\r\n262:                fingerprint is not None and verification is not None and review is not None\r\n263:            )\r\n264:\r\n265:            # Signal ∧ evidence: a prior DONE claim with an unchanged repo\r\n266:            # is downgraded to a warning, never trusted.\r\n267:            if (\r\n268:                last_fix is not None and last_fix.claims_done\r\n269:                and fingerprint is not None and have_prev\r\n270:                and fingerprint == prev_fingerprint\r\n271:            ):\r\n272:                warnings.append(\r\n273:                    \"fixer claimed done but the repo fingerprint did not \"\r\n274:                    \"change: signal without evidence, continuing\"\r\n275:                )\r\n276:\r\n277:            # Stalemate accounting — \"N CONSECUTIVE unchanged rounds\", and\r\n278:            # only rounds with COMPLETE evidence count (Codex review\r\n279:            # findings 1-2): a failed probe of any kind breaks the\r\n280:            # consecutive run entirely (streak and baseline), so a broken\r\n281:            # probe can neither masquerade as a stuck repo nor bridge a\r\n282:            # gap the kernel did not observe.\r\n283:            if evidence_ok:\r\n284:                if have_prev and fingerprint == prev_fingerprint:\r\n285:                    unchanged += 1\r\n286:                else:\r\n287:                    unchanged = 0\r\n288:                prev_fingerprint = fingerprint\r\n289:                have_prev = True\r\n290:            else:\r\n291:                unchanged = 0\r\n292:                have_prev = False\r\n293:\r\n294:            blocking: list[Finding] = []\r\n295:            gated_this_round: list[GatedFinding] = []\r\n296:            if review is not None:\r\n297:                for finding in review.findings:\r\n298:                    if finding.severity not in self.policy.blocking_severities:\r\n299:                        gated_this_round.append(GatedFinding(\r\n300:                            finding, f\"severity {finding.severity.value} below blocking set\", index,\r\n301:                        ))\r\n302:                    elif finding.confidence < self.policy.min_blocking_confidence:\r\n303:                        gated_this_round.append(GatedFinding(\r\n304:                            finding,\r\n305:                            f\"confidence {finding.confidence} below floor \"\r\n306:                            f\"{self.policy.min_blocking_confidence}\",\r\n307:                            index,\r\n308:                        ))\r\n309:                    else:\r\n310:                        blocking.append(finding)\r\n311:                ledger.extend(gated_this_round)\r\n312:\r\n313:            clean = (\r\n314:                evidence_ok\r\n315:                and verification is not None and verification.passed\r\n316:                and review is not None and review.verdict is ReviewVerdict.PASS\r\n317:                and not blocking\r\n318:            )\r\n319:\r\n320:            # Flip-detection guard (Codex review finding 3): a verification\r\n321:            # that FAILED earlier on this exact repo fingerprint and now\r\n322:            # PASSES with the repo unchanged is contradictory evidence — a\r\n323:            # flaky or gameable verifier must not close the task on one\r\n324:            # lucky pass. Convergence then requires the pass to be\r\n325:            # REPRODUCED in an independent round on the same fingerprint.\r\n326:            if (\r\n327:                clean and fingerprint is not None\r\n328:                and verified_by_fp.get(fingerprint) is False\r\n329:            ):\r\n330:                clean = False\r\n331:                warnings.append(\r\n332:                    \"verification outcome flipped from fail to pass on an \"\r\n333:                    \"unchanged repo fingerprint: requiring reproduction in \"\r\n334:                    \"an independent round before convergence\"\r\n335:                )\r\n336:            if fingerprint is not None and verification is not None:\r\n337:                verified_by_fp[fingerprint] = verification.passed\r\n338:\r\n339:            fix: FixReport | None = None\r\n340:            if not clean and evidence_ok:\r\n341:                needs_fix = bool(blocking) or (\r\n342:                    verification is not None and not verification.passed\r\n343:                )\r\n344:                if needs_fix:\r\n345:                    fix = self.fix_fn(FixRequest(\r\n346:                        round_index=index,\r\n347:                        blocking_findings=tuple(blocking),\r\n348:                        verification=verification,\r\n349:                    ))\r\n350:                    last_fix = fix\r\n351:                else:\r\n352:                    # e.g. an UNCERTAIN verdict with nothing concrete to\r\n353:                    # fix: another independent round decides; a reviewer\r\n354:                    # who stays uncertain over an unchanging repo runs\r\n355:                    # into the stalemate breaker, not an infinite loop.\r\n356:                    warnings.append(\r\n357:                        \"round not clean but no fixable target (verdict \"\r\n358:                        f\"{review.verdict.value if review else 'n/a'}): \"\r\n359:                        \"scheduling another independent round\"\r\n360:                    )\r\n361:\r\n362:            loop_warnings.extend(warnings)\r\n363:            rounds.append(RoundRecord(\r\n364:                index=index, fingerprint=fingerprint, evidence_ok=evidence_ok,\r\n365:                verification=verification, review=review,\r\n366:                blocking=tuple(blocking), gated=tuple(gated_this_round),\r\n367:                fix=fix, warnings=tuple(warnings), unchanged_streak=unchanged,\r\n368:            ))\r\n369:\r\n370:            if clean:\r\n371:                dissent = tuple(\r\n372:                    f for f in (review.findings if review else ())\r\n373:                    if f not in blocking\r\n374:                )\r\n375:                return self._result(\r\n376:                    ConvergenceOutcome.CONVERGED, rounds, ledger, dissent, loop_warnings, evidence_failures,\r\n377:                )\r\n378:            if fix is not None and fix.cannot_fix:\r\n379:                return self._result(\r\n380:                    ConvergenceOutcome.CANNOT_FIX, rounds, ledger, (), loop_warnings, evidence_failures,\r\n381:                )\r\n382:            if unchanged >= self.policy.max_unchanged_rounds:\r\n383:                return self._result(\r\n384:                    ConvergenceOutcome.STALEMATE, rounds, ledger, (), loop_warnings, evidence_failures,\r\n385:                )\r\n386:\r\n387:        return self._result(\r\n388:            ConvergenceOutcome.ROUNDS_EXHAUSTED, rounds, ledger, (), loop_warnings, evidence_failures,\r\n389:        )\r\n390:\r\n391:    @staticmethod\r\n392:    def _collect(fn: Callable[[], Any], label: str, warnings: list[str],\r\n393:                 failures: list[EvidenceFailure] | None = None) -> Any:\r\n394:        \"\"\"Evidence collection: a failing probe yields None + a warning,\r\n395:        never a fake value and never an aborted loop.\r\n396:\r\n397:        The *type* is kept alongside the message. A prose warning collapsed\r\n398:        an unreadable agent answer, a reviewer that edited the code, a\r\n399:        broken git probe and a crashed verifier into one indistinguishable\r\n400:        outcome — and the constitution requires INVALID_AGENT_OUTPUT to\r\n401:        stay distinct from disagreement (Codex review). The loop still\r\n402:        treats them identically, which is correct: no evidence was\r\n403:        collected either way. The caller can now tell them apart.\r\n404:        \"\"\"\r\n405:        try:\r\n406:            return fn()\r\n407:        except Exception as exc:  # noqa: BLE001 - probe failure is data, not control flow\r\n408:            warnings.append(f\"{label} collection failed: {exc}\")\r\n409:            if failures is not None:\r\n410:                failures.append(EvidenceFailure(\r\n411:                    stage=label, error_type=type(exc).__name__, message=str(exc)[:500],\r\n412:                ))\r\n413:            return None\r\n414:\r\n415:    @staticmethod\r\n416:    def _result(\r\n417:        outcome: ConvergenceOutcome,\r\n418:        rounds: list[RoundRecord],\r\n419:        ledger: list[GatedFinding],\r\n420:        dissent: tuple[Finding, ...],\r\n421:        warnings: list[str],\r\n422:        evidence_failures: list[EvidenceFailure] | None = None,\r\n423:    ) -> ConvergenceResult:\r\n424:        # Nothing-lost rule: the gate ledger rides on EVERY exit path, and\r\n425:        # so does the typed record of what could not be collected.\r\n426:        return ConvergenceResult(\r\n427:            outcome=outcome, rounds=tuple(rounds), gate_ledger=tuple(ledger),\r\n428:            dissent=dissent, warnings=tuple(warnings),\r\n429:            evidence_failures=tuple(evidence_failures or ()),\r\n430:        )\r\n1:\"\"\"Real reviewer and fixer adapters for `ConvergenceLoop` (adapter milestone 3/4).\r\n2:\r\n3:ADR-0008 built the convergence loop and injected `review_fn`/`fix_fn` as\r\n4:callables, with a note that the real adapters were future work. Nothing\r\n5:ever supplied them, so the loop only ever judged deterministic fakes.\r\n6:This is the wiring.\r\n7:\r\n8:Three things this module refuses to do, each because the constitution\r\n9:says so and the loop's value collapses without it:\r\n10:\r\n11:**A reviewer never modifies what it judges** (rule 9). The reviewer\r\n12:adapter launches its agent in a read-only posture and, crucially, does\r\n13:not *trust* that posture: it fingerprints the workspace before and after\r\n14:and raises if the tree moved. The permission flag is the provider's\r\n15:promise; the fingerprint is the kernel's evidence. The enforcement\r\n16:matrix records which is which.\r\n17:\r\n18:**An unreadable answer is not a verdict.** Parsing lives in\r\n19:`review_payload` and fails closed; see the reasoning there.\r\n20:\r\n21:**A fixer's DONE is a signal, not evidence** (ADR-0008 already encodes\r\n22:this: `claims_done` with an unchanged fingerprint is downgraded). The\r\n23:adapter reports what the agent said and never upgrades it.\r\n24:\"\"\"\r\n25:from __future__ import annotations\r\n26:\r\n27:import json\r\n28:from collections.abc import Callable, Sequence\r\n29:from pathlib import Path\r\n30:from typing import Any, Protocol\r\n31:\r\n32:from ..kernel.convergence import Finding, FixReport, FixRequest, ReviewReport\r\n33:from ..kernel.git_evidence import tamper_fingerprint\r\n34:from ..runner.capture import ExecutionResult\r\n35:from ..runner.claude_cli_runner import McpRunnerConfig\r\n36:from .review_payload import (\r\n37:    REVIEW_SCHEMA_INSTRUCTIONS,\r\n38:    InvalidReviewOutput,\r\n39:    extract_json_object,\r\n40:    parse_review_payload,\r\n41:)\r\n42:\r\n43:# A reviewer must not be able to edit the thing it judges. `plan` is the\r\n44:# Claude Code mode that withholds edit tools; it is a permission-layer\r\n45:# promise, not a sandbox, which is why CliReviewer fingerprints the tree\r\n46:# either side of the run and why the enforcement matrix records\r\n47:# `reviewer_read_only` as SANDBOX_APPROX rather than HARD.\r\n48:REVIEW_PERMISSION_MODE = \"plan\"\r\n49:FIX_PERMISSION_MODE = \"acceptEdits\"\r\n50:\r\n51:# An agent that dumps a build log to stdout must not turn a review round\r\n52:# into an unbounded read.\r\n53:MAX_AGENT_MESSAGE_CHARS = 2_000_000\r\n54:\r\n55:\r\n56:class ReviewerModifiedSubject(RuntimeError):\r\n57:    \"\"\"The reviewer changed the workspace it was judging (rule 9).\r\n58:\r\n59:    Treated as an evidence-collection failure by the loop: a round whose\r\n60:    reviewer edited the code produced no independent verdict, whatever it\r\n61:    printed.\"\"\"\r\n62:\r\n63:\r\n64:class AgentRunner(Protocol):\r\n65:    \"\"\"What both adapters need from a runner.\r\n66:\r\n67:    Deliberately narrower than `ClaudeCodeCLIRunner`: a `ReplayingCLIRunner`\r\n68:    (ADR-0014) satisfies it too, so a whole convergence loop can be\r\n69:    recorded and replayed.\"\"\"\r\n70:\r\n71:    def run(\r\n72:        self, prompt: str, cwd: Path, stdout_path: Path, stderr_path: Path,\r\n73:        timeout_s: float = ..., **kwargs: Any,\r\n74:    ) -> ExecutionResult: ...\r\n75:\r\n76:\r\n77:def agent_message_text(result: ExecutionResult) -> str:\r\n78:    \"\"\"The agent's own final message, from a Claude Code `--output-format json` run.\r\n79:\r\n80:    Falls back to the raw stdout when the envelope is missing or shaped\r\n81:    unexpectedly: a review is still readable from plain text, and\r\n82:    refusing to look would turn a provider's envelope change into a total\r\n83:    outage. What is NOT tolerated is inventing a verdict — that decision\r\n84:    belongs to the parser, which fails closed.\r\n85:    \"\"\"\r\n86:    payload = result.parsed_json\r\n87:    if isinstance(payload, dict):\r\n88:        for key in (\"result\", \"text\", \"content\", \"message\"):\r\n89:            value = payload.get(key)\r\n90:            if isinstance(value, str) and value.strip():\r\n91:                return value[:MAX_AGENT_MESSAGE_CHARS]\r\n92:    try:\r\n93:        with Path(result.stdout_path).open(\"r\", encoding=\"utf-8\", errors=\"replace\") as fh:\r\n94:            # Bounded: an agent that dumps a log to stdout must not be able\r\n95:            # to make the reviewer read a multi-gigabyte file into memory,\r\n96:            # and a review that does not fit in this much text is not a\r\n97:            # review this parser was going to find an answer in anyway.\r\n98:            return fh.read(MAX_AGENT_MESSAGE_CHARS)\r\n99:    except OSError:\r\n100:        return \"\"\r\n101:\r\n102:\r\n103:def build_review_prompt(\r\n104:    objective: str, round_index: int, focus: Sequence[str] | None = None,\r\n105:    verification_summary: str | None = None,\r\n106:) -> str:\r\n107:    parts = [\r\n108:        (\"You are an INDEPENDENT reviewer. Do not modify any file: you are \"\r\n109:         \"judging this work, not doing it.\"),\r\n110:        f\"Objective under review: {objective}\",\r\n111:        f\"Review round: {round_index}\",\r\n112:    ]\r\n113:    if verification_summary:\r\n114:        # The reviewer sees what the machine already proved, so it spends\r\n115:        # its round on what deterministic verification cannot answer.\r\n116:        parts.append(f\"Deterministic verification this round: {verification_summary}\")\r\n117:    if focus:\r\n118:        parts.append(\"Focus on: \" + \"; \".join(focus))\r\n119:    parts.append(\r\n120:        \"Judge correctness first, then security, then whether the change is \"\r\n121:        \"supported by evidence. Report only defects you can point at.\"\r\n122:    )\r\n123:    parts.append(REVIEW_SCHEMA_INSTRUCTIONS)\r\n124:    return \"\\n\\n\".join(parts)\r\n125:\r\n126:\r\n127:def build_fix_prompt(request: FixRequest, objective: str) -> str:\r\n128:    parts = [\r\n129:        (\"You are fixing defects an independent reviewer found. Change the \"\r\n130:         \"code; do not argue with the findings in prose.\"),\r\n131:        f\"Objective: {objective}\",\r\n132:        f\"Round: {request.round_index}\",\r\n133:    ]\r\n134:    if request.verification is not None and not request.verification.passed:\r\n135:        parts.append(\r\n136:            \"Deterministic verification is currently FAILING; that must end \"\r\n137:            \"up passing.\"\r\n138:        )\r\n139:    if request.blocking_findings:\r\n140:        parts.append(\"Blocking findings:\\n\" + \"\\n\".join(\r\n141:            _render_finding(index, finding)\r\n142:            for index, finding in enumerate(request.blocking_findings, start=1)\r\n143:        ))\r\n144:    parts.append(\r\n145:        \"When you are done, output a single JSON object in a ```json fenced \"\r\n146:        'block: {\"claims_done\": true|false, \"cannot_fix\": true|false, '\r\n147:        '\"notes\": \"<what you changed, or why you cannot>\"}. '\r\n148:        'Set \"cannot_fix\" only when the finding cannot be addressed here — '\r\n149:        \"it stops the loop, so it is not a way to end a hard round.\"\r\n150:    )\r\n151:    return \"\\n\\n\".join(parts)\r\n152:\r\n153:\r\n154:def _slug(identity: str) -> str:\r\n155:    \"\"\"A filename-safe form of an agent identity.\r\n156:\r\n157:    Identities carry `/` and `:` (`claude-cli`, `codex://reviewer-2`), and\r\n158:    a path built from one unsanitised would escape the evidence directory\r\n159:    or fail outright on Windows.\"\"\"\r\n160:    safe = \"\".join(ch if ch.isalnum() or ch in \"-_.\" else \"-\" for ch in identity)\r\n161:    return safe.strip(\"-\") or \"agent\"\r\n162:\r\n163:\r\n164:def _render_finding(index: int, finding: Finding) -> str:\r\n165:    location = f\" [{finding.file}]\" if finding.file else \"\"\r\n166:    return (\r\n167:        f\"{index}. ({finding.severity.value}/{finding.category}){location} \"\r\n168:        f\"{finding.description}\"\r\n169:        + (f\"\\n   evidence: {finding.evidence}\" if finding.evidence else \"\")\r\n170:    )\r\n171:\r\n172:\r\n173:class CliReviewer:\r\n174:    \"\"\"`review_fn` for `ConvergenceLoop`, backed by a real agent CLI.\"\"\"\r\n175:\r\n176:    def __init__(\r\n177:        self,\r\n178:        runner: AgentRunner,\r\n179:        repo_path: Path,\r\n180:        evidence_dir: Path,\r\n181:        objective: str,\r\n182:        reviewer_id: str = \"claude-cli\",\r\n183:        focus: Sequence[str] | None = None,\r\n184:        timeout_s: float = 900.0,\r\n185:        mcp: McpRunnerConfig | None = None,\r\n186:        fingerprint_fn: Callable[[Path], dict[str, Any]] | None = None,\r\n187:    ) -> None:\r\n188:        self.runner = runner\r\n189:        self.repo_path = repo_path\r\n190:        self.evidence_dir = evidence_dir\r\n191:        self.objective = objective\r\n192:        self.reviewer_id = reviewer_id\r\n193:        self.focus = tuple(focus or ())\r\n194:        self.timeout_s = timeout_s\r\n195:        self.mcp = mcp\r\n196:        self.fingerprint_fn = fingerprint_fn or tamper_fingerprint\r\n197:\r\n198:    def __call__(self, round_index: int) -> ReviewReport:\r\n199:        before = self.fingerprint_fn(self.repo_path)\r\n200:        stdout, stderr = self._evidence_paths(round_index)\r\n201:        result = self.runner.run(\r\n202:            prompt=build_review_prompt(self.objective, round_index, self.focus),\r\n203:            cwd=self.repo_path, stdout_path=stdout, stderr_path=stderr,\r\n204:            timeout_s=self.timeout_s, permission_mode=REVIEW_PERMISSION_MODE,\r\n205:            mcp=self.mcp,\r\n206:        )\r\n207:        # Checked BEFORE the output is parsed: a reviewer that edited the\r\n208:        # code has already violated rule 9, and reading its verdict first\r\n209:        # would mean deciding whether to care based on what it said.\r\n210:        after = self.fingerprint_fn(self.repo_path)\r\n211:        if after != before:\r\n212:            raise ReviewerModifiedSubject(\r\n213:                f\"reviewer {self.reviewer_id!r} changed the workspace it was \"\r\n214:                f\"judging in round {round_index}: {before} -> {after}\"\r\n215:            )\r\n216:        if result.timed_out or result.cancelled:\r\n217:            raise InvalidReviewOutput(\r\n218:                f\"reviewer {self.reviewer_id!r} did not finish round {round_index} \"\r\n219:                f\"(timed_out={result.timed_out}, cancelled={result.cancelled})\"\r\n220:            )\r\n221:        return parse_review_payload(agent_message_text(result), reviewer=self.reviewer_id)\r\n222:\r\n223:    def _evidence_paths(self, round_index: int) -> tuple[Path, Path]:\r\n224:        # The reviewer identity is in the filename, not just the round.\r\n225:        # Two loops sharing an evidence directory both wrote `review-1.*`\r\n226:        # and destroyed each other's evidence, which also made replay\r\n227:        # attribution unreliable (Codex review).\r\n228:        self.evidence_dir.mkdir(parents=True, exist_ok=True)\r\n229:        stem = f\"review-{_slug(self.reviewer_id)}-{round_index}\"\r\n230:        return (self.evidence_dir / f\"{stem}.stdout\",\r\n231:                self.evidence_dir / f\"{stem}.stderr\")\r\n232:\r\n233:\r\n234:class CliFixer:\r\n235:    \"\"\"`fix_fn` for `ConvergenceLoop`, backed by a real agent CLI.\"\"\"\r\n236:\r\n237:    def __init__(\r\n238:        self,\r\n239:        runner: AgentRunner,\r\n240:        repo_path: Path,\r\n241:        evidence_dir: Path,\r\n242:        objective: str,\r\n243:        fixer_id: str = \"claude-cli\",\r\n244:        timeout_s: float = 1800.0,\r\n245:        mcp: McpRunnerConfig | None = None,\r\n246:    ) -> None:\r\n247:        self.runner = runner\r\n248:        self.repo_path = repo_path\r\n249:        self.evidence_dir = evidence_dir\r\n250:        self.objective = objective\r\n251:        self.fixer_id = fixer_id\r\n252:        self.timeout_s = timeout_s\r\n253:        self.mcp = mcp\r\n254:\r\n255:    def __call__(self, request: FixRequest) -> FixReport:\r\n256:        self.evidence_dir.mkdir(parents=True, exist_ok=True)\r\n257:        stem = f\"fix-{_slug(self.fixer_id)}-{request.round_index}\"\r\n258:        stdout = self.evidence_dir / f\"{stem}.stdout\"\r\n259:        stderr = self.evidence_dir / f\"{stem}.stderr\"\r\n260:        result = self.runner.run(\r\n261:            prompt=build_fix_prompt(request, self.objective),\r\n262:            cwd=self.repo_path, stdout_path=stdout, stderr_path=stderr,\r\n263:            timeout_s=self.timeout_s, permission_mode=FIX_PERMISSION_MODE,\r\n264:            mcp=self.mcp,\r\n265:        )\r\n266:        return self._parse(result, request.round_index)\r\n267:\r\n268:    def _parse(self, result: ExecutionResult, round_index: int) -> FixReport:\r\n269:        \"\"\"A fixer's report, read conservatively.\r\n270:\r\n271:        Unlike a review, an unreadable fix report is NOT fatal: the fixer\r\n272:        may well have changed the repository, and the next round's\r\n273:        verification and review are what decide anyway. The conservative\r\n274:        reading is \"it ran, it claims nothing\" — which costs one more\r\n275:        round and cannot fake progress. Claiming `cannot_fix` on\r\n276:        unreadable output would end the loop on no evidence at all.\r\n277:        \"\"\"\r\n278:        if result.timed_out or result.cancelled:\r\n279:            return FixReport(\r\n280:                claims_done=False, cannot_fix=False,\r\n281:                notes=f\"fixer {self.fixer_id!r} round {round_index} did not finish \"\r\n282:                      f\"(timed_out={result.timed_out}, cancelled={result.cancelled})\",\r\n283:            )\r\n284:        text = agent_message_text(result)\r\n285:        try:\r\n286:            payload = extract_json_object(text)\r\n287:        except InvalidReviewOutput:\r\n288:            return FixReport(\r\n289:                claims_done=False, cannot_fix=False,\r\n290:                notes=f\"fixer {self.fixer_id!r} round {round_index}: no structured \"\r\n291:                      f\"report found; treating the round as inconclusive\",\r\n292:            )\r\n293:        notes = payload.get(\"notes\", \"\")\r\n294:        return FixReport(\r\n295:            # `is True` on purpose: a truthy string or a non-empty list is\r\n296:            # not a claim of doneness, and coercing one into `True` would\r\n297:            # invent the signal the loop weighs.\r\n298:            claims_done=payload.get(\"claims_done\") is True,\r\n299:            cannot_fix=payload.get(\"cannot_fix\") is True,\r\n300:            notes=notes if isinstance(notes, str) else json.dumps(notes, sort_keys=True),\r\n301:        )\r\n1:\"\"\"The hold/park plane under a real scheduler (adapter milestone 4/4).\r\n2:\r\n3:ADR-0012 built credential-scoped rate-limit holds, recovery-as-reconcile\r\n4:and `boot_sweep`, and said plainly that none of it had a production\r\n5:caller. This is that caller — the last of the four mechanisms Directive\r\n6:9's review found were parallel fictions.\r\n7:\r\n8:The scheduler is deliberately small. It is not a queue, a worker pool or\r\n9:a priority system; those are the multi-worker milestone. It is the three\r\n10:places where the hold plane has to be consulted for it to be real:\r\n11:\r\n12:1. **Before a launch**, ask whether the credential is admitted. A task\r\n13:   refused by a hold is PARKED — recorded, resumable, not failed, and\r\n14:   never counted against agent quality (rules 6 and 7).\r\n15:2. **After a run parks**, place a durable hold, so the next launch (in\r\n16:   this process or a later one) sees it. A hold that lives only in memory\r\n17:   is a hold the restart forgets, which is how one rate limit becomes a\r\n18:   stampede.\r\n19:3. **At boot**, sweep runs left stranded by a crash, so no record is left\r\n20:   neither progressing nor terminal.\r\n21:\r\n22:Durability is a JSONL of hold rows. The registry is rebuilt from them on\r\n23:every pump, never mutated in place: `reconcile` is a rebuild, so a double\r\n24:pump, a concurrent scheduler and a restart all land in the same state.\r\n25:\"\"\"\r\n26:from __future__ import annotations\r\n27:\r\n28:import json\r\n29:import os\r\n30:import time\r\n31:from collections.abc import Callable, Iterable, Sequence\r\n32:from dataclasses import dataclass\r\n33:from datetime import UTC, datetime\r\n34:from pathlib import Path\r\n35:from typing import Any\r\n36:\r\n37:from ..runner.liveness import ProcessFingerprint, is_alive\r\n38:from .engine import TaskEngine, TaskExecutionOutcome\r\n39:from .failures import (\r\n40:    Disposition,\r\n41:    FailureClass,\r\n42:    FailureClassification,\r\n43:    HoldRegistry,\r\n44:    HoldScope,\r\n45:    RateLimitHold,\r\n46:    StrandedRun,\r\n47:    SweepOutcome,\r\n48:    boot_sweep,\r\n49:    hold_from_classification,\r\n50:)\r\n51:from .file_lock import FileLock, lock_path_for\r\n52:from .run_store import RunStore\r\n53:from .state_machine import RunState\r\n54:\r\n55:PARK_REASON = \"rate_limited:credential_on_hold\"\r\n56:\r\n57:\r\n58:def _require_supersede_fields(payload: dict[str, Any]) -> str:\r\n59:    \"\"\"A control row that reopens a credential must be complete.\r\n60:\r\n61:    `at` and `reason` were optional, so a half-specified row still erased\r\n62:    every hold on a credential (Codex review). An incomplete decision is\r\n63:    damage, and damage denies.\"\"\"\r\n64:    credential = payload.get(\"credential\")\r\n65:    if not isinstance(credential, str) or not credential:\r\n66:        # ValueError throughout: a malformed durable row is corrupt data,\r\n67:        # not a caller type error, and `read()` catches ValueError to\r\n68:        # report damage (which denies).\r\n69:        raise ValueError(\"supersede without a credential\")\r\n70:    reason = payload.get(\"reason\")\r\n71:    if not isinstance(reason, str) or not reason:\r\n72:        raise ValueError(\"supersede without a reason\")\r\n73:    at = payload.get(\"at\")\r\n74:    if isinstance(at, bool) or not isinstance(at, (int, float)):\r\n75:        raise ValueError(\"supersede without a timestamp\")  # noqa: TRY004\r\n76:    return credential\r\n77:\r\n78:\r\n79:@dataclass(frozen=True)\r\n80:class HoldSnapshot:\r\n81:    \"\"\"What the durable log says, and what it could not say.\r\n82:\r\n83:    `damaged` is load-bearing: a hold plane that cannot read its own\r\n84:    records must not report \"no holds\".\"\"\"\r\n85:\r\n86:    holds: tuple[RateLimitHold, ...]\r\n87:    damaged: tuple[str, ...]\r\n88:\r\n89:\r\n90:class HoldStore:\r\n91:    \"\"\"Append-only durable holds. One JSONL file, one lock.\r\n92:\r\n93:    Append-only rather than a mutable table on purpose: a hold is a fact\r\n94:    about a moment (\"this credential was shut at T, reopening at R\"), and\r\n95:    facts are not edited. Expiry is computed at read time by `reconcile`,\r\n96:    which means a stale row is inert rather than wrong.\r\n97:    \"\"\"\r\n98:\r\n99:    def __init__(self, path: Path, lock_timeout_s: float = 30.0) -> None:\r\n100:        self.path = path\r\n101:        self._lock_timeout_s = lock_timeout_s\r\n102:        self.path.parent.mkdir(parents=True, exist_ok=True)\r\n103:\r\n104:    def place(self, hold: RateLimitHold) -> RateLimitHold:\r\n105:        self._append([{\"row\": \"hold\", **hold.to_dict()}])\r\n106:        return hold\r\n107:\r\n108:    def narrow(self, credential: str, at: float, reason: str,\r\n109:               replacement: RateLimitHold) -> RateLimitHold:\r\n110:        \"\"\"Supersede and replace as ONE row.\r\n111:\r\n112:        Two rows in one append is not enough: a crash can flush the first\r\n113:        line and not the second, leaving a supersede with nothing\r\n114:        replacing it — a credential wide open, durably. One row makes a\r\n115:        torn write unparseable instead, which `read()` reports as damage\r\n116:        and the scheduler denies on. The atomic unit here is the LINE, so\r\n117:        an atomic transition has to be a line (Codex review, caught by a\r\n118:        test that walked every prefix of the log).\r\n119:        \"\"\"\r\n120:        self._append([{\r\n121:            \"row\": \"narrow\", \"credential\": credential, \"at\": at,\r\n122:            \"reason\": reason, \"hold\": replacement.to_dict(),\r\n123:        }])\r\n124:        return replacement\r\n125:\r\n126:    def supersede(self, credential: str, at: float, reason: str) -> None:\r\n127:        \"\"\"Draw a line: earlier rows for this credential no longer apply.\r\n128:\r\n129:        `reconcile` deliberately keeps the MOST RESTRICTIVE competing\r\n130:        hold, so two observations of a shut window can never relax each\r\n131:        other by arriving in the wrong order. But that also means an\r\n132:        appended row can never NARROW an existing hold — which made\r\n133:        `probe()` dead code, since a PROBE row simply lost to the ACCOUNT\r\n134:        row it was meant to replace. Its own test caught it.\r\n135:\r\n136:        So observations and decisions are different rows. An observation\r\n137:        competes; a decision supersedes. Both are durable and both name a\r\n138:        reason, which is the property that matters: a window is never\r\n139:        reopened silently, only by a recorded act.\r\n140:        \"\"\"\r\n141:        self._append([{\"row\": \"supersede\", \"credential\": credential,\r\n142:                       \"at\": at, \"reason\": reason}])\r\n143:\r\n144:    def _append(self, payloads: list[dict[str, Any]]) -> None:\r\n145:        with (\r\n146:            FileLock(lock_path_for(self.path), timeout_s=self._lock_timeout_s),\r\n147:            self.path.open(\"a\", encoding=\"utf-8\") as fh,\r\n148:        ):\r\n149:            for payload in payloads:\r\n150:                fh.write(json.dumps(payload, sort_keys=True) + \"\\n\")\r\n151:            fh.flush()\r\n152:            os.fsync(fh.fileno())\r\n153:\r\n154:    def read(self) -> HoldSnapshot:\r\n155:        \"\"\"Live holds, plus whether anything was unreadable.\r\n156:\r\n157:        **Damage is not \"no hold\".** The first version skipped unreadable\r\n158:        rows and returned the rest, reasoning that refusing everything\r\n159:        would open every window at once. That was backwards: skipping the\r\n160:        row ALSO opens the window it described, and if the damaged row was\r\n161:        the only hold on a credential, a truncated line silently admitted\r\n162:        work against a shut one (Codex review). A safety mechanism has to\r\n163:        fail in the shut direction, so damage is reported and the caller\r\n164:        denies.\r\n165:\r\n166:        Reading happens under the writer's lock: without it a reader can\r\n167:        observe a half-written row and treat a hold that IS being placed\r\n168:        as absent.\r\n169:        \"\"\"\r\n170:        if not self.path.exists():\r\n171:            # Never written to. Distinct from damaged: there is nothing to\r\n172:            # fail closed about.\r\n173:            return HoldSnapshot(holds=(), damaged=())\r\n174:\r\n175:        with FileLock(lock_path_for(self.path), timeout_s=self._lock_timeout_s):\r\n176:            text = self.path.read_text(encoding=\"utf-8\")\r\n177:\r\n178:        holds: list[RateLimitHold] = []\r\n179:        damaged: list[str] = []\r\n180:        for number, line in enumerate(text.splitlines(), start=1):\r\n181:            line = line.strip()\r\n182:            if not line:\r\n183:                continue\r\n184:            try:\r\n185:                payload = json.loads(line)\r\n186:                if payload.get(\"row\") == \"narrow\":\r\n187:                    # Supersede and replace, indivisibly.\r\n188:                    credential = _require_supersede_fields(payload)\r\n189:                    holds = [h for h in holds if h.credential != credential]\r\n190:                    holds.append(RateLimitHold.from_dict(payload[\"hold\"]))\r\n191:                    continue\r\n192:                if payload.get(\"row\") == \"supersede\":\r\n193:                    credential = _require_supersede_fields(payload)\r\n194:                    holds = [h for h in holds if h.credential != credential]\r\n195:                    continue\r\n196:                holds.append(RateLimitHold.from_dict(payload))\r\n197:            except (json.JSONDecodeError, KeyError, ValueError, TypeError) as exc:\r\n198:                damaged.append(f\"line {number}: {type(exc).__name__}: {exc}\")\r\n199:        return HoldSnapshot(holds=tuple(holds), damaged=tuple(damaged))\r\n200:\r\n201:    def records(self) -> list[RateLimitHold]:\r\n202:        \"\"\"Live holds only. Prefer `read()`, which also reports damage.\"\"\"\r\n203:        return list(self.read().holds)\r\n204:\r\n205:\r\n206:@dataclass(frozen=True)\r\n207:class ScheduleOutcome:\r\n208:    \"\"\"What the scheduler did with one submission.\"\"\"\r\n209:\r\n210:    task_id: str\r\n211:    launched: bool\r\n212:    reason_code: str\r\n213:    execution: TaskExecutionOutcome | None = None\r\n214:    hold: RateLimitHold | None = None\r\n215:\r\n216:    @property\r\n217:    def parked(self) -> bool:\r\n218:        return not self.launched\r\n219:\r\n220:    def to_dict(self) -> dict[str, Any]:\r\n221:        return {\r\n222:            \"task_id\": self.task_id, \"launched\": self.launched,\r\n223:            \"reason_code\": self.reason_code,\r\n224:            \"hold\": self.hold.to_dict() if self.hold else None,\r\n225:        }\r\n226:\r\n227:\r\n228:class TaskScheduler:\r\n229:    \"\"\"Launches tasks only when the credential's window is open.\"\"\"\r\n230:\r\n231:    def __init__(\r\n232:        self,\r\n233:        engine: TaskEngine,\r\n234:        run_store: RunStore,\r\n235:        holds: HoldStore,\r\n236:        credential: str,\r\n237:        scheduler_id: str = \"scheduler-1\",\r\n238:        # WALL CLOCK, not monotonic. `reset_at` on a durable hold is an\r\n239:        # epoch timestamp the provider supplied, and a monotonic reading\r\n240:        # is neither comparable to it nor meaningful across the restart\r\n241:        # these rows are written to survive: mixing them makes every\r\n242:        # durable hold look permanently unexpired.\r\n243:        clock: Callable[[], float] = time.time,\r\n244:        stale_after_s: float = 120.0,\r\n245:    ) -> None:\r\n246:        self.engine = engine\r\n247:        self.run_store = run_store\r\n248:        self.holds = holds\r\n249:        self.credential = credential\r\n250:        self.scheduler_id = scheduler_id\r\n251:        self.clock = clock\r\n252:        self.stale_after_s = stale_after_s\r\n253:        self.registry = HoldRegistry()\r\n254:\r\n255:    # -- the hold plane ---------------------------------------------------\r\n256:\r\n257:    def live_holds(self) -> list[RateLimitHold]:\r\n258:        \"\"\"Rebuild from durable rows. Idempotent by construction.\"\"\"\r\n259:        return self.registry.reconcile(self.holds.read().holds, self.clock())\r\n260:\r\n261:    def admits(self, *, is_resume: bool = False, probe_run_id: str | None = None) -> bool:\r\n262:        \"\"\"May work start on this credential right now?\r\n263:\r\n264:        `probe_run_id` names the RUN being admitted, not the process\r\n265:        asking. Passing the scheduler's own id meant a PROBE hold admitted\r\n266:        any submission from any scheduler sharing that id — the stampede a\r\n267:        probe exists to prevent, hidden by a test whose scheduler id and\r\n268:        probe id happened to be the same string (Codex review).\r\n269:        \"\"\"\r\n270:        snapshot = self.holds.read()\r\n271:        if snapshot.damaged:\r\n272:            # Unreadable rows are not \"no holds\". Deny until an operator\r\n273:            # looks: a safety mechanism fails in the shut direction.\r\n274:            return False\r\n275:        self.registry.reconcile(snapshot.holds, self.clock())\r\n276:        return self.registry.admits(\r\n277:            self.credential, self.clock(), is_resume=is_resume,\r\n278:            runner_id=probe_run_id,\r\n279:        )\r\n280:\r\n281:    def submit(self, *, is_resume: bool = False, probe_run_id: str | None = None,\r\n282:               **task_kwargs: Any) -> ScheduleOutcome:\r\n283:        \"\"\"Run one task, unless the credential is held.\r\n284:\r\n285:        A refusal here is a PARK, not a failure: the work is untouched and\r\n286:        resumable, and rule 7 forbids charging the agent for a window\r\n287:        somebody else's traffic closed.\r\n288:        \"\"\"\r\n289:        task_id = str(task_kwargs.get(\"task_id\", \"<unknown>\"))\r\n290:        if not self.admits(is_resume=is_resume, probe_run_id=probe_run_id):\r\n291:            held = self.registry.hold_for(self.credential)\r\n292:            return ScheduleOutcome(\r\n293:                task_id=task_id, launched=False, reason_code=PARK_REASON, hold=held,\r\n294:            )\r\n295:\r\n296:        # Re-check immediately before the launch. Another scheduler can\r\n297:        # place a hold between the decision and the child, and this shrinks\r\n298:        # that window from \"however long setup takes\" to microseconds — the\r\n299:        # same pattern the engine's ownership guard uses. It does NOT close\r\n300:        # the window: a check-then-act without a reservation cannot, and\r\n301:        # the ADR says so rather than implying otherwise.\r\n302:        if not self.admits(is_resume=is_resume, probe_run_id=probe_run_id):\r\n303:            return ScheduleOutcome(\r\n304:                task_id=task_id, launched=False, reason_code=PARK_REASON,\r\n305:                hold=self.registry.hold_for(self.credential),\r\n306:            )\r\n307:\r\n308:        outcome = self.engine.execute_task(**task_kwargs)\r\n309:        hold = self._maybe_place_hold(outcome)\r\n310:        return ScheduleOutcome(\r\n311:            task_id=task_id, launched=True,\r\n312:            reason_code=(outcome.classification.reason_code\r\n313:                         if outcome.classification else \"no_classification\"),\r\n314:            execution=outcome, hold=hold,\r\n315:        )\r\n316:\r\n317:    def observe(self, classification: FailureClassification | None) -> RateLimitHold | None:\r\n318:        \"\"\"Record what one launch's classification implies for the window.\r\n319:\r\n320:        Public because the implementation is not the only thing that\r\n321:        launches an agent: a convergence round's reviewer and fixer hit\r\n322:        the same credential, and a rate limit there used to be invisible\r\n323:        to the hold plane — it surfaced as unreadable agent output, no\r\n324:        hold was placed, and the next round launched straight into the\r\n325:        same shut window. Rule 6 says that is a park, not agent output.\r\n326:        \"\"\"\r\n327:        if classification is None or classification.failure is not FailureClass.RATE_LIMITED:\r\n328:            # Every other failure is about the work, not the window.\r\n329:            # Holding a credential because a test failed would take the\r\n330:            # whole system down for a bug.\r\n331:            return None\r\n332:        hold = hold_from_classification(\r\n333:            classification, self.credential, self.clock(), scope=HoldScope.ACCOUNT,\r\n334:        )\r\n335:        if hold is None:\r\n336:            return None\r\n337:        return self.holds.place(hold)\r\n338:\r\n339:    def probe(self, run_id: str) -> RateLimitHold:\r\n340:        \"\"\"Narrow an ACCOUNT hold to a single probing run.\r\n341:\r\n342:        The named run is the ONLY one admitted while this stands. An\r\n343:        unattributed probe would admit every queued resume at once, which\r\n344:        is the stampede a probe exists to prevent (ADR-0012).\r\n345:        \"\"\"\r\n346:        self.live_holds()\r\n347:        current = self.registry.hold_for(self.credential)\r\n348:        reason = current.reason_code if current else \"rate_limited:probe\"\r\n349:        reset_at = current.reset_at if current else None\r\n350:        # Narrowing is a DECISION, not an observation: without drawing the\r\n351:        # line first, the broader ACCOUNT hold simply outranks this row and\r\n352:        # the probe never takes effect. Both rows go down in ONE append, so\r\n353:        # a crash between them cannot leave the credential wide open.\r\n354:        return self.holds.narrow(\r\n355:            self.credential, self.clock(), reason=f\"probe:{run_id}\",\r\n356:            replacement=RateLimitHold(\r\n357:                credential=self.credential, scope=HoldScope.PROBE,\r\n358:                reason_code=reason, reset_at=reset_at, placed_at=self.clock(),\r\n359:                probe_holder=run_id,\r\n360:                window_estimated=current.window_estimated if current else False,\r\n361:            ),\r\n362:        )\r\n363:\r\n364:    # -- recovery ---------------------------------------------------------\r\n365:\r\n366:    def boot(self, classify: Callable[[str], FailureClassification | None] | None = None,\r\n367:             ) -> list[SweepOutcome]:\r\n368:        \"\"\"Give every stranded run a disposition, then act on it.\r\n369:\r\n370:        The sweep itself is pure (ADR-0012); this is the half that writes.\r\n371:        A run the sweep failed is marked FAILED durably, because a record\r\n372:        that is neither progressing nor terminal is the ghost the whole\r\n373:        mechanism exists to prevent. A run it re-adopted is left in place\r\n374:        for the normal path to pick up — the sweep decides nothing\r\n375:        special.\r\n376:        \"\"\"\r\n377:        outcomes = boot_sweep(self._stranded(classify), stale_after_s=self.stale_after_s)\r\n378:        for outcome in outcomes:\r\n379:            if outcome.disposition is Disposition.FAILED:\r\n380:                try:\r\n381:                    self.run_store.update_state(outcome.run.run_id, RunState.CRASHED)\r\n382:                except (FileNotFoundError, ValueError):\r\n383:                    # A run that vanished or refuses the transition is not\r\n384:                    # a reason to abandon the rest of the sweep: the point\r\n385:                    # is that EVERY run gets a disposition.\r\n386:                    continue\r\n387:        return outcomes\r\n388:\r\n389:    def _stranded(self, classify: Callable[[str], FailureClassification | None] | None,\r\n390:                  ) -> list[StrandedRun]:\r\n391:        runs: list[StrandedRun] = []\r\n392:        for run_id in self.run_store.list_run_ids():\r\n393:            try:\r\n394:                meta = self.run_store.read_meta(run_id)\r\n395:            except (FileNotFoundError, ValueError):\r\n396:                continue\r\n397:            alive, stale_s = self._liveness(run_id)\r\n398:            runs.append(StrandedRun(\r\n399:                run_id=run_id, task_id=meta.task_id, state=meta.state,\r\n400:                process_alive=alive, heartbeat_stale_s=stale_s,\r\n401:                classification=classify(run_id) if classify else None,\r\n402:            ))\r\n403:        return runs\r\n404:\r\n405:    def _liveness(self, run_id: str) -> tuple[bool | None, float | None]:\r\n406:        \"\"\"Is the process that owned this run still there, and how stale?\r\n407:\r\n408:        `None` for alive means \"unknown\", which the sweep treats as not\r\n409:        demonstrably alive. Claiming a dead process is alive would strand\r\n410:        the run forever; the opposite merely re-adopts work.\r\n411:        \"\"\"\r\n412:        try:\r\n413:            beat = self.run_store.read_heartbeat(run_id)\r\n414:        except Exception:  # noqa: BLE001 - one bad file must not end the sweep\r\n415:            # `read_heartbeat` json.loads an arbitrary file. A single\r\n416:            # truncated heartbeat aborted the ENTIRE boot sweep, leaving\r\n417:            # every later run with no disposition — the ghost the sweep\r\n418:            # exists to prevent, caused by the sweep (Codex review).\r\n419:            return None, None\r\n420:        if not isinstance(beat, dict) or not beat:\r\n421:            return None, None\r\n422:        alive: bool | None = None\r\n423:        if beat.get(\"start_time\") is None:\r\n424:            # `is_alive` answers \"a process with this PID exists\", which on\r\n425:            # a recycled PID is a different process wearing a dead run's\r\n426:            # identity. Without a start time there is nothing to tell them\r\n427:            # apart, so the honest answer is \"unknown\" — which the sweep\r\n428:            # treats as not demonstrably alive and re-adopts, rather than\r\n429:            # stranding the run forever on a coincidence.\r\n430:            alive = None\r\n431:        else:\r\n432:            try:\r\n433:                alive = is_alive(ProcessFingerprint.from_dict(beat))\r\n434:            except (TypeError, ValueError, KeyError):\r\n435:                alive = None\r\n436:        stale_s: float | None = None\r\n437:        recorded = beat.get(\"ts\")\r\n438:        if isinstance(recorded, str):\r\n439:            try:\r\n440:                written = datetime.fromisoformat(recorded)\r\n441:            except ValueError:\r\n442:                written = None\r\n443:            if written is not None:\r\n444:                if written.tzinfo is None:\r\n445:                    written = written.replace(tzinfo=UTC)\r\n446:                age = (datetime.now(UTC) - written).total_seconds()\r\n447:                # A heartbeat from the FUTURE is clock skew or a bad\r\n448:                # record, not freshness. Clamping it to zero made a dead\r\n449:                # run look like it had just checked in and stranded it;\r\n450:                # reporting it as unknown lets the sweep re-adopt, which\r\n451:                # only costs re-running work (Codex review).\r\n452:                stale_s = age if age >= 0 else None\r\n453:        return alive, stale_s\r\n454:\r\n455:\r\n456:def holds_summary(holds: Iterable[RateLimitHold]) -> Sequence[dict[str, Any]]:\r\n457:    \"\"\"Operator-facing view: what is shut, until when, and how sure we are.\"\"\"\r\n458:    return [\r\n459:        {\r\n460:            **hold.to_dict(),\r\n461:            # Surfaced explicitly: an estimated window is the kernel's\r\n462:            # bounded guess, not something the provider said, and an\r\n463:            # operator deciding whether to wait needs to know which.\r\n464:            \"window_source\": \"estimated\" if hold.window_estimated else \"provider\",\r\n465:        }\r\n466:        for hold in sorted(holds, key=lambda h: (h.credential, h.scope.value))\r\n467:    ]\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content src/gnosis/runner/gated_runner.py; Get-Content src/gnosis/adapters/cli_review.py; Get-Content src/gnosis/kernel/convergence.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content src/gnosis/runner/gated_runner.py; Get-Content src/gnosis/adapters/cli_review.py; Get-Content src/gnosis/kernel/convergence.py'","aggregated_output":"\"\"\"Every agent launch passes the gate, not just the first one.\r\n\r\nADR-0013 wired the policy gate into `TaskEngine.execute_task`, which\r\ncovers the launch that implements a task. A convergence loop then\r\nlaunches a reviewer and a fixer once per round â€” potentially many more\r\nagents than the task itself â€” and none of those went past a gate or a\r\nrate-limit hold. The gate was real and its coverage was partial, which\r\nis a worse position than it sounds: it reads as governed.\r\n\r\n`GatedAgentRunner` duck-types a CLI runner and consults, before each\r\nlaunch:\r\n\r\n1. the **hold plane**, so a shut credential parks the round instead of\r\n   burning it (rule 6), and\r\n2. the **policy engine**, at the same `before_agent_run` intervention\r\n   point and with the same snapshot shape the engine uses â€” so an\r\n   operator approving an action approves one identity, not two.\r\n\r\nA refusal raises. It does not return a fake result, because the caller's\r\ncontract is \"here is what the agent said\" and inventing that is the one\r\nthing the whole review apparatus exists to prevent.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom collections.abc import Callable, Sequence\r\nfrom pathlib import Path\r\nfrom typing import Any, Protocol\r\n\r\nfrom ..kernel.engine import DEFAULT_PERMISSION_MODE, agent_launch_snapshot\r\nfrom ..kernel.policy import (\r\n    ApprovalStore,\r\n    PolicyDecision,\r\n    PolicyEngine,\r\n    Verdict,\r\n    resolve_escalation,\r\n)\r\nfrom .capture import ExecutionResult\r\nfrom .claude_cli_runner import DEFAULT_TIMEOUT_S, McpRunnerConfig\r\n\r\n\r\nclass LaunchRefused(RuntimeError):\r\n    \"\"\"Policy refused this agent launch.\r\n\r\n    Carries the decision so the caller records the policy's own reason\r\n    code rather than paraphrasing it.\"\"\"\r\n\r\n    def __init__(self, decision: PolicyDecision) -> None:\r\n        super().__init__(f\"policy refused this launch: {decision.reason}\")\r\n        self.decision = decision\r\n\r\n\r\nclass CredentialHeld(RuntimeError):\r\n    \"\"\"The credential is rate-limit held, so no launch may happen.\r\n\r\n    A park, not a failure: rule 6 says a shut window is not the agent\r\n    misbehaving and rule 7 forbids charging it to agent quality.\"\"\"\r\n\r\n\r\nclass HoldGate(Protocol):\r\n    \"\"\"The slice of the scheduler this needs: may work start right now?\"\"\"\r\n\r\n    def admits(self, *, is_resume: bool = ..., probe_run_id: str | None = ...) -> bool: ...\r\n\r\n\r\nclass GatedAgentRunner:\r\n    \"\"\"Wraps a runner so every launch is gated and recorded.\r\n\r\n    Composable with `ReplayingCLIRunner` in either order; putting the\r\n    cassette *inside* is the useful arrangement, since a replayed launch\r\n    is still a launch an operator may want to have authorised.\r\n    \"\"\"\r\n\r\n    def __init__(\r\n        self,\r\n        inner: Any,\r\n        policy: PolicyEngine,\r\n        exec_root: Path,\r\n        stage: str,\r\n        task_id: str,\r\n        approvals: ApprovalStore | None = None,\r\n        policy_actor: str = \"agent://unattributed\",\r\n        holds: HoldGate | None = None,\r\n        worktree_branch: str | None = None,\r\n        on_decision: Callable[[str, PolicyDecision], None] | None = None,\r\n    ) -> None:\r\n        self.inner = inner\r\n        self.policy = policy\r\n        self.exec_root = exec_root\r\n        self.stage = stage\r\n        self.task_id = task_id\r\n        self.approvals = approvals\r\n        self.policy_actor = policy_actor\r\n        self.holds = holds\r\n        self.worktree_branch = worktree_branch\r\n        # Every verdict is handed to the caller to record. An allowed\r\n        # launch is evidence too, not just a refused one.\r\n        self.on_decision = on_decision\r\n        self.decisions: list[tuple[str, PolicyDecision]] = []\r\n\r\n    @property\r\n    def binary(self) -> str:\r\n        \"\"\"Pass through, so the gate sees the program that really runs.\r\n\r\n        ADR-0014 learned this the hard way: a wrapper without `.binary`\r\n        reported `<unknown-runner>`, silently changing the action identity\r\n        an approval is bound to.\"\"\"\r\n        inner_binary = getattr(self.inner, \"binary\", None)\r\n        return inner_binary if isinstance(inner_binary, str) and inner_binary else \"<unknown-runner>\"\r\n\r\n    def run(\r\n        self,\r\n        prompt: str,\r\n        cwd: Path,\r\n        stdout_path: Path,\r\n        stderr_path: Path,\r\n        timeout_s: float = DEFAULT_TIMEOUT_S,\r\n        permission_mode: str = DEFAULT_PERMISSION_MODE,\r\n        mcp: McpRunnerConfig | None = None,\r\n        model: str | None = None,\r\n        extra_args: Sequence[str] | None = None,\r\n        **kwargs: Any,\r\n    ) -> ExecutionResult:\r\n        if self.holds is not None and not self.holds.admits():\r\n            # Checked BEFORE the policy question: spending a verdict on an\r\n            # action that cannot run anyway is noise in the audit trail,\r\n            # and a park is not a policy event.\r\n            raise CredentialHeld(\r\n                f\"credential is held; {self.stage} for task {self.task_id} is parked\"\r\n            )\r\n\r\n        snapshot = agent_launch_snapshot(\r\n            stage=self.stage, task_id=self.task_id, prompt=prompt,\r\n            binary=self.binary, exec_root=cwd, planned_root=cwd, mcp=mcp,\r\n            worktree_branch=self.worktree_branch, policy_actor=self.policy_actor,\r\n            permission_mode=permission_mode, model=model,\r\n        )\r\n        decision = self.policy.decide(snapshot)\r\n        if self.approvals is not None:\r\n            decision = resolve_escalation(decision, snapshot, self.approvals)\r\n        self.decisions.append((self.stage, decision))\r\n        if self.on_decision is not None:\r\n            self.on_decision(self.stage, decision)\r\n        if decision.verdict not in (Verdict.ALLOW, Verdict.WARN):\r\n            # No child is launched. TRANSFORM is refused here for the same\r\n            # reason ADR-0013 refuses it in the engine: this point cannot\r\n            # rewrite an agent invocation, and silently dropping a\r\n            # mitigation it cannot apply is worse than stopping.\r\n            raise LaunchRefused(decision)\r\n\r\n        result: ExecutionResult = self.inner.run(\r\n            prompt=prompt, cwd=cwd, stdout_path=stdout_path,\r\n            stderr_path=stderr_path, timeout_s=timeout_s,\r\n            permission_mode=permission_mode, mcp=mcp, model=model,\r\n            extra_args=extra_args, **kwargs,\r\n        )\r\n        return result\r\n\"\"\"Real reviewer and fixer adapters for `ConvergenceLoop` (adapter milestone 3/4).\r\n\r\nADR-0008 built the convergence loop and injected `review_fn`/`fix_fn` as\r\ncallables, with a note that the real adapters were future work. Nothing\r\never supplied them, so the loop only ever judged deterministic fakes.\r\nThis is the wiring.\r\n\r\nThree things this module refuses to do, each because the constitution\r\nsays so and the loop's value collapses without it:\r\n\r\n**A reviewer never modifies what it judges** (rule 9). The reviewer\r\nadapter launches its agent in a read-only posture and, crucially, does\r\nnot *trust* that posture: it fingerprints the workspace before and after\r\nand raises if the tree moved. The permission flag is the provider's\r\npromise; the fingerprint is the kernel's evidence. The enforcement\r\nmatrix records which is which.\r\n\r\n**An unreadable answer is not a verdict.** Parsing lives in\r\n`review_payload` and fails closed; see the reasoning there.\r\n\r\n**A fixer's DONE is a signal, not evidence** (ADR-0008 already encodes\r\nthis: `claims_done` with an unchanged fingerprint is downgraded). The\r\nadapter reports what the agent said and never upgrades it.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nfrom collections.abc import Callable, Sequence\r\nfrom pathlib import Path\r\nfrom typing import Any, Protocol\r\n\r\nfrom ..kernel.convergence import Finding, FixReport, FixRequest, ReviewReport\r\nfrom ..kernel.git_evidence import tamper_fingerprint\r\nfrom ..runner.capture import ExecutionResult\r\nfrom ..runner.claude_cli_runner import McpRunnerConfig\r\nfrom .review_payload import (\r\n    REVIEW_SCHEMA_INSTRUCTIONS,\r\n    InvalidReviewOutput,\r\n    extract_json_object,\r\n    parse_review_payload,\r\n)\r\n\r\n# A reviewer must not be able to edit the thing it judges. `plan` is the\r\n# Claude Code mode that withholds edit tools; it is a permission-layer\r\n# promise, not a sandbox, which is why CliReviewer fingerprints the tree\r\n# either side of the run and why the enforcement matrix records\r\n# `reviewer_read_only` as SANDBOX_APPROX rather than HARD.\r\nREVIEW_PERMISSION_MODE = \"plan\"\r\nFIX_PERMISSION_MODE = \"acceptEdits\"\r\n\r\n# An agent that dumps a build log to stdout must not turn a review round\r\n# into an unbounded read.\r\nMAX_AGENT_MESSAGE_CHARS = 2_000_000\r\n\r\n\r\nclass ReviewerModifiedSubject(RuntimeError):\r\n    \"\"\"The reviewer changed the workspace it was judging (rule 9).\r\n\r\n    Treated as an evidence-collection failure by the loop: a round whose\r\n    reviewer edited the code produced no independent verdict, whatever it\r\n    printed.\"\"\"\r\n\r\n\r\nclass AgentRunner(Protocol):\r\n    \"\"\"What both adapters need from a runner.\r\n\r\n    Deliberately narrower than `ClaudeCodeCLIRunner`: a `ReplayingCLIRunner`\r\n    (ADR-0014) satisfies it too, so a whole convergence loop can be\r\n    recorded and replayed.\"\"\"\r\n\r\n    def run(\r\n        self, prompt: str, cwd: Path, stdout_path: Path, stderr_path: Path,\r\n        timeout_s: float = ..., **kwargs: Any,\r\n    ) -> ExecutionResult: ...\r\n\r\n\r\ndef agent_message_text(result: ExecutionResult) -> str:\r\n    \"\"\"The agent's own final message, from a Claude Code `--output-format json` run.\r\n\r\n    Falls back to the raw stdout when the envelope is missing or shaped\r\n    unexpectedly: a review is still readable from plain text, and\r\n    refusing to look would turn a provider's envelope change into a total\r\n    outage. What is NOT tolerated is inventing a verdict â€” that decision\r\n    belongs to the parser, which fails closed.\r\n    \"\"\"\r\n    payload = result.parsed_json\r\n    if isinstance(payload, dict):\r\n        for key in (\"result\", \"text\", \"content\", \"message\"):\r\n            value = payload.get(key)\r\n            if isinstance(value, str) and value.strip():\r\n                return value[:MAX_AGENT_MESSAGE_CHARS]\r\n    try:\r\n        with Path(result.stdout_path).open(\"r\", encoding=\"utf-8\", errors=\"replace\") as fh:\r\n            # Bounded: an agent that dumps a log to stdout must not be able\r\n            # to make the reviewer read a multi-gigabyte file into memory,\r\n            # and a review that does not fit in this much text is not a\r\n            # review this parser was going to find an answer in anyway.\r\n            return fh.read(MAX_AGENT_MESSAGE_CHARS)\r\n    except OSError:\r\n        return \"\"\r\n\r\n\r\ndef build_review_prompt(\r\n    objective: str, round_index: int, focus: Sequence[str] | None = None,\r\n    verification_summary: str | None = None,\r\n) -> str:\r\n    parts = [\r\n        (\"You are an INDEPENDENT reviewer. Do not modify any file: you are \"\r\n         \"judging this work, not doing it.\"),\r\n        f\"Objective under review: {objective}\",\r\n        f\"Review round: {round_index}\",\r\n    ]\r\n    if verification_summary:\r\n        # The reviewer sees what the machine already proved, so it spends\r\n        # its round on what deterministic verification cannot answer.\r\n        parts.append(f\"Deterministic verification this round: {verification_summary}\")\r\n    if focus:\r\n        parts.append(\"Focus on: \" + \"; \".join(focus))\r\n    parts.append(\r\n        \"Judge correctness first, then security, then whether the change is \"\r\n        \"supported by evidence. Report only defects you can point at.\"\r\n    )\r\n    parts.append(REVIEW_SCHEMA_INSTRUCTIONS)\r\n    return \"\\n\\n\".join(parts)\r\n\r\n\r\ndef build_fix_prompt(request: FixRequest, objective: str) -> str:\r\n    parts = [\r\n        (\"You are fixing defects an independent reviewer found. Change the \"\r\n         \"code; do not argue with the findings in prose.\"),\r\n        f\"Objective: {objective}\",\r\n        f\"Round: {request.round_index}\",\r\n    ]\r\n    if request.verification is not None and not request.verification.passed:\r\n        parts.append(\r\n            \"Deterministic verification is currently FAILING; that must end \"\r\n            \"up passing.\"\r\n        )\r\n    if request.blocking_findings:\r\n        parts.append(\"Blocking findings:\\n\" + \"\\n\".join(\r\n            _render_finding(index, finding)\r\n            for index, finding in enumerate(request.blocking_findings, start=1)\r\n        ))\r\n    parts.append(\r\n        \"When you are done, output a single JSON object in a ```json fenced \"\r\n        'block: {\"claims_done\": true|false, \"cannot_fix\": true|false, '\r\n        '\"notes\": \"<what you changed, or why you cannot>\"}. '\r\n        'Set \"cannot_fix\" only when the finding cannot be addressed here â€” '\r\n        \"it stops the loop, so it is not a way to end a hard round.\"\r\n    )\r\n    return \"\\n\\n\".join(parts)\r\n\r\n\r\ndef _slug(identity: str) -> str:\r\n    \"\"\"A filename-safe form of an agent identity.\r\n\r\n    Identities carry `/` and `:` (`claude-cli`, `codex://reviewer-2`), and\r\n    a path built from one unsanitised would escape the evidence directory\r\n    or fail outright on Windows.\"\"\"\r\n    safe = \"\".join(ch if ch.isalnum() or ch in \"-_.\" else \"-\" for ch in identity)\r\n    return safe.strip(\"-\") or \"agent\"\r\n\r\n\r\ndef _render_finding(index: int, finding: Finding) -> str:\r\n    location = f\" [{finding.file}]\" if finding.file else \"\"\r\n    return (\r\n        f\"{index}. ({finding.severity.value}/{finding.category}){location} \"\r\n        f\"{finding.description}\"\r\n        + (f\"\\n   evidence: {finding.evidence}\" if finding.evidence else \"\")\r\n    )\r\n\r\n\r\nclass CliReviewer:\r\n    \"\"\"`review_fn` for `ConvergenceLoop`, backed by a real agent CLI.\"\"\"\r\n\r\n    def __init__(\r\n        self,\r\n        runner: AgentRunner,\r\n        repo_path: Path,\r\n        evidence_dir: Path,\r\n        objective: str,\r\n        reviewer_id: str = \"claude-cli\",\r\n        focus: Sequence[str] | None = None,\r\n        timeout_s: float = 900.0,\r\n        mcp: McpRunnerConfig | None = None,\r\n        fingerprint_fn: Callable[[Path], dict[str, Any]] | None = None,\r\n    ) -> None:\r\n        self.runner = runner\r\n        self.repo_path = repo_path\r\n        self.evidence_dir = evidence_dir\r\n        self.objective = objective\r\n        self.reviewer_id = reviewer_id\r\n        self.focus = tuple(focus or ())\r\n        self.timeout_s = timeout_s\r\n        self.mcp = mcp\r\n        self.fingerprint_fn = fingerprint_fn or tamper_fingerprint\r\n\r\n    def __call__(self, round_index: int) -> ReviewReport:\r\n        before = self.fingerprint_fn(self.repo_path)\r\n        stdout, stderr = self._evidence_paths(round_index)\r\n        result = self.runner.run(\r\n            prompt=build_review_prompt(self.objective, round_index, self.focus),\r\n            cwd=self.repo_path, stdout_path=stdout, stderr_path=stderr,\r\n            timeout_s=self.timeout_s, permission_mode=REVIEW_PERMISSION_MODE,\r\n            mcp=self.mcp,\r\n        )\r\n        # Checked BEFORE the output is parsed: a reviewer that edited the\r\n        # code has already violated rule 9, and reading its verdict first\r\n        # would mean deciding whether to care based on what it said.\r\n        after = self.fingerprint_fn(self.repo_path)\r\n        if after != before:\r\n            raise ReviewerModifiedSubject(\r\n                f\"reviewer {self.reviewer_id!r} changed the workspace it was \"\r\n                f\"judging in round {round_index}: {before} -> {after}\"\r\n            )\r\n        if result.timed_out or result.cancelled:\r\n            raise InvalidReviewOutput(\r\n                f\"reviewer {self.reviewer_id!r} did not finish round {round_index} \"\r\n                f\"(timed_out={result.timed_out}, cancelled={result.cancelled})\"\r\n            )\r\n        return parse_review_payload(agent_message_text(result), reviewer=self.reviewer_id)\r\n\r\n    def _evidence_paths(self, round_index: int) -> tuple[Path, Path]:\r\n        # The reviewer identity is in the filename, not just the round.\r\n        # Two loops sharing an evidence directory both wrote `review-1.*`\r\n        # and destroyed each other's evidence, which also made replay\r\n        # attribution unreliable (Codex review).\r\n        self.evidence_dir.mkdir(parents=True, exist_ok=True)\r\n        stem = f\"review-{_slug(self.reviewer_id)}-{round_index}\"\r\n        return (self.evidence_dir / f\"{stem}.stdout\",\r\n                self.evidence_dir / f\"{stem}.stderr\")\r\n\r\n\r\nclass CliFixer:\r\n    \"\"\"`fix_fn` for `ConvergenceLoop`, backed by a real agent CLI.\"\"\"\r\n\r\n    def __init__(\r\n        self,\r\n        runner: AgentRunner,\r\n        repo_path: Path,\r\n        evidence_dir: Path,\r\n        objective: str,\r\n        fixer_id: str = \"claude-cli\",\r\n        timeout_s: float = 1800.0,\r\n        mcp: McpRunnerConfig | None = None,\r\n    ) -> None:\r\n        self.runner = runner\r\n        self.repo_path = repo_path\r\n        self.evidence_dir = evidence_dir\r\n        self.objective = objective\r\n        self.fixer_id = fixer_id\r\n        self.timeout_s = timeout_s\r\n        self.mcp = mcp\r\n\r\n    def __call__(self, request: FixRequest) -> FixReport:\r\n        self.evidence_dir.mkdir(parents=True, exist_ok=True)\r\n        stem = f\"fix-{_slug(self.fixer_id)}-{request.round_index}\"\r\n        stdout = self.evidence_dir / f\"{stem}.stdout\"\r\n        stderr = self.evidence_dir / f\"{stem}.stderr\"\r\n        result = self.runner.run(\r\n            prompt=build_fix_prompt(request, self.objective),\r\n            cwd=self.repo_path, stdout_path=stdout, stderr_path=stderr,\r\n            timeout_s=self.timeout_s, permission_mode=FIX_PERMISSION_MODE,\r\n            mcp=self.mcp,\r\n        )\r\n        return self._parse(result, request.round_index)\r\n\r\n    def _parse(self, result: ExecutionResult, round_index: int) -> FixReport:\r\n        \"\"\"A fixer's report, read conservatively.\r\n\r\n        Unlike a review, an unreadable fix report is NOT fatal: the fixer\r\n        may well have changed the repository, and the next round's\r\n        verification and review are what decide anyway. The conservative\r\n        reading is \"it ran, it claims nothing\" â€” which costs one more\r\n        round and cannot fake progress. Claiming `cannot_fix` on\r\n        unreadable output would end the loop on no evidence at all.\r\n        \"\"\"\r\n        if result.timed_out or result.cancelled:\r\n            return FixReport(\r\n                claims_done=False, cannot_fix=False,\r\n                notes=f\"fixer {self.fixer_id!r} round {round_index} did not finish \"\r\n                      f\"(timed_out={result.timed_out}, cancelled={result.cancelled})\",\r\n            )\r\n        text = agent_message_text(result)\r\n        try:\r\n            payload = extract_json_object(text)\r\n        except InvalidReviewOutput:\r\n            return FixReport(\r\n                claims_done=False, cannot_fix=False,\r\n                notes=f\"fixer {self.fixer_id!r} round {round_index}: no structured \"\r\n                      f\"report found; treating the round as inconclusive\",\r\n            )\r\n        notes = payload.get(\"notes\", \"\")\r\n        return FixReport(\r\n            # `is True` on purpose: a truthy string or a non-empty list is\r\n            # not a claim of doneness, and coercing one into `True` would\r\n            # invent the signal the loop weighs.\r\n            claims_done=payload.get(\"claims_done\") is True,\r\n            cannot_fix=payload.get(\"cannot_fix\") is True,\r\n            notes=notes if isinstance(notes, str) else json.dumps(notes, sort_keys=True),\r\n        )\r\n\"\"\"Review-convergence loop (Directive 6): signal âˆ§ evidence, tri-state\r\nrounds, stalemate fingerprints, nothing-lost gate ledger.\r\n\r\nThe kernel owns the loop; reviewers and fixers are injected callables\r\n(later: Claude/Codex adapters; in tests: deterministic fakes). Rules,\r\nfrom docs/research/REFERENCE_REPOSITORY_FINDINGS.md Â§6:\r\n\r\n- **An agent's DONE claim never closes a Task.** Convergence requires\r\n  computer-checked evidence: the deterministic verification passed AND\r\n  the independent review verdict is PASS AND no blocking finding stands.\r\n  A fixer's ``claims_done`` with an unchanged repo fingerprint is\r\n  downgraded to continue-with-warning (ralphex: DONE means \"zero issues\r\n  this round\", not \"I finished fixing\").\r\n- **Rounds are tri-state**: clean round â†’ CONVERGED; fixed-something â†’\r\n  another independent verification round; can't-fix â†’ typed CANNOT_FIX.\r\n- **Stalemate is a kernel circuit breaker** over repo-state fingerprints\r\n  (git HEAD + status + diff, hashed with kernel.canonical): N\r\n  consecutive unchanged fingerprints â†’ STALEMATE. The counter resets on\r\n  change and NEVER counts a round whose evidence collection failed\r\n  (fingerprint unavailable) â€” a broken probe must not masquerade as a\r\n  stuck repo.\r\n- **Nothing is lost.** Every finding held back by a gate (severity below\r\n  the blocking set, confidence below the floor) is carried in the\r\n  GateLedger and surfaced in the result at every loop exit; non-blocking\r\n  findings present at convergence are preserved as dissent (orca's\r\n  GateLedger, agent-arena's dissent preservation).\r\n- **Every loop is bounded** (constitution rule 8): ``max_rounds`` is\r\n  required and finite; exhaustion is its own typed outcome.\r\n\r\nExceptions from ``fix_fn`` propagate raw: a crashing fixer is an agent\r\nfailure for the caller's taxonomy to classify, never something this loop\r\nabsorbs into a fake verdict. ``verify_fn``/``review_fn``/``fingerprint_fn``\r\nfailures are treated as evidence-collection failures: the round cannot\r\nconverge, cannot count toward stalemate, and is recorded with a warning.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom collections.abc import Callable\r\nfrom dataclasses import dataclass\r\nfrom enum import Enum\r\nfrom functools import partial\r\nfrom pathlib import Path\r\nfrom typing import Any\r\n\r\nfrom .canonical import hash_canonical\r\nfrom .git_evidence import capture_git_evidence\r\nfrom .verification import VerificationResult\r\n\r\n\r\nclass ReviewVerdict(str, Enum):\r\n    PASS = \"PASS\"\r\n    FAIL = \"FAIL\"\r\n    UNCERTAIN = \"UNCERTAIN\"\r\n\r\n\r\nclass Severity(str, Enum):\r\n    CRITICAL = \"CRITICAL\"\r\n    MAJOR = \"MAJOR\"\r\n    MINOR = \"MINOR\"\r\n    INFO = \"INFO\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Finding:\r\n    severity: Severity\r\n    category: str\r\n    description: str\r\n    reviewer: str\r\n    evidence: str = \"\"\r\n    file: str | None = None\r\n    symbol: str | None = None\r\n    confidence: float = 1.0\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        return {\r\n            \"severity\": self.severity.value, \"category\": self.category,\r\n            \"description\": self.description, \"reviewer\": self.reviewer,\r\n            \"evidence\": self.evidence, \"file\": self.file, \"symbol\": self.symbol,\r\n            \"confidence\": self.confidence,\r\n        }\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass ReviewReport:\r\n    \"\"\"One independent reviewer's structured verdict for one round.\"\"\"\r\n\r\n    verdict: ReviewVerdict\r\n    findings: tuple[Finding, ...] = ()\r\n    reviewer: str = \"unknown\"\r\n    notes: str = \"\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass FixRequest:\r\n    round_index: int\r\n    blocking_findings: tuple[Finding, ...]\r\n    verification: VerificationResult | None\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass FixReport:\r\n    \"\"\"The fixer's own account of its round. ``claims_done`` is a SIGNAL,\r\n    never evidence â€” the next round's verification/review decide.\"\"\"\r\n\r\n    claims_done: bool = False\r\n    cannot_fix: bool = False\r\n    notes: str = \"\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass GatedFinding:\r\n    finding: Finding\r\n    gate_reason: str\r\n    round_index: int\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        return {\r\n            \"finding\": self.finding.to_dict(),\r\n            \"gate_reason\": self.gate_reason,\r\n            \"round_index\": self.round_index,\r\n        }\r\n\r\n\r\nclass ConvergenceOutcome(str, Enum):\r\n    CONVERGED = \"CONVERGED\"\r\n    STALEMATE = \"STALEMATE\"\r\n    CANNOT_FIX = \"CANNOT_FIX\"\r\n    ROUNDS_EXHAUSTED = \"ROUNDS_EXHAUSTED\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass RoundRecord:\r\n    index: int\r\n    fingerprint: str | None\r\n    evidence_ok: bool\r\n    verification: VerificationResult | None\r\n    review: ReviewReport | None\r\n    blocking: tuple[Finding, ...]\r\n    gated: tuple[GatedFinding, ...]\r\n    fix: FixReport | None\r\n    warnings: tuple[str, ...]\r\n    unchanged_streak: int\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass EvidenceFailure:\r\n    \"\"\"A probe that raised, kept with its TYPE rather than only its text.\r\n\r\n    \"review collection failed: ...\" reads the same whether the agent\r\n    produced unreadable output, edited the code it was judging, or\r\n    crashed â€” and those demand very different responses. The loop's\r\n    handling is identical (no evidence was collected), but the record is\r\n    not (Codex review).\"\"\"\r\n\r\n    stage: str          # fingerprint | verification | review\r\n    error_type: str     # the exception class name, e.g. InvalidReviewOutput\r\n    message: str\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        return {\"stage\": self.stage, \"error_type\": self.error_type,\r\n                \"message\": self.message}\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass ConvergenceResult:\r\n    outcome: ConvergenceOutcome\r\n    rounds: tuple[RoundRecord, ...]\r\n    gate_ledger: tuple[GatedFinding, ...]\r\n    dissent: tuple[Finding, ...]\r\n    warnings: tuple[str, ...]\r\n    evidence_failures: tuple[EvidenceFailure, ...] = ()\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        return {\r\n            \"outcome\": self.outcome.value,\r\n            \"round_count\": len(self.rounds),\r\n            \"gate_ledger\": [g.to_dict() for g in self.gate_ledger],\r\n            \"dissent\": [f.to_dict() for f in self.dissent],\r\n            \"warnings\": list(self.warnings),\r\n            \"evidence_failures\": [f.to_dict() for f in self.evidence_failures],\r\n        }\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass ConvergencePolicy:\r\n    max_rounds: int\r\n    max_unchanged_rounds: int = 3\r\n    blocking_severities: frozenset[Severity] = frozenset({Severity.CRITICAL, Severity.MAJOR})\r\n    min_blocking_confidence: float = 0.5\r\n\r\n    def __post_init__(self) -> None:\r\n        if self.max_rounds < 1:\r\n            raise ValueError(\"ConvergencePolicy.max_rounds must be >= 1\")\r\n        if self.max_unchanged_rounds < 1:\r\n            raise ValueError(\"ConvergencePolicy.max_unchanged_rounds must be >= 1\")\r\n        if not 0.0 <= self.min_blocking_confidence <= 1.0:\r\n            raise ValueError(\"min_blocking_confidence must be within [0, 1]\")\r\n\r\n\r\ndef git_fingerprint(repo_path: Path) -> str | None:\r\n    \"\"\"Repo-state fingerprint for stalemate detection: HEAD + working-tree\r\n    status + diff stat, hashed with the kernel's canonical contract.\r\n    Returns None when evidence collection fails (not a repo, no HEAD), so\r\n    the caller knows not to count the round.\"\"\"\r\n    evidence = capture_git_evidence(repo_path)\r\n    if not evidence.is_repo or evidence.head_sha is None:\r\n        return None\r\n    return hash_canonical({\r\n        \"head\": evidence.head_sha,\r\n        \"status\": evidence.status_porcelain,\r\n        \"diff\": evidence.diff_stat,\r\n    })\r\n\r\n\r\nclass ConvergenceLoop:\r\n    \"\"\"Bounded implementâ†’verifyâ†’reviewâ†’fix convergence engine.\"\"\"\r\n\r\n    def __init__(\r\n        self,\r\n        policy: ConvergencePolicy,\r\n        verify_fn: Callable[[], VerificationResult],\r\n        review_fn: Callable[[int], ReviewReport],\r\n        fix_fn: Callable[[FixRequest], FixReport],\r\n        fingerprint_fn: Callable[[], str | None],\r\n    ):\r\n        self.policy = policy\r\n        self.verify_fn = verify_fn\r\n        self.review_fn = review_fn\r\n        self.fix_fn = fix_fn\r\n        self.fingerprint_fn = fingerprint_fn\r\n\r\n    def run(self) -> ConvergenceResult:\r\n        rounds: list[RoundRecord] = []\r\n        ledger: list[GatedFinding] = []\r\n        loop_warnings: list[str] = []\r\n        evidence_failures: list[EvidenceFailure] = []\r\n        prev_fingerprint: str | None = None\r\n        have_prev = False\r\n        unchanged = 0\r\n        last_fix: FixReport | None = None\r\n        # Last verification outcome observed per fingerprint, for the\r\n        # flip-detection guard below (Codex review finding 3).\r\n        verified_by_fp: dict[str, bool] = {}\r\n\r\n        for index in range(1, self.policy.max_rounds + 1):\r\n            warnings: list[str] = []\r\n\r\n            fingerprint = self._collect(\r\n                self.fingerprint_fn, \"fingerprint\", warnings, evidence_failures)\r\n            verification = self._collect(\r\n                self.verify_fn, \"verification\", warnings, evidence_failures)\r\n            review = self._collect(\r\n                partial(self.review_fn, index), \"review\", warnings, evidence_failures)\r\n            if fingerprint is None and not any(\"fingerprint\" in w for w in warnings):\r\n                # The probe's documented soft-failure mode is returning\r\n                # None (git_fingerprint); record it, same as a raise.\r\n                warnings.append(\r\n                    \"fingerprint unavailable: round cannot converge or \"\r\n                    \"count toward stalemate\"\r\n                )\r\n            evidence_ok = (\r\n                fingerprint is not None and verification is not None and review is not None\r\n            )\r\n\r\n            # Signal âˆ§ evidence: a prior DONE claim with an unchanged repo\r\n            # is downgraded to a warning, never trusted.\r\n            if (\r\n                last_fix is not None and last_fix.claims_done\r\n                and fingerprint is not None and have_prev\r\n                and fingerprint == prev_fingerprint\r\n            ):\r\n                warnings.append(\r\n                    \"fixer claimed done but the repo fingerprint did not \"\r\n                    \"change: signal without evidence, continuing\"\r\n                )\r\n\r\n            # Stalemate accounting â€” \"N CONSECUTIVE unchanged rounds\", and\r\n            # only rounds with COMPLETE evidence count (Codex review\r\n            # findings 1-2): a failed probe of any kind breaks the\r\n            # consecutive run entirely (streak and baseline), so a broken\r\n            # probe can neither masquerade as a stuck repo nor bridge a\r\n            # gap the kernel did not observe.\r\n            if evidence_ok:\r\n                if have_prev and fingerprint == prev_fingerprint:\r\n                    unchanged += 1\r\n                else:\r\n                    unchanged = 0\r\n                prev_fingerprint = fingerprint\r\n                have_prev = True\r\n            else:\r\n                unchanged = 0\r\n                have_prev = False\r\n\r\n            blocking: list[Finding] = []\r\n            gated_this_round: list[GatedFinding] = []\r\n            if review is not None:\r\n                for finding in review.findings:\r\n                    if finding.severity not in self.policy.blocking_severities:\r\n                        gated_this_round.append(GatedFinding(\r\n                            finding, f\"severity {finding.severity.value} below blocking set\", index,\r\n                        ))\r\n                    elif finding.confidence < self.policy.min_blocking_confidence:\r\n                        gated_this_round.append(GatedFinding(\r\n                            finding,\r\n                            f\"confidence {finding.confidence} below floor \"\r\n                            f\"{self.policy.min_blocking_confidence}\",\r\n                            index,\r\n                        ))\r\n                    else:\r\n                        blocking.append(finding)\r\n                ledger.extend(gated_this_round)\r\n\r\n            clean = (\r\n                evidence_ok\r\n                and verification is not None and verification.passed\r\n                and review is not None and review.verdict is ReviewVerdict.PASS\r\n                and not blocking\r\n            )\r\n\r\n            # Flip-detection guard (Codex review finding 3): a verification\r\n            # that FAILED earlier on this exact repo fingerprint and now\r\n            # PASSES with the repo unchanged is contradictory evidence â€” a\r\n            # flaky or gameable verifier must not close the task on one\r\n            # lucky pass. Convergence then requires the pass to be\r\n            # REPRODUCED in an independent round on the same fingerprint.\r\n            if (\r\n                clean and fingerprint is not None\r\n                and verified_by_fp.get(fingerprint) is False\r\n            ):\r\n                clean = False\r\n                warnings.append(\r\n                    \"verification outcome flipped from fail to pass on an \"\r\n                    \"unchanged repo fingerprint: requiring reproduction in \"\r\n                    \"an independent round before convergence\"\r\n                )\r\n            if fingerprint is not None and verification is not None:\r\n                verified_by_fp[fingerprint] = verification.passed\r\n\r\n            fix: FixReport | None = None\r\n            if not clean and evidence_ok:\r\n                needs_fix = bool(blocking) or (\r\n                    verification is not None and not verification.passed\r\n                )\r\n                if needs_fix:\r\n                    fix = self.fix_fn(FixRequest(\r\n                        round_index=index,\r\n                        blocking_findings=tuple(blocking),\r\n                        verification=verification,\r\n                    ))\r\n                    last_fix = fix\r\n                else:\r\n                    # e.g. an UNCERTAIN verdict with nothing concrete to\r\n                    # fix: another independent round decides; a reviewer\r\n                    # who stays uncertain over an unchanging repo runs\r\n                    # into the stalemate breaker, not an infinite loop.\r\n                    warnings.append(\r\n                        \"round not clean but no fixable target (verdict \"\r\n                        f\"{review.verdict.value if review else 'n/a'}): \"\r\n                        \"scheduling another independent round\"\r\n                    )\r\n\r\n            loop_warnings.extend(warnings)\r\n            rounds.append(RoundRecord(\r\n                index=index, fingerprint=fingerprint, evidence_ok=evidence_ok,\r\n                verification=verification, review=review,\r\n                blocking=tuple(blocking), gated=tuple(gated_this_round),\r\n                fix=fix, warnings=tuple(warnings), unchanged_streak=unchanged,\r\n            ))\r\n\r\n            if clean:\r\n                dissent = tuple(\r\n                    f for f in (review.findings if review else ())\r\n                    if f not in blocking\r\n                )\r\n                return self._result(\r\n                    ConvergenceOutcome.CONVERGED, rounds, ledger, dissent, loop_warnings, evidence_failures,\r\n                )\r\n            if fix is not None and fix.cannot_fix:\r\n                return self._result(\r\n                    ConvergenceOutcome.CANNOT_FIX, rounds, ledger, (), loop_warnings, evidence_failures,\r\n                )\r\n            if unchanged >= self.policy.max_unchanged_rounds:\r\n                return self._result(\r\n                    ConvergenceOutcome.STALEMATE, rounds, ledger, (), loop_warnings, evidence_failures,\r\n                )\r\n\r\n        return self._result(\r\n            ConvergenceOutcome.ROUNDS_EXHAUSTED, rounds, ledger, (), loop_warnings, evidence_failures,\r\n        )\r\n\r\n    @staticmethod\r\n    def _collect(fn: Callable[[], Any], label: str, warnings: list[str],\r\n                 failures: list[EvidenceFailure] | None = None) -> Any:\r\n        \"\"\"Evidence collection: a failing probe yields None + a warning,\r\n        never a fake value and never an aborted loop.\r\n\r\n        The *type* is kept alongside the message. A prose warning collapsed\r\n        an unreadable agent answer, a reviewer that edited the code, a\r\n        broken git probe and a crashed verifier into one indistinguishable\r\n        outcome â€” and the constitution requires INVALID_AGENT_OUTPUT to\r\n        stay distinct from disagreement (Codex review). The loop still\r\n        treats them identically, which is correct: no evidence was\r\n        collected either way. The caller can now tell them apart.\r\n        \"\"\"\r\n        try:\r\n            return fn()\r\n        except Exception as exc:  # noqa: BLE001 - probe failure is data, not control flow\r\n            warnings.append(f\"{label} collection failed: {exc}\")\r\n            if failures is not None:\r\n                failures.append(EvidenceFailure(\r\n                    stage=label, error_type=type(exc).__name__, message=str(exc)[:500],\r\n                ))\r\n            return None\r\n\r\n    @staticmethod\r\n    def _result(\r\n        outcome: ConvergenceOutcome,\r\n        rounds: list[RoundRecord],\r\n        ledger: list[GatedFinding],\r\n        dissent: tuple[Finding, ...],\r\n        warnings: list[str],\r\n        evidence_failures: list[EvidenceFailure] | None = None,\r\n    ) -> ConvergenceResult:\r\n        # Nothing-lost rule: the gate ledger rides on EVERY exit path, and\r\n        # so does the typed record of what could not be collected.\r\n        return ConvergenceResult(\r\n            outcome=outcome, rounds=tuple(rounds), gate_ledger=tuple(ledger),\r\n            dissent=dissent, warnings=tuple(warnings),\r\n            evidence_failures=tuple(evidence_failures or ()),\r\n        )\r\n","exit_code":0,"status":"completed"}}
