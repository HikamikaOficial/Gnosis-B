c/gnosis/kernel/lease.py:52:            f\"Resource '{lease.resource}' is held by '{lease.holder}' \"\r\nsrc/gnosis/kernel/lease.py:53:            f\"(lease {lease.lease_id}, token {lease.fencing_token}) \"\r\nsrc/gnosis/kernel/lease.py:54:            f\"until {lease.expires_at:.3f}\"\r\nsrc/gnosis/kernel/lease.py:55:        )\r\nsrc/gnosis/kernel/lease.py:56:        self.lease = lease\r\nsrc/gnosis/kernel/lease.py:57:\r\nsrc/gnosis/kernel/lease.py:58:\r\nsrc/gnosis/kernel/lease.py:59:class StaleLeaseError(LeaseError):\r\nsrc/gnosis/kernel/lease.py:60:    \"\"\"The presented lease is no longer the current grant for the resource.\"\"\"\r\nsrc/gnosis/kernel/lease.py:61:\r\nsrc/gnosis/kernel/lease.py:62:\r\nsrc/gnosis/kernel/lease.py:63:@dataclass(frozen=True)\r\nsrc/gnosis/kernel/lease.py:64:class Lease:\r\nsrc/gnosis/kernel/lease.py:65:    resource: str\r\nsrc/gnosis/kernel/lease.py:66:    lease_id: str\r\nsrc/gnosis/kernel/lease.py:67:    holder: str\r\nsrc/gnosis/kernel/lease.py:68:    fencing_token: int\r\nsrc/gnosis/kernel/lease.py:69:    issued_at: float\r\nsrc/gnosis/kernel/lease.py:70:    expires_at: float\r\nsrc/gnosis/kernel/lease.py:71:    last_heartbeat_at: float\r\nsrc/gnosis/kernel/lease.py:72:\r\nsrc/gnosis/kernel/lease.py:73:    def to_dict(self) -> dict[str, Any]:\r\nsrc/gnosis/kernel/lease.py:74:        return {\r\nsrc/gnosis/kernel/lease.py:75:            \"resource\": self.resource,\r\nsrc/gnosis/kernel/lease.py:76:            \"lease_id\": self.lease_id,\r\nsrc/gnosis/kernel/lease.py:77:            \"holder\": self.holder,\r\nsrc/gnosis/kernel/lease.py:78:            \"fencing_token\": self.fencing_token,\r\nsrc/gnosis/kernel/lease.py:79:            \"issued_at\": self.issued_at,\r\nsrc/gnosis/kernel/lease.py:80:            \"expires_at\": self.expires_at,\r\nsrc/gnosis/kernel/lease.py:81:            \"last_heartbeat_at\": self.last_heartbeat_at,\r\nsrc/gnosis/kernel/lease.py:82:        }\r\nsrc/gnosis/kernel/lease.py:83:\r\nsrc/gnosis/kernel/lease.py:84:    @classmethod\r\nsrc/gnosis/kernel/lease.py:85:    def from_dict(cls, data: dict[str, Any]) -> Lease:\r\nsrc/gnosis/kernel/lease.py:86:        return cls(\r\nsrc/gnosis/kernel/lease.py:87:            resource=data[\"resource\"],\r\nsrc/gnosis/kernel/lease.py:88:            lease_id=data[\"lease_id\"],\r\nsrc/gnosis/kernel/lease.py:89:            holder=data[\"holder\"],\r\nsrc/gnosis/kernel/lease.py:90:            fencing_token=data[\"fencing_token\"],\r\nsrc/gnosis/kernel/lease.py:91:            issued_at=data[\"issued_at\"],\r\nsrc/gnosis/kernel/lease.py:92:            expires_at=data[\"expires_at\"],\r\nsrc/gnosis/kernel/lease.py:93:            last_heartbeat_at=data[\"last_heartbeat_at\"],\r\nsrc/gnosis/kernel/lease.py:94:        )\r\nsrc/gnosis/kernel/lease.py:95:\r\nsrc/gnosis/kernel/lease.py:96:\r\nsrc/gnosis/kernel/lease.py:97:class LeaseStore:\r\nsrc/gnosis/kernel/lease.py:98:    \"\"\"Durable store of current leases plus per-resource token history.\r\nsrc/gnosis/kernel/lease.py:99:\r\nsrc/gnosis/kernel/lease.py:100:    Safe for concurrent use across threads and processes: every operation\r\nsrc/gnosis/kernel/lease.py:101:    is a read-modify-write of the state file under one FileLock.\r\nsrc/gnosis/kernel/lease.py:102:    \"\"\"\r\nsrc/gnosis/kernel/lease.py:103:\r\nsrc/gnosis/kernel/lease.py:104:    def __init__(self, path: Path, lock_timeout_s: float = 30.0,\r\nsrc/gnosis/kernel/lease.py:105:                 clock: Callable[[], float] = time.time):\r\nsrc/gnosis/kernel/lease.py:106:        self.path = path\r\nsrc/gnosis/kernel/lease.py:107:        self._lock_timeout_s = lock_timeout_s\r\nsrc/gnosis/kernel/lease.py:108:        # Injectable clock (a callable returning float seconds) so expiry\r\nsrc/gnosis/kernel/lease.py:109:        # behavior is deterministically testable without sleeping.\r\nsrc/gnosis/kernel/lease.py:110:        self._clock = clock\r\nsrc/gnosis/kernel/lease.py:111:        self.path.parent.mkdir(parents=True, exist_ok=True)\r\nsrc/gnosis/kernel/lease.py:112:\r\nsrc/gnosis/kernel/lease.py:113:    def _locked(self) -> FileLock:\r\nsrc/gnosis/kernel/lease.py:114:        # One FileLock instance PER critical section, per the FileLock\r\nsrc/gnosis/kernel/lease.py:115:        # contract: a shared instance raises on concurrent acquire from a\r\nsrc/gnosis/kernel/lease.py:116:        # second thread instead of waiting its turn. Multi-threaded use is\r\nsrc/gnosis/kernel/lease.py:117:        # real (heartbeat pump + guards + sweeps), and the OS-level lock\r\nsrc/gnosis/kernel/lease.py:118:        # still serializes across both threads and processes.\r\nsrc/gnosis/kernel/lease.py:119:        return FileLock(lock_path_for(self.path), timeout_s=self._lock_timeout_s)\r\nsrc/gnosis/kernel/lease.py:120:\r\nsrc/gnosis/kernel/lease.py:121:    # -- operations ---------------------------------------------------------\r\nsrc/gnosis/kernel/lease.py:122:\r\nsrc/gnosis/kernel/lease.py:123:    def acquire(self, resource: str, holder: str, ttl_s: float) -> Lease:\r\nsrc/gnosis/kernel/lease.py:124:        \"\"\"Grant a lease, or raise LeaseHeldError while a live one exists.\r\nsrc/gnosis/kernel/lease.py:125:\r\nsrc/gnosis/kernel/lease.py:126:        An expired lease is taken over with a strictly greater fencing\r\nsrc/gnosis/kernel/lease.py:127:        token. Renewal of a live lease is heartbeat()'s job, deliberately\r\nsrc/gnosis/kernel/lease.py:128:        not acquire()'s, so double-acquire bugs surface loudly even for\r\nsrc/gnosis/kernel/lease.py:129:        the same holder.\r\nsrc/gnosis/kernel/lease.py:130:        \"\"\"\r\nsrc/gnosis/kernel/lease.py:131:        if ttl_s <= 0:\r\nsrc/gnosis/kernel/lease.py:132:            raise ValueError(\"ttl_s must be positive\")\r\nsrc/gnosis/kernel/lease.py:133:        with self._locked():\r\nsrc/gnosis/kernel/lease.py:134:            state = self._load_locked()\r\nsrc/gnosis/kernel/lease.py:135:            now = float(self._clock())\r\nsrc/gnosis/kernel/lease.py:136:            current = state[\"leases\"].get(resource)\r\nsrc/gnosis/kernel/lease.py:137:            if current is not None:\r\nsrc/gnosis/kernel/lease.py:138:                lease = Lease.from_dict(current)\r\nsrc/gnosis/kernel/lease.py:139:                if lease.expires_at > now:\r\nsrc/gnosis/kernel/lease.py:140:                    raise LeaseHeldError(lease)\r\nsrc/gnosis/kernel/lease.py:141:                # Expired: record the takeover as an eviction, then fall\r\nsrc/gnosis/kernel/lease.py:142:                # through to grant with the next token.\r\nsrc/gnosis/kernel/lease.py:143:                del state[\"leases\"][resource]\r\nsrc/gnosis/kernel/lease.py:144:            next_token = int(state[\"last_tokens\"].get(resource, 0)) + 1\r\nsrc/gnosis/kernel/lease.py:145:            lease = Lease(\r\nsrc/gnosis/kernel/lease.py:146:                resource=resource,\r\nsrc/gnosis/kernel/lease.py:147:                lease_id=f\"LEASE-{uuid.uuid4().hex[:12]}\",\r\nsrc/gnosis/kernel/lease.py:148:                holder=holder,\r\nsrc/gnosis/kernel/lease.py:149:                fencing_token=next_token,\r\nsrc/gnosis/kernel/lease.py:150:                issued_at=now,\r\nsrc/gnosis/kernel/lease.py:151:                expires_at=now + ttl_s,\r\nsrc/gnosis/kernel/lease.py:152:                last_heartbeat_at=now,\r\nsrc/gnosis/kernel/lease.py:153:            )\r\nsrc/gnosis/kernel/lease.py:154:            state[\"leases\"][resource] = lease.to_dict()\r\nsrc/gnosis/kernel/lease.py:155:            state[\"last_tokens\"][resource] = next_token\r\nsrc/gnosis/kernel/lease.py:156:            self._save_locked(state)\r\nsrc/gnosis/kernel/lease.py:157:            return lease\r\nsrc/gnosis/kernel/lease.py:158:\r\nsrc/gnosis/kernel/lease.py:159:    def heartbeat(self, resource: str, lease_id: str, extend_s: float) -> Lease:\r\nsrc/gnosis/kernel/lease.py:160:        \"\"\"Extend a live, current lease; stale or unknown leases fail loudly.\"\"\"\r\nsrc/gnosis/kernel/lease.py:161:        if extend_s <= 0:\r\nsrc/gnosis/kernel/lease.py:162:            raise ValueError(\"extend_s must be positive\")\r\nsrc/gnosis/kernel/lease.py:163:        with self._locked():\r\nsrc/gnosis/kernel/lease.py:164:            state = self._load_locked()\r\nsrc/gnosis/kernel/lease.py:165:            lease = self._current_locked(state, resource, lease_id)\r\nsrc/gnosis/kernel/lease.py:166:            now = float(self._clock())\r\nsrc/gnosis/kernel/lease.py:167:            renewed = Lease(\r\nsrc/gnosis/kernel/lease.py:168:                resource=lease.resource,\r\nsrc/gnosis/kernel/lease.py:169:                lease_id=lease.lease_id,\r\nsrc/gnosis/kernel/lease.py:170:                holder=lease.holder,\r\nsrc/gnosis/kernel/lease.py:171:                fencing_token=lease.fencing_token,\r\nsrc/gnosis/kernel/lease.py:172:                issued_at=lease.issued_at,\r\nsrc/gnosis/kernel/lease.py:173:                expires_at=now + extend_s,\r\nsrc/gnosis/kernel/lease.py:174:                last_heartbeat_at=now,\r\nsrc/gnosis/kernel/lease.py:175:            )\r\nsrc/gnosis/kernel/lease.py:176:            state[\"leases\"][resource] = renewed.to_dict()\r\nsrc/gnosis/kernel/lease.py:177:            self._save_locked(state)\r\nsrc/gnosis/kernel/lease.py:178:            return renewed\r\nsrc/gnosis/kernel/lease.py:179:\r\nsrc/gnosis/kernel/lease.py:180:    def release(self, resource: str, lease_id: str) -> None:\r\nsrc/gnosis/kernel/lease.py:181:        \"\"\"Release a current lease. Releasing a stale lease raises: the\r\nsrc/gnosis/kernel/lease.py:182:        caller believed it held something it did not, which is exactly\r\nsrc/gnosis/kernel/lease.py:183:        the condition that must surface, not be absorbed.\"\"\"\r\nsrc/gnosis/kernel/lease.py:184:        with self._locked():\r\nsrc/gnosis/kernel/lease.py:185:            state = self._load_locked()\r\nsrc/gnosis/kernel/lease.py:186:            self._current_locked(state, resource, lease_id)\r\nsrc/gnosis/kernel/lease.py:187:            del state[\"leases\"][resource]\r\nsrc/gnosis/kernel/lease.py:188:            self._save_locked(state)\r\nsrc/gnosis/kernel/lease.py:189:\r\nsrc/gnosis/kernel/lease.py:190:    def assert_current(self, resource: str, lease_id: str) -> Lease:\r\nsrc/gnosis/kernel/lease.py:191:        \"\"\"Guard for writes: raise StaleLeaseError unless lease_id is the\r\nsrc/gnosis/kernel/lease.py:192:        live, unexpired grant for the resource.\"\"\"\r\nsrc/gnosis/kernel/lease.py:193:        with self._locked():\r\nsrc/gnosis/kernel/lease.py:194:            state = self._load_locked()\r\nsrc/gnosis/kernel/lease.py:195:            return self._current_locked(state, resource, lease_id)\r\nsrc/gnosis/kernel/lease.py:196:\r\nsrc/gnosis/kernel/lease.py:197:    def current(self, resource: str) -> Lease | None:\r\nsrc/gnosis/kernel/lease.py:198:        \"\"\"The live lease for a resource, or None (expired counts as None).\"\"\"\r\nsrc/gnosis/kernel/lease.py:199:        with self._locked():\r\nsrc/gnosis/kernel/lease.py:200:            state = self._load_locked()\r\nsrc/gnosis/kernel/lease.py:201:            raw = state[\"leases\"].get(resource)\r\nsrc/gnosis/kernel/lease.py:202:            if raw is None:\r\nsrc/gnosis/kernel/lease.py:203:                return None\r\nsrc/gnosis/kernel/lease.py:204:            lease = Lease.from_dict(raw)\r\nsrc/gnosis/kernel/lease.py:205:            if lease.expires_at <= float(self._clock()):\r\nsrc/gnosis/kernel/lease.py:206:                return None\r\nsrc/gnosis/kernel/lease.py:207:            return lease\r\nsrc/gnosis/kernel/lease.py:208:\r\nsrc/gnosis/kernel/lease.py:209:    # -- internals ----------------------------------------------------------\r\nsrc/gnosis/kernel/lease.py:210:\r\nsrc/gnosis/kernel/lease.py:211:    def _current_locked(self, state: dict[str, Any], resource: str, lease_id: str) -> Lease:\r\nsrc/gnosis/kernel/lease.py:212:        raw = state[\"leases\"].get(resource)\r\nsrc/gnosis/kernel/lease.py:213:        if raw is None:\r\nsrc/gnosis/kernel/lease.py:214:            raise StaleLeaseError(f\"No live lease for resource '{resource}'\")\r\nsrc/gnosis/kernel/lease.py:215:        lease = Lease.from_dict(raw)\r\nsrc/gnosis/kernel/lease.py:216:        if lease.lease_id != lease_id:\r\nsrc/gnosis/kernel/lease.py:217:            raise StaleLeaseError(\r\nsrc/gnosis/kernel/lease.py:218:                f\"Lease {lease_id} for resource '{resource}' was superseded \"\r\nsrc/gnosis/kernel/lease.py:219:                f\"(current: {lease.lease_id}, token {lease.fencing_token})\"\r\nsrc/gnosis/kernel/lease.py:220:            )\r\nsrc/gnosis/kernel/lease.py:221:        if lease.expires_at <= float(self._clock()):\r\nsrc/gnosis/kernel/lease.py:222:            raise StaleLeaseError(\r\nsrc/gnosis/kernel/lease.py:223:                f\"Lease {lease_id} for resource '{resource}' has expired\"\r\nsrc/gnosis/kernel/lease.py:224:            )\r\nsrc/gnosis/kernel/lease.py:225:        return lease\r\nsrc/gnosis/kernel/lease.py:226:\r\nsrc/gnosis/kernel/lease.py:227:    def _load_locked(self) -> dict[str, Any]:\r\nsrc/gnosis/kernel/lease.py:228:        if not self.path.exists():\r\nsrc/gnosis/kernel/lease.py:229:            return {\"schema_version\": 1, \"leases\": {}, \"last_tokens\": {}}\r\nsrc/gnosis/kernel/lease.py:230:        payload: dict[str, Any] = json.loads(self.path.read_text(encoding=\"utf-8\"))\r\nsrc/gnosis/kernel/lease.py:231:        payload.setdefault(\"leases\", {})\r\nsrc/gnosis/kernel/lease.py:232:        payload.setdefault(\"last_tokens\", {})\r\nsrc/gnosis/kernel/lease.py:233:        return payload\r\nsrc/gnosis/kernel/lease.py:234:\r\nsrc/gnosis/kernel/lease.py:235:    def _save_locked(self, state: dict[str, Any]) -> None:\r\nsrc/gnosis/kernel/lease.py:236:        atomic_write_text(self.path, json.dumps(state, sort_keys=True, indent=1))\r\nsrc/gnosis/kernel/claims.py:1:\"\"\"Durable task claims + the two-plane work authority (Directive 4, part two).\r\nsrc/gnosis/kernel/claims.py:2:\r\nsrc/gnosis/kernel/claims.py:3:Two planes, deliberately separate (REFERENCE_REPOSITORY_FINDINGS §4):\r\nsrc/gnosis/kernel/claims.py:4:\r\nsrc/gnosis/kernel/claims.py:5:- **Claims (this module's ClaimStore)** are history-worthy ownership state:\r\nsrc/gnosis/kernel/claims.py:6:  who owns a task, durable, versioned. Every ownership mutation is a CAS\r\nsrc/gnosis/kernel/claims.py:7:  on a ``version`` token and is recorded in the claim's history. Fencing\r\nsrc/gnosis/kernel/claims.py:8:  ``epoch``s increment monotonically per task inside the claim mutation\r\nsrc/gnosis/kernel/claims.py:9:  itself and survive any status change, so a later grant is always\r\nsrc/gnosis/kernel/claims.py:10:  distinguishable from — and greater than — every earlier one.\r\nsrc/gnosis/kernel/claims.py:11:- **Leases (kernel.lease)** are liveness chatter: TTL + heartbeats that\r\nsrc/gnosis/kernel/claims.py:12:  never enter ownership history.\r\nsrc/gnosis/kernel/claims.py:13:\r\nsrc/gnosis/kernel/claims.py:14:``WorkAuthority`` composes the two: acquiring work takes the durable\r\nsrc/gnosis/kernel/claims.py:15:claim first, then the ephemeral lease; guarding a write checks both; the\r\nsrc/gnosis/kernel/claims.py:16:TTL sweep reclaims claims whose lease has expired, re-evaluating the\r\nsrc/gnosis/kernel/claims.py:17:expiry predicate under the claim store's lock at mutation time (beads'\r\nsrc/gnosis/kernel/claims.py:18:rule: repeat the predicate at delete time, don't trust an earlier read).\r\nsrc/gnosis/kernel/claims.py:19:\r\nsrc/gnosis/kernel/claims.py:20:Conflicts are typed data, never prose: ``ClaimConflictError`` carries the\r\nsrc/gnosis/kernel/claims.py:21:full current claim; ``StaleClaimError`` means the presented (holder,\r\nsrc/gnosis/kernel/claims.py:22:epoch, version) is no longer the live grant.\r\nsrc/gnosis/kernel/claims.py:23:\r\nsrc/gnosis/kernel/claims.py:24:Lock ordering is claims → leases everywhere (LeaseStore never calls back\r\nsrc/gnosis/kernel/claims.py:25:into ClaimStore), so the two FileLocks cannot deadlock.\r\nsrc/gnosis/kernel/claims.py:26:\r\nsrc/gnosis/kernel/claims.py:27:Known, accepted race (single-workstation V1): a holder may heartbeat its\r\nsrc/gnosis/kernel/claims.py:28:lease concurrently with a sweep that already entered the claim lock; the\r\nsrc/gnosis/kernel/claims.py:29:sweep can then reclaim a claim whose lease just revived. The outcome is\r\nsrc/gnosis/kernel/claims.py:30:safe — the deposed holder's next ``assert_current`` fails loudly and no\r\nsrc/gnosis/kernel/claims.py:31:stale write lands — but the work is interrupted. Revisit if sweeps ever\r\nsrc/gnosis/kernel/claims.py:32:run aggressively enough for this to matter.\r\nsrc/gnosis/kernel/claims.py:33:\"\"\"\r\nsrc/gnosis/kernel/claims.py:34:from __future__ import annotations\r\nsrc/gnosis/kernel/claims.py:35:\r\nsrc/gnosis/kernel/claims.py:36:import json\r\nsrc/gnosis/kernel/claims.py:37:import threading\r\nsrc/gnosis/kernel/claims.py:38:import time\r\nsrc/gnosis/kernel/claims.py:39:from collections.abc import Callable\r\nsrc/gnosis/kernel/claims.py:40:from dataclasses import dataclass\r\nsrc/gnosis/kernel/claims.py:41:from enum import Enum\r\nsrc/gnosis/kernel/claims.py:42:from functools import partial\r\nsrc/gnosis/kernel/claims.py:43:from pathlib import Path\r\nsrc/gnosis/kernel/claims.py:44:from typing import Any\r\nsrc/gnosis/kernel/claims.py:45:\r\nsrc/gnosis/kernel/claims.py:46:from .atomic_io import atomic_write_text\r\nsrc/gnosis/kernel/claims.py:47:from .file_lock import FileLock, lock_path_for\r\nsrc/gnosis/kernel/claims.py:48:from .lease import Lease, LeaseHeldError, LeaseStore, StaleLeaseError\r\nsrc/gnosis/kernel/claims.py:49:\r\nsrc/gnosis/kernel/claims.py:50:\r\nsrc/gnosis/kernel/claims.py:51:class ClaimStatus(str, Enum):\r\nsrc/gnosis/kernel/claims.py:52:    ACTIVE = \"ACTIVE\"\r\nsrc/gnosis/kernel/claims.py:53:    RELEASED = \"RELEASED\"\r\nsrc/gnosis/kernel/claims.py:54:    RESOLVED = \"RESOLVED\"\r\nsrc/gnosis/kernel/claims.py:55:    RECLAIMED = \"RECLAIMED\"\r\nsrc/gnosis/kernel/claims.py:56:\r\nsrc/gnosis/kernel/claims.py:57:\r\nsrc/gnosis/kernel/claims.py:58:class ClaimError(RuntimeError):\r\nsrc/gnosis/kernel/claims.py:59:    pass\r\nsrc/gnosis/kernel/claims.py:60:\r\nsrc/gnosis/kernel/claims.py:61:\r\nsrc/gnosis/kernel/claims.py:62:class ClaimConflictError(ClaimError):\r\nsrc/gnosis/kernel/claims.py:63:    \"\"\"The task is actively claimed by someone else. Carries the current\r\nsrc/gnosis/kernel/claims.py:64:    claim as typed data — holder, status, epoch, version — never prose.\"\"\"\r\nsrc/gnosis/kernel/claims.py:65:\r\nsrc/gnosis/kernel/claims.py:66:    def __init__(self, claim: TaskClaim):\r\nsrc/gnosis/kernel/claims.py:67:        super().__init__(\r\nsrc/gnosis/kernel/claims.py:68:            f\"Task '{claim.task_id}' is claimed by '{claim.holder}' \"\r\nsrc/gnosis/kernel/claims.py:69:            f\"(status {claim.status.value}, epoch {claim.epoch}, version {claim.version})\"\r\nsrc/gnosis/kernel/claims.py:70:        )\r\nsrc/gnosis/kernel/claims.py:71:        self.claim = claim\r\nsrc/gnosis/kernel/claims.py:72:\r\nsrc/gnosis/kernel/claims.py:73:\r\nsrc/gnosis/kernel/claims.py:74:class StaleClaimError(ClaimError):\r\nsrc/gnosis/kernel/claims.py:75:    \"\"\"The presented (holder, epoch/version) is no longer the live grant.\"\"\"\r\nsrc/gnosis/kernel/claims.py:76:\r\nsrc/gnosis/kernel/claims.py:77:\r\nsrc/gnosis/kernel/claims.py:78:@dataclass(frozen=True)\r\nsrc/gnosis/kernel/claims.py:79:class TaskClaim:\r\nsrc/gnosis/kernel/claims.py:80:    task_id: str\r\nsrc/gnosis/kernel/claims.py:81:    holder: str\r\nsrc/gnosis/kernel/claims.py:82:    status: ClaimStatus\r\nsrc/gnosis/kernel/claims.py:83:    epoch: int      # fencing epoch: monotonic per task across ALL grants\r\nsrc/gnosis/kernel/claims.py:84:    version: int    # CAS token: rewritten by every ownership mutation\r\nsrc/gnosis/kernel/claims.py:85:    claimed_at: float\r\nsrc/gnosis/kernel/claims.py:86:    updated_at: float\r\nsrc/gnosis/kernel/claims.py:87:    outcome: str | None = None\r\nsrc/gnosis/kernel/claims.py:88:\r\nsrc/gnosis/kernel/claims.py:89:    def to_dict(self) -> dict[str, Any]:\r\nsrc/gnosis/kernel/claims.py:90:        return {\r\nsrc/gnosis/kernel/claims.py:91:            \"task_id\": self.task_id,\r\nsrc/gnosis/kernel/claims.py:92:            \"holder\": self.holder,\r\nsrc/gnosis/kernel/claims.py:93:            \"status\": self.status.value,\r\nsrc/gnosis/kernel/claims.py:94:            \"epoch\": self.epoch,\r\nsrc/gnosis/kernel/claims.py:95:            \"version\": self.version,\r\nsrc/gnosis/kernel/claims.py:96:            \"claimed_at\": self.claimed_at,\r\nsrc/gnosis/kernel/claims.py:97:            \"updated_at\": self.updated_at,\r\nsrc/gnosis/kernel/claims.py:98:            \"outcome\": self.outcome,\r\nsrc/gnosis/kernel/claims.py:99:        }\r\nsrc/gnosis/kernel/claims.py:100:\r\nsrc/gnosis/kernel/claims.py:101:    @classmethod\r\nsrc/gnosis/kernel/claims.py:102:    def from_dict(cls, data: dict[str, Any]) -> TaskClaim:\r\nsrc/gnosis/kernel/claims.py:103:        return cls(\r\nsrc/gnosis/kernel/claims.py:104:            task_id=data[\"task_id\"],\r\nsrc/gnosis/kernel/claims.py:105:            holder=data[\"holder\"],\r\nsrc/gnosis/kernel/claims.py:106:            status=ClaimStatus(data[\"status\"]),\r\nsrc/gnosis/kernel/claims.py:107:            epoch=data[\"epoch\"],\r\nsrc/gnosis/kernel/claims.py:108:            version=data[\"version\"],\r\nsrc/gnosis/kernel/claims.py:109:            claimed_at=data[\"claimed_at\"],\r\nsrc/gnosis/kernel/claims.py:110:            updated_at=data[\"updated_at\"],\r\nsrc/gnosis/kernel/claims.py:111:            outcome=data.get(\"outcome\"),\r\nsrc/gnosis/kernel/claims.py:112:        )\r\nsrc/gnosis/kernel/claims.py:113:\r\nsrc/gnosis/kernel/claims.py:114:\r\nsrc/gnosis/kernel/claims.py:115:class ClaimStore:\r\nsrc/gnosis/kernel/claims.py:116:    \"\"\"Durable, versioned task-ownership state with per-task history.\r\nsrc/gnosis/kernel/claims.py:117:\r\nsrc/gnosis/kernel/claims.py:118:    Every operation is a read-modify-write of one JSON state file under a\r\nsrc/gnosis/kernel/claims.py:119:    FileLock (atomic_io for the write), the kernel's established\r\nsrc/gnosis/kernel/claims.py:120:    cross-process pattern.\r\nsrc/gnosis/kernel/claims.py:121:    \"\"\"\r\nsrc/gnosis/kernel/claims.py:122:\r\nsrc/gnosis/kernel/claims.py:123:    def __init__(self, path: Path, lock_timeout_s: float = 30.0,\r\nsrc/gnosis/kernel/claims.py:124:                 clock: Callable[[], float] = time.time):\r\nsrc/gnosis/kernel/claims.py:125:        self.path = path\r\nsrc/gnosis/kernel/claims.py:126:        self._lock_timeout_s = lock_timeout_s\r\nsrc/gnosis/kernel/claims.py:127:        self._clock = clock\r\nsrc/gnosis/kernel/claims.py:128:        self.path.parent.mkdir(parents=True, exist_ok=True)\r\nsrc/gnosis/kernel/claims.py:129:\r\nsrc/gnosis/kernel/claims.py:130:    def _locked(self) -> FileLock:\r\nsrc/gnosis/kernel/claims.py:131:        # One FileLock instance PER critical section, per the FileLock\r\nsrc/gnosis/kernel/claims.py:132:        # contract: a shared instance raises on concurrent acquire from a\r\nsrc/gnosis/kernel/claims.py:133:        # second thread instead of waiting its turn. Multi-threaded use is\r\nsrc/gnosis/kernel/claims.py:134:        # real (heartbeat pump + guards + sweeps), and the OS-level lock\r\nsrc/gnosis/kernel/claims.py:135:        # still serializes across both threads and processes.\r\nsrc/gnosis/kernel/claims.py:136:        return FileLock(lock_path_for(self.path), timeout_s=self._lock_timeout_s)\r\nsrc/gnosis/kernel/claims.py:137:\r\nsrc/gnosis/kernel/claims.py:138:    # -- operations ---------------------------------------------------------\r\nsrc/gnosis/kernel/claims.py:139:\r\nsrc/gnosis/kernel/claims.py:140:    def claim(self, task_id: str, holder: str) -> TaskClaim:\r\nsrc/gnosis/kernel/claims.py:141:        \"\"\"CAS-claim a task. Idempotent for same-actor retries (an ACTIVE\r\nsrc/gnosis/kernel/claims.py:142:        claim by the same holder is returned unchanged — retrying is not\r\nsrc/gnosis/kernel/claims.py:143:        an ownership mutation, so neither version nor epoch move). An\r\nsrc/gnosis/kernel/claims.py:144:        ACTIVE claim by anyone else raises ClaimConflictError with the\r\nsrc/gnosis/kernel/claims.py:145:        current claim as typed data. Non-ACTIVE prior claims are\r\nsrc/gnosis/kernel/claims.py:146:        superseded with a strictly greater fencing epoch.\"\"\"\r\nsrc/gnosis/kernel/claims.py:147:        with self._locked():\r\nsrc/gnosis/kernel/claims.py:148:            state = self._load_locked()\r\nsrc/gnosis/kernel/claims.py:149:            raw = state[\"claims\"].get(task_id)\r\nsrc/gnosis/kernel/claims.py:150:            now = float(self._clock())\r\nsrc/gnosis/kernel/claims.py:151:            if raw is not None:\r\nsrc/gnosis/kernel/claims.py:152:                current = TaskClaim.from_dict(raw)\r\nsrc/gnosis/kernel/claims.py:153:                if current.status is ClaimStatus.ACTIVE:\r\nsrc/gnosis/kernel/claims.py:154:                    if current.holder == holder:\r\nsrc/gnosis/kernel/claims.py:155:                        return current\r\nsrc/gnosis/kernel/claims.py:156:                    raise ClaimConflictError(current)\r\nsrc/gnosis/kernel/claims.py:157:            next_epoch = int(state[\"last_epochs\"].get(task_id, 0)) + 1\r\nsrc/gnosis/kernel/claims.py:158:            next_version = (TaskClaim.from_dict(raw).version if raw is not None else 0) + 1\r\nsrc/gnosis/kernel/claims.py:159:            claim = TaskClaim(\r\nsrc/gnosis/kernel/claims.py:160:                task_id=task_id, holder=holder, status=ClaimStatus.ACTIVE,\r\nsrc/gnosis/kernel/claims.py:161:                epoch=next_epoch, version=next_version,\r\nsrc/gnosis/kernel/claims.py:162:                claimed_at=now, updated_at=now,\r\nsrc/gnosis/kernel/claims.py:163:            )\r\nsrc/gnosis/kernel/claims.py:164:            state[\"claims\"][task_id] = claim.to_dict()\r\nsrc/gnosis/kernel/claims.py:165:            state[\"last_epochs\"][task_id] = next_epoch\r\nsrc/gnosis/kernel/claims.py:166:            self._append_history_locked(state, claim, action=\"claim\")\r\nsrc/gnosis/kernel/claims.py:167:            self._save_locked(state)\r\nsrc/gnosis/kernel/claims.py:168:            return claim\r\nsrc/gnosis/kernel/claims.py:169:\r\nsrc/gnosis/kernel/claims.py:170:    def release(self, task_id: str, holder: str, expected_version: int) -> TaskClaim:\r\nsrc/gnosis/kernel/claims.py:171:        \"\"\"Voluntary hand-back of an ACTIVE claim (ownership mutation).\"\"\"\r\nsrc/gnosis/kernel/claims.py:172:        return self._mutate_locked(\r\nsrc/gnosis/kernel/claims.py:173:            task_id, holder, expected_version, ClaimStatus.RELEASED,\r\nsrc/gnosis/kernel/claims.py:174:            outcome=None, action=\"release\",\r\nsrc/gnosis/kernel/claims.py:175:        )\r\nsrc/gnosis/kernel/claims.py:176:\r\nsrc/gnosis/kernel/claims.py:177:    def resolve(self, task_id: str, holder: str, expected_version: int,\r\nsrc/gnosis/kernel/claims.py:178:                outcome: str) -> TaskClaim:\r\nsrc/gnosis/kernel/claims.py:179:        \"\"\"Terminal: the claimed work concluded with ``outcome``.\"\"\"\r\nsrc/gnosis/kernel/claims.py:180:        return self._mutate_locked(\r\nsrc/gnosis/kernel/claims.py:181:            task_id, holder, expected_version, ClaimStatus.RESOLVED,\r\nsrc/gnosis/kernel/claims.py:182:            outcome=outcome, action=\"resolve\",\r\nsrc/gnosis/kernel/claims.py:183:        )\r\nsrc/gnosis/kernel/claims.py:184:\r\nsrc/gnosis/kernel/claims.py:185:    def reclaim_if(self, task_id: str, expected_version: int,\r\nsrc/gnosis/kernel/claims.py:186:                   predicate: Callable[[], bool], reason: str) -> TaskClaim | None:\r\nsrc/gnosis/kernel/claims.py:187:        \"\"\"TTL-sweep primitive: mark an ACTIVE claim RECLAIMED, but only if\r\nsrc/gnosis/kernel/