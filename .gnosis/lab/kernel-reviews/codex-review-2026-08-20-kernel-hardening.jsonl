11:            return reclaimed\r\nsrc/gnosis/kernel/claims.py:212:\r\nsrc/gnosis/kernel/claims.py:213:    def get(self, task_id: str) -> TaskClaim | None:\r\nsrc/gnosis/kernel/claims.py:214:        with self._locked():\r\nsrc/gnosis/kernel/claims.py:215:            raw = self._load_locked()[\"claims\"].get(task_id)\r\nsrc/gnosis/kernel/claims.py:216:            return TaskClaim.from_dict(raw) if raw is not None else None\r\nsrc/gnosis/kernel/claims.py:217:\r\nsrc/gnosis/kernel/claims.py:218:    def active_claims(self) -> list[TaskClaim]:\r\nsrc/gnosis/kernel/claims.py:219:        with self._locked():\r\nsrc/gnosis/kernel/claims.py:220:            state = self._load_locked()\r\nsrc/gnosis/kernel/claims.py:221:            claims = (TaskClaim.from_dict(raw) for raw in state[\"claims\"].values())\r\nsrc/gnosis/kernel/claims.py:222:            return [c for c in claims if c.status is ClaimStatus.ACTIVE]\r\nsrc/gnosis/kernel/claims.py:223:\r\nsrc/gnosis/kernel/claims.py:224:    def assert_active(self, task_id: str, holder: str, epoch: int) -> TaskClaim:\r\nsrc/gnosis/kernel/claims.py:225:        \"\"\"Write guard: the live grant must be ACTIVE, by this holder, at\r\nsrc/gnosis/kernel/claims.py:226:        this fencing epoch — anything else is a deposed worker.\"\"\"\r\nsrc/gnosis/kernel/claims.py:227:        with self._locked():\r\nsrc/gnosis/kernel/claims.py:228:            raw = self._load_locked()[\"claims\"].get(task_id)\r\nsrc/gnosis/kernel/claims.py:229:        if raw is None:\r\nsrc/gnosis/kernel/claims.py:230:            raise StaleClaimError(f\"No claim exists for task '{task_id}'\")\r\nsrc/gnosis/kernel/claims.py:231:        current = TaskClaim.from_dict(raw)\r\nsrc/gnosis/kernel/claims.py:232:        if current.status is not ClaimStatus.ACTIVE:\r\nsrc/gnosis/kernel/claims.py:233:            raise StaleClaimError(\r\nsrc/gnosis/kernel/claims.py:234:                f\"Claim for task '{task_id}' is {current.status.value}, not ACTIVE\"\r\nsrc/gnosis/kernel/claims.