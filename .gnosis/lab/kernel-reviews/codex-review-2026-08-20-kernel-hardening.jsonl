rnel/claims.py:311:    live lease, and the TTL the grant was acquired with — renewals honor\r\nsrc/gnosis/kernel/claims.py:312:    this TTL, never a facade-wide default (adversarial-review finding:\r\nsrc/gnosis/kernel/claims.py:313:    renewals silently shrinking a caller's longer TTL).\"\"\"\r\nsrc/gnosis/kernel/claims.py:314:\r\nsrc/gnosis/kernel/claims.py:315:    claim: TaskClaim\r\nsrc/gnosis/kernel/claims.py:316:    lease: Lease\r\nsrc/gnosis/kernel/claims.py:317:    ttl_s: float\r\nsrc/gnosis/kernel/claims.py:318:\r\nsrc/gnosis/kernel/claims.py:319:    @property\r\nsrc/gnosis/kernel/claims.py:320:    def task_id(self) -> str:\r\nsrc/gnosis/kernel/claims.py:321:        return self.claim.task_id\r\nsrc/gnosis/kernel/claims.py:322:\r\nsrc/gnosis/kernel/claims.py:323:    @property\r\nsrc/gnosis/kernel/claims.py:324:    def holder(self) -> str:\r\nsrc/gnosis/kernel/claims.py:325:        return self.claim.holder\r\nsrc/gnosis/kernel/claims.py:326:\r\nsrc/gnosis/kernel/claims.py:327:\r\nsrc/gnosis/kernel/claims.py:328:def task_resource(task_id: str) -> str:\r\nsrc/gnosis/kernel/claims.py:329:    return f\"task/{task_id}\"\r\nsrc/gnosis/kernel/claims.py:330:\r\nsrc/gnosis/kernel/claims.py:331:\r\nsrc/gnosis/kernel/claims.py:332:class WorkAuthority:\r\nsrc/gnosis/kernel/claims.py:333:    \"\"\"Composes the durable claim plane with the ephemeral lease plane.\r\nsrc/gnosis/kernel/claims.py:334:\r\nsrc/gnosis/kernel/claims.py:335:    ``reclaim_grace_s`` protects acquire()'s claim-then-lease window from\r\nsrc/gnosis/kernel/claims.py:336:    the sweep (adversarial-review finding: \"never leased yet\" was\r\nsrc/gnosis/kernel/claims.py:337:    indistinguishable from \"lease expired\"): a claim mutated more recently\r\nsrc/gnosis/kernel/claims.py:338:    than the grace window is never sweep-eligible, so a freshly minted\r\nsrc/gnosis/kernel/claims.py:339:    claim cannot be reclaimed before its holder finishes acquiring the\r\nsrc/gnosis/kernel/claims.py:340:    lease. Healthy long-running work is protected by its lease, not by\r\nsrc/gnosis/kernel/claims.py:341:    grace, so the grace window can stay short.\"\"\"\r\nsrc/gnosis/kernel/claims.py:342:\r\nsrc/gnosis/kernel/claims.py:343:    def __init__(self, claims: ClaimStore, leases: LeaseStore,\r\nsrc/gnosis/kernel/claims.py:344:                 default_ttl_s: float = 300.0, reclaim_grace_s: float = 30.0,\r\nsrc/gnosis/kernel/claims.py:345:                 clock: Callable[[], float] = time.time):\r\nsrc/gnosis/kernel/claims.py:346:        self.claims = claims\r\nsrc/gnosis/kernel/claims.py:347:        self.leases = leases\r\nsrc/gnosis/kernel/claims.py:348:        self.default_ttl_s = default_ttl_s\r\nsrc/gnosis/kernel/claims.py:349:        self.reclaim_grace_s = reclaim_grace_s\r\nsrc/gnosis/kernel/claims.py:350:        self._clock = clock\r\nsrc/gnosis/kernel/claims.py:351:\r\nsrc/gnosis/kernel/claims.py:352:    def acquire(self, task_id: str, holder: str, ttl_s: float | None = None) -> WorkGrant:\r\nsrc/gnosis/kernel/claims.py:353:        \"\"\"Durable claim first, then the liveness lease. Same-actor retry\r\nsrc/gnosis/kernel/claims.py:354:        while its own lease is still live reuses the live lease.\"\"\"\r\nsrc/gnosis/kernel/claims.py:355:        ttl = self.default_ttl_s if ttl_s is None else ttl_s\r\nsrc/gnosis/kernel/claims.py:356:        claim = self.claims.claim(task_id, holder)\r\nsrc/gnosis/kernel/claims.py:357:        resource = task_resource(task_id)\r\nsrc/gnosis/kernel/claims.py:358:        try:\r\nsrc/gnosis/kernel/claims.py:359:            lease = self.leases.acquire(resource, holder, ttl_s=ttl)\r\nsrc/gnosis/kernel/claims.py:360:        except LeaseHeldError as exc:\r\nsrc/gnosis/kernel/claims.py:361:            if exc.lease.holder == holder:\r\nsrc/gnosis/kernel/claims.py:362:                lease = exc.lease  # our own live lease: this is a retry\r\nsrc/gnosis/kernel/claims.py:363:            else:\r\nsrc/gnosis/kernel/claims.py:364:                # Claim says us, lease says them: a previous holder's lease\r\nsrc/gnosis/kernel/claims.py:365:                # has not expired yet. Fail loudly; the sweep/TTL resolves it.\r\nsrc/gnosis/kernel/claims.py:366:                raise\r\nsrc/gnosis/kernel/claims.py:367:        return WorkGrant(claim=claim, lease=lease, ttl_s=ttl)\r\nsrc/gnosis/kernel/claims.py:368:\r\nsrc/gnosis/kernel/claims.py:369:    def assert_current(self, grant: WorkGrant) -> None:\r\nsrc/gnosis/kernel/claims.py:370:        \"\"\"Write guard for both planes: live unexpired lease AND the exact\r\nsrc/gnosis/kernel/claims.py:371:        ACTIVE claim at the granted fencing epoch. Raises StaleLeaseError\r\nsrc/gnosis/kernel/claims.py:372:        or StaleClaimError — the NO STALE WRITE invariant.\"\"\"\r\nsrc/gnosis/kernel/claims.py:373:        self.leases.assert_current(task_resource(grant.task_id), grant.lease.lease_id)\r\nsrc/gnosis/kernel/claims.py:374:        self.claims.assert_active(grant.task_id, grant.holder, grant.claim.epoch)\r\nsrc/gnosis/kernel/claims.py:375:\r\nsrc/gnosis/kernel/claims.py:376:    def heartbeat(self, grant: WorkGrant, extend_s: float | None = None) -> Lease:\r\nsrc/gnosis/kernel/claims.py:377:        \"\"\"Renew the grant's lease. The extension defaults to the TTL the\r\nsrc/gnosis/kernel/claims.py:378:        grant was acquired with, so a caller's longer window survives\r\nsrc/gnosis/kernel/claims.py:379:        every renewal.\"\"\"\r\nsrc/gnosis/kernel/claims.py:380:        extend = grant.ttl_s if extend_s is None else extend_s\r\nsrc/gnosis/kernel/claims.py:381:        return self.leases.heartbeat(\r\nsrc/gnosis/kernel/claims.py:382:            task_resource(grant.task_id), grant.lease.lease_id, extend_s=extend,\r\nsrc/gnosis/kernel/claims.py:383:        )\r\nsrc/gnosis/kernel/claims.py:384:\r\nsrc/gnosis/kernel/claims.py:385:    def resolve(self, grant: WorkGrant, outcome: str) -> TaskClaim:\r\nsrc/gnosis/kernel/claims.py:386:        \"\"\"Terminal success path: verify both planes, resolve the claim,\r\nsrc/gnosis/kernel/claims.py:387:        release the lease.\"\"\"\r\nsrc/gnosis/kernel/claims.py:388:        self.assert_current(grant)\r\nsrc/gnosis/kernel/claims.py:389:        current = self.claims.assert_active(grant.task_id, grant.holder, grant.claim.epoch)\r\nsrc/gnosis/kernel/claims.py:390:        resolved = self.claims.resolve(\r\nsrc/gnosis/kernel/claims.py:391:            grant.task_id, grant.holder, expected_version=current.version, outcome=outcome,\r\nsrc/gnosis/kernel/claims.py:392:        )\r\nsrc/gnosis/kernel/claims.py:393:        self._release_lease_after_commit(grant)\r\nsrc/gnosis/kernel/claims.py:394:        return resolved\r\nsrc/gnosis/kernel/claims.py:395:\r\nsrc/gnosis/kernel/claims.py:396:    def release(self, grant: WorkGrant) -> TaskClaim:\r\nsrc/gnosis/kernel/claims.py:397:        \"\"\"Voluntary hand-back (not for failures: a claim on failed work\r\nsrc/gnosis/kernel/claims.py:398:        stays bound to its unresolved state until reclaimed or explicitly\r\nsrc/gnosis/kernel/claims.py:399:        handed off — grit's merge-failure lesson).\"\"\"\r\nsrc/gnosis/kernel/claims.py:400:        self.assert_current(grant)\r\nsrc/gnosis/kernel/claims.py:401:        current = self.claims.assert_active(grant.task_id, grant.holder, grant.claim.epoch)\r\nsrc/gnosis/kernel/claims.py:402:        released = self.claims.release(\r\nsrc/gnosis/kernel/claims.py:403:            grant.task_id, grant.holder, expected_version=current.version,\r\nsrc/gnosis/kernel/claims.py:404:        )\r\nsrc/gnosis/kernel/claims.py:405:        self._release_lease_after_commit(grant)\r\nsrc/gnosis/kernel/claims.py:406:        return released\r\nsrc/gnosis/kernel/claims.py:407:\r\nsrc/gnosis/kernel/claims.py:408:    def _release_lease_after_commit(self, grant: WorkGrant) -> None:\r\nsrc/gnosis/kernel/claims.py:409:        # The claim mutation above is the durable truth and has already\r\nsrc/gnosis/kernel/claims.py:410:        # committed. If the lease expired or was superseded in the window\r\nsrc/gnosis/kernel/claims.py:411:        # since assert_current, there is simply nothing left to release —\r\nsrc/gnosis/kernel/claims.py:412:        # raising here would convert completed work into a caller-visible\r\nsrc/gnosis/kernel/claims.py:413:        # failure (adversarial-review finding). Absorb only staleness;\r\nsrc/gnosis/kernel/claims.py:414:        # anything else still surfaces.\r\nsrc/gnosis/kernel/claims.py:415:        try:\r\nsrc/gnosis/kernel/claims.py:416:            self.leases.release(task_resource(grant.task_id), grant.lease.lease_id)\r\nsrc/gnosis/kernel/claims.py:417:        except StaleLeaseError:\r\nsrc/gnosis/kernel/claims.py:418:            pass\r\nsrc/gnosis/kernel/claims.py:419:\r\nsrc/gnosis/kernel/claims.py:420:    def _lease_gone(self, resource: str) -> bool:\r\nsrc/gnosis/kernel/claims.py:421:        return self.leases.current(resource) is None\r\nsrc/gnosis/kernel/claims.py:422:\r\nsrc/gnosis/kernel/claims.py:423:    def sweep(self) -> list[TaskClaim]:\r\nsrc/gnosis/kernel/claims.py:424:        \"\"\"TTL reclaim: every ACTIVE claim whose lease is gone is marked\r\nsrc/gnosis/kernel/claims.py:425:        RECLAIMED. The expiry predicate runs again inside the claim\r\nsrc/gnosis/kernel/claims.py:426:        store's lock at mutation time, and claims younger than\r\nsrc/gnosis/kernel/claims.py:427:        ``reclaim_grace_s`` are never touched (see class docstring).\"\"\"\r\nsrc/gnosis/kernel/claims.py:428:        reclaimed: list[TaskClaim] = []\r\nsrc/gnosis/kernel/claims.py:429:        now = float(self._clock())\r\nsrc/gnosis/kernel/claims.py:430:        for claim in self.claims.active_claims():\r\nsrc/gnosis/kernel/claims.py:431:            if now - claim.updated_at < self.reclaim_grace_s:\r\nsrc/gnosis/kernel/claims.py:432:                continue  # freshly minted/mutated: inside acquire()'s window\r\nsrc/gnosis/kernel/claims.py:433:            result = self.claims.reclaim_if(\r\nsrc/gnosis/kernel/claims.py:434:                claim.task_id, expected_version=claim.version,\r\nsrc/gnosis/kernel/claims.py:435:                predicate=partial(self._lease_gone, task_resource(claim.task_id)),\r\nsrc/gnosis/kernel/claims.py:436:                reason=\"lease expired (TTL sweep)\",\r\nsrc/gnosis/kernel/claims.py:437:            )\r\nsrc/gnosis/kernel/claims.py:438:            if result is not None:\r\nsrc/gnosis/kernel/claims.py:439:                reclaimed.append(result)\r\nsrc/gnosis/kernel/claims.py:440:        return reclaimed\r\nsrc/gnosis/kernel/claims.py:441:\r\nsrc/gnosis/kernel/claims.py:442:\r\nsrc/gnosis/kernel/claims.py:443:class GrantHeartbeatPump:\r\nsrc/gnosis/kernel/claims.py:444:    \"\"\"Background thread that keeps a WorkGrant's lease alive for the\r\nsrc/gnosis/kernel/claims.py:445:    grant's whole lifetime — CLI runs, retry backoffs, verification,\r\nsrc/gnosis/kernel/claims.py:446:    resolve — not just while some inner loop happens to tick (the\r\nsrc/gnosis/kernel/claims.py:447:    adversarial-review finding that a slow verifier self-deposed a\r\nsrc/gnosis/kernel/claims.py:448:    healthy worker).\r\nsrc/gnosis/kernel/claims.py:449:\r\nsrc/gnosis/kernel/claims.py:450:    On deposition (StaleLeaseError/StaleClaimError from a renewal) it\r\nsrc/gnosis/kernel/claims.py:451:    records the error, invokes ``on_deposed`` once, and exits; the owner's\r\nsrc/gnosis/kernel/claims.py:452:    guards then surface the recorded error deterministically. Any other\r\nsrc/gnosis/kernel/claims.py:453:    renewal failure (e.g. a transient lock timeout) is recorded as\r\nsrc/gnosis/kernel/claims.py:454:    ``last_error`` and the pump keeps trying — a hiccup must not depose a\r\nsrc/gnosis/kernel/claims.py:455:    live worker; the guards remain the authority.\"\"\"\r\nsrc/gnosis/kernel/claims.py:456:\r\nsrc/gnosis/kernel/claims.py:457:    def __init__(self, authority: WorkAuthority, grant: WorkGrant,\r\nsrc/gnosis/kernel/claims.py:458:                 interval_s: float,\r\nsrc/gnosis/kernel/claims.py:459:                 on_deposed: Callable[[Exception], None] | None = None):\r\nsrc/gnosis/kernel/claims.py:460:        if interval_s <= 0:\r\nsrc/gnosis/kernel/claims.py:461:            raise ValueError(\"interval_s must be positive\")\r\nsrc/gnosis/kernel/claims.py:462:        self._authority = authority\r\nsrc/gnosis/kernel/claims.py:463:        self._grant = grant\r\nsrc/gnosis/kernel/claims.py:464:        self._interval_s = interval_s\r\nsrc/gnosis/kernel/claims.py:465:        self._on_deposed = on_deposed\r\nsrc/gnosis/kernel/claims.py:466:        self._stop = threading.Event()\r\nsrc/gnosis/kernel/claims.py:467:        self._thread = threading.Thread(target=self._run, daemon=True)\r\nsrc/gnosis/kernel/claims.py:468:        self.deposed: Exception | None = None\r\nsrc/gnosis/kernel/claims.py:469:        self.last_error: Exception | None = None\r\nsrc/gnosis/kernel/claims.py:470:\r\nsrc/gnosis/kernel/claims.py:471:    def start(self) -> None:\r\nsrc/gnosis/kernel/claims.py:472:        self._thread.start()\r\nsrc/gnosis/kernel/claims.py:473:\r\nsrc/gnosis/kernel/claims.py:474:    def stop(self, join_timeout_s: float = 5.0) -> None:\r\nsrc/gnosis/kernel/claims.py:475:        self._stop.set()\r\nsrc/gnosis/kernel/claims.py:476:        self._thread.join(timeout=join_timeout_s)\r\nsrc/gnosis/kernel/claims.py:477:\r\nsrc/gnosis/kernel/claims.py:478:    def _run(self) -> None:\r\nsrc/gnosis/kernel/claims.py:479:        while not self._stop.wait(self._interval_s):\r\nsrc/gnosis/kernel/claims.py:480:            try:\r\nsrc/gnosis/kernel/claims.py:481:                self._authority.heartbeat(self._grant)\r\nsrc/gnosis/kernel/claims.py:482:            except (StaleClaimError, StaleLeaseError) as exc:\r\nsrc/gnosis/kernel/claims.py:483:                self.deposed = exc\r\nsrc/gnosis/kernel/claims.py:484:                if self._on_deposed is not None:\r\nsrc/gnosis/kernel/claims.py:485:                    self._on_deposed(exc)\r\nsrc/gnosis/kernel/claims.py:486:                return\r\nsrc/gnosis/kernel/claims.py:487:            except Exception as exc:  # noqa: BLE001 - transient renewal failure must not depose a live worker\r\nsrc/gnosis/kernel/claims.py:488:                self.last_error = exc\r\n","exit_code":0,"status":"completed"}}
