* text=auto
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.db binary
*.sqlite binary

# Evidence bundles are byte-exact artifacts: their MANIFEST.sha256.json
# hashes each file, so git must store them verbatim or verify_bundle (F-17)
# fails after a clone. Never EOL-convert anything under an evidence bundle.
.gnosis/evidence/** -text
